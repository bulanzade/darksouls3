def new_chunk():
    return [[TILE_WALL for _ in range(CHUNK_SIZE)] for _ in range(CHUNK_SIZE)]

def fill_tiles(chunk, tile, x1, y1, x2, y2):
    for y in range(y1, y2 + 1):
        for x in range(x1, x2 + 1):
            if 0 <= y < CHUNK_SIZE and 0 <= x < CHUNK_SIZE:
                chunk[y][x] = tile

def carve_ellipse(chunk, cx, cy, rx, ry):
    for y in range(cy - ry, cy + ry + 1):
        for x in range(cx - rx, cx + rx + 1):
            if 0 <= y < CHUNK_SIZE and 0 <= x < CHUNK_SIZE:
                dx = (x - cx) / rx if rx > 0 else 0
                dy = (y - cy) / ry if ry > 0 else 0
                if dx * dx + dy * dy <= 1.0:
                    chunk[y][x] = TILE_GROUND

def chunk_to_csv(chunk):
    csv = []
    for y in range(CHUNK_SIZE):
        for x in range(CHUNK_SIZE):
            csv.append(chunk[y][x])
    return csv

def make_field(identifier, field_type, value):
    return {
        "__identifier": identifier,
        "__type": field_type,
        "__value": value,
        "defUid": 0,
        "realEditorValues": [],
        "__tile": None,
    }

def make_entity(identifier, px, py, fields=None):
    ent = {
        "__identifier": identifier,
        "__grid": [int(px) // 16, int(py) // 16],
        "__pivot": [0.5, 1.0],
        "__smartColor": "#FFFFFF",
        "__tags": [],
        "__tile": None,
        "__worldX": None,
        "__worldY": None,
        "defUid": ENTITY_UIDS[identifier],
        "fieldInstances": fields or [],
        "height": 16,
        "iid": str(uuid.uuid4()),
        "px": [int(px), int(py)],
        "width": 16,
    }
    return ent

def populate_entity_def_uids(entities):
    for ent in entities:
        ent["defUid"] = ENTITY_UIDS[ent["__identifier"]]
        for fld in ent.get("fieldInstances", []):
            key = f"{ent['__identifier']}.{fld['__identifier']}"
            fld["defUid"] = FIELD_UIDS.get(key, 0)

def make_tile_patch(px, py, tile, x1, y1, x2, y2, condition):
    return make_entity("TilePatch", px, py, [
        make_field("tile", "LocalEnum.TileKind", tile),
        make_field("x1", "Int", x1),
        make_field("y1", "Int", y1),
        make_field("x2", "Int", x2),
        make_field("y2", "Int", y2),
        make_field("condition", "String", condition),
    ])

def make_enum(identifier, uid, values):
    return {
        "externalFileChecksum": None,
        "externalRelPath": None,
        "iconTilesetUid": None,
        "identifier": identifier,
        "tags": [],
        "uid": uid,
        "values": [
            {
                "__tileSrcRect": None,
                "color": value.get("color", 0xFFFFFF),
                "id": value["id"],
                "tileId": None,
                "tileRect": None,
            }
            for value in values
        ],
    }

def wrap_default(field_type, default):
    if default is None:
        return None
    if field_type == "Bool":
        return {"id": "V_Bool", "params": [bool(default)]}
    if field_type == "Int":
        return {"id": "V_Int", "params": [int(default)]}
    if field_type == "Float":
        return {"id": "V_Float", "params": [float(default)]}
    if field_type == "Color":
        s = str(default)
        if s.startswith("#"):
            s = s[1:]
        return {"id": "V_Int", "params": [int(s, 16)]}
    if field_type == "String" or field_type.startswith("LocalEnum."):
        return {"id": "V_String", "params": [str(default)]}
    return None

def make_field_def(identifier, field_type, uid, default, purple_type, doc=None):
    return {
        "__type": field_type,
        "acceptFileTypes": None,
        "allowedRefs": "Any",
        "allowedRefsEntityUid": None,
        "allowedRefTags": [],
        "allowOutOfLevelRef": False,
        "arrayMaxLength": None,
        "arrayMinLength": None,
        "autoChainRef": True,
        "canBeNull": False,
        "defaultOverride": wrap_default(field_type, default),
        "doc": doc,
        "editorAlwaysShow": False,
        "editorCutLongValues": True,
        "editorDisplayColor": None,
        "editorDisplayMode": "Hidden",
        "editorDisplayPos": "Above",
        "editorDisplayScale": 1.0,
        "editorLinkStyle": "StraightArrow",
        "editorShowInWorld": True,
        "editorTextPrefix": None,
        "editorTextSuffix": None,
        "exportToToc": False,
        "identifier": identifier,
        "isArray": False,
        "max": None,
        "min": None,
        "regex": None,
        "searchable": True,
        "symmetricalRef": False,
        "textLanguageMode": None,
        "tilesetUid": None,
        "type": purple_type,
        "uid": uid,
        "useForSmartColor": False,
    }

def make_entity_def(identifier, uid, width=16, height=16, resizable_x=False, resizable_y=False, render_mode="Rectangle", color="#FFFFFF", field_defs=None):
    return {
        "allowOutOfBounds": False,
        "color": color,
        "doc": None,
        "exportToToc": False,
        "fieldDefs": field_defs or [],
        "fillOpacity": 0.8,
        "height": height,
        "hollow": False,
        "identifier": identifier,
        "keepAspectRatio": False,
        "limitBehavior": "MoveLastOne",
        "limitScope": "PerLevel",
        "lineOpacity": 1.0,
        "maxCount": 0,
        "maxHeight": None,
        "maxWidth": None,
        "minHeight": None,
        "minWidth": None,
        "nineSliceBorders": [],
        "pivotX": 0.5,
        "pivotY": 1.0,
        "renderMode": render_mode,
        "resizableX": resizable_x,
        "resizableY": resizable_y,
        "showName": True,
        "tags": [],
        "tileId": None,
        "tileOpacity": 1.0,
        "tileRect": None,
        "tileRenderMode": "Stretch",
        "tilesetId": None,
        "uid": uid,
        "uiTileRect": None,
        "width": width,
    }

# ---- Area generators ----

def make_cemetery():
    # Combined Cemetery of Ash + Firelink Shrine — one continuous map (160x160 tiles).
    # Terrain follows docs/maps/CemeteryOfAsh.json + FirelinkShrine.json sections exactly.
    #
    # Layout (pixel coords, 2560x2560):
    #   Firelink Shrine:  top   (px y:0-800)
    #   Connecting path:  mid   (px y:800-1160)
    #   Cemetery of Ash:  bottom (px y:1160-2560, Y-flipped from doc)
    #
    # Cemetery doc coords Y-flipped: merged_y = 2560 - doc_y
    #   doc y=0 (coffin/start) → merged y=2560 (bottom of map)
    #   doc y=1400 (arena)     → merged y=1160 (upper cemetery)
    # Firelink doc coords used directly (already at top).

    chunk = new_chunk()

    def cy(doc_y):
        """Convert cemetery design doc Y to merged map Y (Y-flip)."""
        return 2560 - doc_y

    def ctile(doc_x, doc_y):
        """Convert cemetery doc pixel coords to merged tile coords."""
        return doc_x // 16, cy(doc_y) // 16

    # ============================================================
    # FIRELINK SHRINE (top of map, doc coords used directly)
    # Sections from FirelinkShrine.json map_layout.sections:
    #   外部庭院:    x:200-1000, y:0-250     → tiles (12,0)-(62,15)
    #   祭祀场大厅:  x:200-1000, y:200-800   → tiles (12,12)-(62,50)
    #   侍女货架区:  x:200-400,  y:300-500   → tiles (12,18)-(25,31)
    #   安德烈锻造区: x:750-1000, y:300-500   → tiles (46,18)-(62,31)
    #   王座阶梯:    x:300-900,  y:650-850   → tiles (18,40)-(56,53)
    #   祭祀场入口:  x:0-200,    y:350-650   → tiles (0,21)-(12,40)
    # ============================================================
    # ---- Firelink Shrine: enclosed building with thick walls ----
    # DS3 Firelink: thick stone walls, narrow archways, distinct rooms
    # Building outer shell (3-tile thick walls)
    fill_tiles(chunk, TILE_WALL, 10, 0, 64, 3)      # north wall (3 thick)
    fill_tiles(chunk, TILE_WALL, 10, 0, 13, 55)      # west wall (3 thick)
    fill_tiles(chunk, TILE_WALL, 61, 0, 64, 55)      # east wall (3 thick)
    fill_tiles(chunk, TILE_WALL, 10, 52, 64, 55)     # south wall (3 thick)
    # Interior ground (carved out of wall shell)
    fill_tiles(chunk, TILE_GROUND, 13, 3, 60, 51)    # main hall floor
    # South wall gap for corridor entrance from cemetery
    fill_tiles(chunk, TILE_GROUND, 28, 52, 44, 55)

    # Entrance from cemetery (west wall archway, 3-tile wide gap)
    fill_tiles(chunk, TILE_GROUND, 0, 23, 13, 38)    # entrance corridor ground
    for y in range(3, 23):
        chunk[y][12] = TILE_WALL                      # north side of entrance
    for y in range(39, 52):
        chunk[y][12] = TILE_WALL                      # south side of entrance

    # Courtyard / Main Hall divider: thick wall at y=14 with archway
    for x in range(13, 61):
        if x < 33 or x > 39:   # 7-tile archway
            for dy in range(3):
                chunk[14 + dy][x] = TILE_WALL

    # Courtyard (y:3-13): enclosed with gravestones and pillars
    # Stone pillars flanking archway
    for dy in range(3):
        for dx in range(2):
            chunk[5 + dy][17 + dx] = TILE_WALL       # left pillar
            chunk[5 + dy][56 + dx] = TILE_WALL       # right pillar
    # Dense gravestone clusters (2x2 blocks)
    for gx, gy in [(16, 7), (20, 4), (25, 9), (30, 6), (35, 4), (40, 8),
                   (45, 5), (50, 10), (55, 7), (22, 11), (38, 11), (48, 3),
                   (28, 3), (42, 12), (52, 5)]:
        for dy in range(2):
            for dx in range(2):
                if 3 <= gy+dy <= 13 and 13 <= gx+dx <= 60:
                    chunk[gy+dy][gx+dx] = TILE_WALL

    # Main Hall interior: thick partition walls creating rooms
    # Left room (侍女货架区): x:13-28, y:17-34
    for y in range(17, 35):
        if y < 25 or y > 28:   # 4-tile doorway
            for dx in range(2):
                chunk[y][28 + dx] = TILE_WALL         # east partition (2 thick)
    # South wall of shop room
    for x in range(13, 30):
        if x < 20 or x > 23:
            for dy in range(2):
                chunk[33 + dy][x] = TILE_WALL
    # Shop interior features: shelves along walls
    for y in range(18, 32):
        chunk[y][14] = TILE_WALL                      # west shelf wall
        chunk[y][15] = TILE_WALL
    for y in range(18, 26):
        chunk[y][26] = TILE_WALL                      # east shelf wall

    # Right room (安德烈锻造区): x:42-60, y:17-34
    for y in range(17, 35):
        if y < 25 or y > 28:   # 4-tile doorway
            for dx in range(2):
                chunk[y][42 - dx] = TILE_WALL         # west partition (2 thick)
    # South wall of forge room
    for x in range(40, 61):
        if x < 48 or x > 51:
            for dy in range(2):
                chunk[33 + dy][x] = TILE_WALL
    # Forge anvil and tools (wall blocks)
    for dy in range(2):
        for dx in range(3):
            chunk[24 + dy][55 + dx] = TILE_WALL       # anvil
    for dy in range(2):
        for dx in range(2):
            chunk[20 + dy][57 + dx] = TILE_WALL       # weapon rack

    # Central hall pillars (4 thick pillars)
    for px, py in [(33, 20), (38, 20), (33, 30), (38, 30)]:
        for dy in range(2):
            for dx in range(2):
                chunk[py+dy][px+dx] = TILE_WALL

    # Throne area (y:42-51): enclosed with walls and steps
    for x in range(13, 61):
        if x < 30 or x > 44:
            for dy in range(2):
                chunk[42 + dy][x] = TILE_WALL         # step wall (2 thick)
    # Throne back wall decorations
    for dy in range(3):
        for dx in range(2):
            chunk[48 + dy][35 + dx] = TILE_WALL       # throne chair
    # Side pillars in throne area
    for dy in range(4):
        chunk[45 + dy][20] = TILE_WALL
        chunk[45 + dy][54] = TILE_WALL

    # ============================================================
    # CONNECTING CORRIDOR (Firelink → Cemetery arena)
    # Wide stone passage — main route to Firelink Shrine
    # ============================================================
    # 12-tile wide corridor (Firelink → bridge approach)
    fill_tiles(chunk, TILE_GROUND, 22, 55, 50, 73)
    # Bridge from corridor east to arena north entrance
    fill_tiles(chunk, TILE_GROUND, 44, 71, 68, 76)
    # Corridor walls (2 thick on each side)
    for y in range(55, 74):
        for dx in range(2):
            chunk[y][20 + dx] = TILE_WALL              # west wall (2 thick)
            chunk[y][50 + dx] = TILE_WALL              # east wall (2 thick)
    # Bridge walls (narrower bridge)
    for x in range(44, 69):
        chunk[71][x] = TILE_WALL                       # bridge north rail
        chunk[76][x] = TILE_WALL                       # bridge south rail
    fill_tiles(chunk, TILE_GROUND, 44, 72, 67, 75)    # bridge floor (4 wide)
    # Stone arch pillars (sparse, not blocking)
    chunk[62][35] = TILE_WALL
    chunk[62][42] = TILE_WALL
    chunk[67][30] = TILE_WALL
    chunk[67][45] = TILE_WALL

    # ============================================================
    # CEMETERY OF ASH (bottom, Y-flipped from doc)
    # DS3 layout: narrow winding paths through dense graves,
    # NOT wide open rectangles. Each section has narrow corridors,
    # dense gravestones, and architectural detail.
    #
    # Section tile regions (Y-flipped):
    #   苏醒棺木:   (0,135)-(25,160)   — small enclosed room + narrow exit
    #   墓地小径:   (18,110)-(56,141)  — narrow winding path through graves
    #   灰烬庭院:   (50,103)-(81,128)  — wider courtyard with dead tree
    #   饿犬墓地:   (37,85)-(68,110)   — two-level with steps
    #   古达竞技场: (62,72)-(100,103)  — arena with broken wall ring
    # ============================================================

    # ---- Section 1: 苏醒棺木 (Coffin Room) ----
    # DS3: tiny enclosed stone room, thick walls, narrow stone corridor out
    # Enclosed room with 2-tile-thick walls
    fill_tiles(chunk, TILE_WALL, 12, 143, 28, 157)    # room outer walls (block)
    fill_tiles(chunk, TILE_GROUND, 14, 145, 26, 155)  # interior floor
    # Narrow exit corridor north (3 tiles wide)
    fill_tiles(chunk, TILE_GROUND, 18, 139, 22, 145)
    # Corridor walls (2 thick on each side)
    fill_tiles(chunk, TILE_WALL, 15, 139, 18, 145)    # left corridor wall
    fill_tiles(chunk, TILE_WALL, 22, 139, 25, 145)    # right corridor wall
    # Coffin (thick wall block inside room)
    fill_tiles(chunk, TILE_WALL, 16, 149, 20, 153)
    # Bone piles (wall dots)
    for bx, by in [(22, 148), (15, 154), (23, 146), (14, 147), (24, 152)]:
        chunk[by][bx] = TILE_WALL

    # ---- Section 2: 墓地小径 (Cemetery Path) ----
    # DS3: 4-5 tile wide winding path through dense gravestone forests
    # Path: S-curve from coffin room up to courtyard
    # Lower segment (connects to coffin exit)
    fill_tiles(chunk, TILE_GROUND, 15, 131, 38, 141)
    # Middle segment (offset east, creates S-curve)
    fill_tiles(chunk, TILE_GROUND, 22, 119, 44, 132)
    # Upper segment (offset east again)
    fill_tiles(chunk, TILE_GROUND, 32, 108, 58, 121)
    # S-curve connectors
    fill_tiles(chunk, TILE_GROUND, 22, 128, 38, 132)
    fill_tiles(chunk, TILE_GROUND, 32, 117, 44, 121)
    # Path narrowing walls (border walls along path edges)
    for x in range(15, 39):
        chunk[130][x] = TILE_WALL
        chunk[131][x] = TILE_WALL
    # Dense gravestone walls (2x2 blocks flanking the path)
    for gx, gy in [(16,133),(22,133),(28,135),(34,133),(16,137),(24,136),(30,138),
                   (20,139),(26,140),(32,139),(18,143),(24,142),(30,141),
                   (15,127),(21,126),(27,125),(33,124),(39,123),
                   (17,123),(23,122),(29,121),(35,120),(41,119),
                   (24,129),(30,130),(36,128),(42,127),
                   (34,114),(40,112),(46,110),(52,109),
                   (36,117),(42,115),(48,113),(54,112),
                   (38,120),(44,118),(50,116),(56,114)]:
        if 0 <= gy < CHUNK_SIZE and 0 <= gx+1 < CHUNK_SIZE:
            chunk[gy][gx] = TILE_WALL
            chunk[gy][gx+1] = TILE_WALL
    # Large wall segments (ruined stone walls along path)
    fill_tiles(chunk, TILE_WALL, 16, 135, 19, 137)
    fill_tiles(chunk, TILE_WALL, 28, 132, 31, 134)
    fill_tiles(chunk, TILE_WALL, 38, 126, 41, 128)
    fill_tiles(chunk, TILE_WALL, 24, 120, 27, 122)
    fill_tiles(chunk, TILE_WALL, 44, 112, 47, 114)

    # ---- Section 3: 灰烬庭院 (Ash Courtyard) ----
    # DS3: wider but still bounded area, central dead tree, dense graves
    fill_tiles(chunk, TILE_GROUND, 48, 106, 80, 127)
    # Connection from 墓地小径
    fill_tiles(chunk, TILE_GROUND, 46, 110, 52, 118)
    # Connection to 饿犬墓地
    fill_tiles(chunk, TILE_GROUND, 48, 118, 55, 127)
    # Connection to 古达竞技场
    fill_tiles(chunk, TILE_GROUND, 62, 106, 80, 110)
    # Boundary walls (thick walls enclosing courtyard)
    for dx in range(2):
        for x in range(48, 81):
            chunk[106 + dx][x] = TILE_WALL             # north wall
            chunk[126 + dx][x] = TILE_WALL             # south wall
    fill_tiles(chunk, TILE_GROUND, 50, 108, 55, 110)   # re-open north entrance
    fill_tiles(chunk, TILE_GROUND, 50, 124, 56, 127)   # re-open south entrance
    # Central dead tree (large wall structure with roots)
    fill_tiles(chunk, TILE_WALL, 62, 114, 66, 118)    # trunk
    fill_tiles(chunk, TILE_WALL, 59, 111, 69, 114)    # canopy
    fill_tiles(chunk, TILE_WALL, 57, 115, 60, 120)    # left roots
    fill_tiles(chunk, TILE_WALL, 68, 116, 71, 121)    # right roots
    # Dense gravestone clusters (2x2 blocks)
    for gx, gy in [(50,108),(56,110),(64,108),(72,108),(76,112),
                   (50,115),(56,117),(72,116),(76,119),(68,120),
                   (52,120),(58,122),(64,124),(70,123),(76,124),
                   (54,113),(60,115),(74,114),(66,126)]:
        for dy in range(2):
            for dx in range(2):
                if 0 <= gy+dy < CHUNK_SIZE and 0 <= gx+dx < CHUNK_SIZE:
                    chunk[gy+dy][gx+dx] = TILE_WALL
    # Stone rubble walls
    fill_tiles(chunk, TILE_WALL, 53, 111, 55, 112)
    fill_tiles(chunk, TILE_WALL, 73, 120, 75, 122)

    # ---- Section 4: 饿犬墓地 (Hound Cemetery) ----
    # DS3: packed with gravestones, narrow paths between grave clusters
    # Lower level (south) - narrow carved paths
    fill_tiles(chunk, TILE_GROUND, 35, 97, 67, 112)
    # Upper level (north) - narrow carved paths
    fill_tiles(chunk, TILE_GROUND, 40, 84, 67, 98)
    # Connecting ramp between levels
    fill_tiles(chunk, TILE_GROUND, 48, 94, 58, 100)
    # Connection to 墓地小径
    fill_tiles(chunk, TILE_GROUND, 35, 110, 44, 116)
    # Connection to 灰烬庭院
    fill_tiles(chunk, TILE_GROUND, 48, 108, 56, 112)
    # Connection to 古达竞技场
    fill_tiles(chunk, TILE_GROUND, 62, 84, 68, 98)
    # Level divider wall (2-thick stone step) with wide gap
    for x in range(35, 68):
        if x < 48 or x > 58:
            chunk[97][x] = TILE_WALL
            chunk[98][x] = TILE_WALL
    # Boundary walls (thick)
    for dy in range(2):
        for x in range(35, 68):
            chunk[111 + dy][x] = TILE_WALL             # south wall
    fill_tiles(chunk, TILE_GROUND, 35, 113, 42, 116)   # re-open entrance from 小径
    # Dense gravestone walls (2x2 blocks creating narrow paths)
    for gx, gy in [(37,100),(43,100),(49,101),(55,100),(61,100),
                   (37,104),(43,104),(49,105),(55,104),(61,104),
                   (39,107),(45,107),(51,107),(57,107),(63,107),
                   (37,109),(45,109),(53,109),(59,109),
                   (42,86),(48,86),(54,86),(60,86),
                   (42,89),(48,89),(54,89),(60,89),
                   (44,92),(50,92),(56,92),(62,92),
                   (42,95),(50,95),(58,95)]:
        for dy in range(2):
            for dx in range(2):
                if 0 <= gy+dy < CHUNK_SIZE and 0 <= gx+dx < CHUNK_SIZE:
                    chunk[gy+dy][gx+dx] = TILE_WALL
    # Ruined stone wall segments (thick walls creating cover)
    fill_tiles(chunk, TILE_WALL, 35, 102, 37, 104)
    fill_tiles(chunk, TILE_WALL, 63, 102, 65, 104)
    fill_tiles(chunk, TILE_WALL, 40, 94, 42, 96)
    fill_tiles(chunk, TILE_WALL, 58, 94, 60, 96)

    # ---- Section 5: 古达竞技场 (Gundyr Arena) ----
    # DS3: arena with thick broken walls, stone pillars, coiled sword center
    fill_tiles(chunk, TILE_GROUND, 60, 74, 102, 105)  # arena floor
    # Connection from 饿犬墓地
    fill_tiles(chunk, TILE_GROUND, 60, 86, 68, 90)
    # Connection from corridor (north side)
    fill_tiles(chunk, TILE_GROUND, 68, 72, 95, 76)
    fill_tiles(chunk, TILE_GROUND, 60, 70, 68, 76)
    # Arena walls (2-thick broken stone ring)
    for x in range(60, 103):
        if x < 68 or x > 76:   # north gap
            chunk[74][x] = TILE_WALL
            chunk[73][x] = TILE_WALL
    for x in range(60, 103):
        if x < 75 or x > 88:   # south gap
            chunk[104][x] = TILE_WALL
            chunk[105][x] = TILE_WALL
    # West wall with gap
    for y in range(74, 105):
        if y < 84 or y > 90:
            chunk[y][60] = TILE_WALL
            chunk[y][59] = TILE_WALL
    # East wall with gap
    for y in range(74, 105):
        if y < 88 or y > 94:
            chunk[y][101] = TILE_WALL
            chunk[y][102] = TILE_WALL
    # 4 corner pillars (3x3 blocks)
    for px, py in [(66, 78), (92, 78), (66, 98), (92, 98)]:
        for dy in range(3):
            for dx in range(3):
                chunk[py+dy][px+dx] = TILE_WALL
    # Central coiled sword (smaller cross, leaves passage on sides)
    fill_tiles(chunk, TILE_WALL, 80, 89, 81, 93)    # vertical sword (2 wide)
    fill_tiles(chunk, TILE_WALL, 77, 91, 84, 92)    # horizontal guard
    # Rubble along arena edges (2x2 blocks)
    for rx, ry in [(64, 76), (96, 76), (64, 101), (96, 101),
                   (70, 82), (88, 82), (70, 94), (88, 94)]:
        for dy in range(2):
            for dx in range(2):
                chunk[ry+dy][rx+dx] = TILE_WALL
    # Rubble along edges
    for gx, gy in [(64,78),(66,80),(96,78),(98,80),(64,101),(66,100),(96,101),(98,100)]:
        if 0 <= gy < CHUNK_SIZE and 0 <= gx < CHUNK_SIZE:
            chunk[gy][gx] = TILE_WALL

    # ============================================================
    # ENTITIES — positions from design docs
    # ============================================================
    entities = []

    # ---- Player spawn (苏醒棺木, bottom of map) ----
    # Place player on the east side of the internal wall (x>17) so path north is clear
    # Doc: coffin area ~(200,200) → merged (350, 2360) = tile (21, 147)
    entities.append(make_entity("PlayerSpawn", 350, 2360, [
        make_field("heal", "Bool", True),
    ]))

    # ---- Boss spawn (古达竞技场) ----
    # Doc: (1300, 1150) → merged (1300, 1410)
    entities.append(make_entity("BossSpawn", 1300, 1410))

    # ---- Bonfires ----
    # Cemetery bonfire (灰烬庭院枯树旁): doc (800,600) → merged (800, 1960)
    entities.append(make_entity("Bonfire", 800, 1936))
    # Firelink bonfire (中央篝火): doc (600,500)
    entities.append(make_entity("Bonfire", 600, 500))

    # ---- Cemetery enemies ----
    # HollowAssassin ×2: doc (500,400) → merged (500, 2160)
    entities.append(make_entity("Enemy", 500, 2160, [make_field("kind", "LocalEnum.EnemyKind", "Assassin")]))
    entities.append(make_entity("Enemy", 520, 2180, [make_field("kind", "LocalEnum.EnemyKind", "Assassin")]))
    # HollowAssassin ×2: doc (700,500) → merged (700, 2060)
    entities.append(make_entity("Enemy", 700, 2060, [make_field("kind", "LocalEnum.EnemyKind", "Assassin")]))
    entities.append(make_entity("Enemy", 720, 2080, [make_field("kind", "LocalEnum.EnemyKind", "Assassin")]))
    # HollowAssassin ×1: doc (900,600) → merged (900, 1960)
    entities.append(make_entity("Enemy", 900, 1960, [make_field("kind", "LocalEnum.EnemyKind", "Assassin")]))
    # StarvedHound ×2: doc (800,550) → merged (800, 2010)
    entities.append(make_entity("Enemy", 800, 2010, [make_field("kind", "LocalEnum.EnemyKind", "StarvedHound")]))
    entities.append(make_entity("Enemy", 820, 2030, [make_field("kind", "LocalEnum.EnemyKind", "StarvedHound")]))
    # CrystalLizard ×1: doc (450,350) → merged (450, 2210)
    entities.append(make_entity("Enemy", 450, 2210, [make_field("kind", "LocalEnum.EnemyKind", "CrystalLizard")]))

    # ---- Firelink enemies ----
    # CrystalLizard: doc (300,500)
    entities.append(make_entity("Enemy", 300, 500, [make_field("kind", "LocalEnum.EnemyKind", "CrystalLizard")]))
    # SwordMaster (→Assassin): doc (200,600)
    entities.append(make_entity("Enemy", 200, 600, [make_field("kind", "LocalEnum.EnemyKind", "Assassin")]))

    # ---- Cemetery items (doc coords → merged via cy) ----
    for kind, doc_x, doc_y, val, name in [
        ("Consumable",  380, 380, 0, "灰色原素瓶"),
        ("Consumable",  420, 400, 0, "原素瓶"),
        ("SoulOrb",     500, 450, 200, ""),
        ("Firebomb",    520, 470, 0, "火焰壶"),
        ("TitaniteShard",750, 950, 0, ""),
        ("SoulOrb",     850, 600, 400, ""),
        ("Consumable",  900, 650, 0, "楔形石鳞片"),
        ("WeaponDrop", 1280, 1130, 0, "CoiledSword"),
    ]:
        mx, my = doc_x, cy(doc_y)
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb":
            fields.append(make_field("value", "Int", val))
        if kind in ("WeaponDrop", "Consumable"):
            fields.append(make_field("name", "String", name))
        entities.append(make_entity("Item", mx, my, fields))

    # ---- Firelink items (doc coords, no transform) ----
    for kind, x, y, val, name in [
        ("RingDrop", 550, 350, 0, "贪欲银蛇戒指"),
        ("RingDrop", 750, 50, 0, "原素戒指"),
        ("HomewardBone", 300, 100, 0, ""),
        ("SoulOrb", 680, 60, 100, ""),
        ("EstusShard", 650, 180, 0, ""),
        ("Consumable", 200, 50, 0, "余火"),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb":
            fields.append(make_field("value", "Int", val))
        if kind == "RingDrop":
            fields.append(make_field("name", "String", name))
        if kind == "Consumable":
            fields.append(make_field("name", "String", name))
        entities.append(make_entity("Item", x, y, fields))

    # ---- Firelink NPCs (doc coords from FirelinkShrine.json) ----
    for name, kind, x, y, color, dialogue in [
        ("防火女", "LevelUp", 580, 520, "#f0e6d0", "欢迎回来，无火的灰烬。|我将守护这火焰，直到您归来。|请将灵魂交予我。我将以火焰的力量，使您变得更加强大。|[Enter] 升级"),
        ("铁匠安德烈", "Blacksmith", 830, 400, "#b87333", "哦，又见面了。这把老骨头还在呢。|需要修修补补的话尽管来找我。|[Enter] 强化武器 (1000灵魂)"),
        ("祭祀场侍女", "Merchant", 280, 400, "#8a7a6a", "欢迎光临……灰烬大人。|我这儿有些小玩意儿，也许能帮上忙。|[Enter] 购买"),
        ("脱逃者霍克伍德", "Dialogue", 400, 200, "#7a8a70", "你也是无火的灰烬吗……|我叫霍克伍德。曾经是法兰的深渊监视者……但我逃跑了。"),
        ("库尔兰的鲁德雷斯", "Dialogue", 650, 720, "#a08060", "嘿，灰烬。我是库尔兰的鲁德雷斯。|我自愿坐上这把椅子——成为薪王。|如果你有Boss的灵魂，拿来给我。我可以将其转化为武器或魔法。"),
        ("卡里姆的伊莉娜", "Merchant", 150, 600, "#d0c0e0", "……你是谁？啊，触碰到了我。|我是伊莉娜，卡里姆的圣职者。|如果您有圣典的话，请让我触碰它。"),
        ("隆道尔的尤艾尔", "Merchant", 180, 500, "#505050", "啊，灰烬……你来了。|我是尤艾尔，来自隆道尔的朝圣者。|让我为你做一件好事吧。免费的力量……不需要代价。"),
        ("小偷格雷瑞特", "Merchant", 450, 800, "#8b4513", "我是格雷瑞特，不死聚落的小偷。|如果你需要什么稀罕玩意儿，也许我能帮上忙……"),
        ("大沼的柯尔尼克斯", "Merchant", 850, 600, "#daa520", "哦，大沼的习俗可真让人怀念……|我是个咒术师。如果你有咒术书的话，我可以从中习得新的咒术。"),
        ("阿斯托拉的安里", "Dialogue", 500, 350, "#b0c4de", "你好，我是安里。阿斯托拉的安里。|你也在寻找薪王吗？"),
        ("沉默的霍拉斯", "Dialogue", 520, 340, "#696969", "……安里……"),
        ("指头的列奥纳德", "Dialogue", 600, 250, "#8b0000", "哦，你也是无火的灰烬吗？|我是列奥纳德。去入侵其他世界吧。"),
        ("维恩海姆的奥贝克", "Merchant", 750, 700, "#4169e1", "我是奥贝克，来自维恩海姆的魔法师。|如果你需要魔法……给我卷轴，我就教你。"),
        ("无火的太阳骑士希里斯", "Dialogue", 500, 280, "#c0c0c0", "我是希里斯……无火的太阳骑士。|我发誓效忠于你……请允许我助你一臂之力。"),
        ("不屈不挠的帕奇", "Dialogue", 700, 600, "#cd853f", "哦！这不是我的老朋友吗？|上面的塔楼有好东西哦……去看看吧。"),
        ("隆道尔的尤莉亚", "Merchant", 200, 750, "#1a1a2e", "我是尤莉亚。隆道尔的黑色使徒。|你身上承载着黑暗印记……这是篡火的第一步。"),
        ("卡里姆的伊贡", "Dialogue", 120, 580, "#4a5568", "……别靠近伊莉娜。|如果她被黑暗侵蚀了……我会亲手了结她。"),
        ("卡菈", "Merchant", 350, 800, "#2f2f4f", "我是卡菈……一个被囚禁的魔女。|如果你有那些被禁止的魔法书……我可以从中习得。"),
        ("啾啾乌鸦", "Merchant", 700, 100, "#ffd700", "啾啾！嘭嘭！|……（乌鸦似乎在等待你放入什么东西）……"),
    ]:
        entities.append(make_entity("Npc", x, y, [
            make_field("name", "String", name),
            make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    # ---- Fog gates ----
    # Boss fog gate (arena south entrance, self-referential → triggers Gundyr)
    # Entrance gap at tiles x:75-81 (ground), y=103-104
    # Place gate at tile center: x=78*16+8=1256, y=103*16+8=1656
    entities.append(make_entity("FogGate", 1256, 1656, [
        make_field("dest_area", "String", "CemeteryOfAsh"),
        make_field("dest_x", "Float", 1300.0),
        make_field("dest_y", "Float", 1410.0),
        make_field("width", "Float", 128.0),
        make_field("height", "Float", 32.0),
    ]))
    # Fog gate to LothricWall (east wall of Firelink main hall)
    # Center on the ground/wall boundary (Firelink extends to tile x=62 = pixel 992)
    entities.append(make_entity("FogGate", 992, 450, [
        make_field("dest_area", "String", "LothricWall"),
        make_field("dest_x", "Float", 240.0),
        make_field("dest_y", "Float", 240.0),
        make_field("width", "Float", 32.0),
        make_field("height", "Float", 200.0),
    ]))

    # ---- Lights ----
    # Cemetery lights (doc coords → merged via cy)
    for x, doc_y, r, cr, cg, cb, intensity in [
        (200, 200, 100, 0.6, 0.5, 0.4, 0.3),   # 苏醒棺木
        (1000, 700, 80, 0.5, 0.45, 0.35, 0.25),  # 庭院枯树
        (1300, 1150, 120, 0.9, 0.75, 0.4, 0.5),  # 古达螺旋剑
    ]:
        entities.append(make_entity("Light", x, cy(doc_y), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))
    # Firelink lights (doc coords directly)
    for x, y, r, cr, cg, cb, intensity in [
        (600, 500, 250, 0.9, 0.75, 0.4, 0.8),    # 中央篝火
        (830, 400, 80, 1.0, 0.5, 0.2, 0.4),       # 安德烈火炉
        (650, 720, 60, 0.8, 0.6, 0.3, 0.3),       # 鲁德雷斯王座
    ]:
        entities.append(make_entity("Light", x, y, [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    # ---- Tile patch for boss arena door ----
    # The arena south wall gap (x:75-81, y:104) is blocked until Gundyr is defeated.
    # After defeat, tiles become ground so player can re-enter.
    entities.append(make_tile_patch(1200, 1664, "Ground", 75, 104, 81, 106, "gundyr_door_open"))

    return chunk, entities

def make_lothric_wall():
    chunk = new_chunk()
    entities = []

    # Design doc: 3600×2800 pixels, 7 sections
    # Scale to fit 2560×2560 chunk: S=0.8 (3100×2400 content → 2480×1920)
    S = 0.8
    def t(v): return max(0, min(CHUNK_SIZE - 1, int(v * S) // 16))  # doc pixel → tile
    def p(v): return int(v * S)                                       # doc pixel → scaled pixel

    # ===== Terrain: 7 sections from LothricWall.json =====

    # 1. 城墙入口: (0,0)-(600,600) → tiles (0,0)-(30,30)
    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(600), t(600))
    # 2. 骑士庭院: (500,500)-(1100,1000) → tiles (25,25)-(55,50)
    fill_tiles(chunk, TILE_GROUND, t(500), t(500), t(1100), t(1000))
    # 3. 飞龙屋顶: (900,300)-(1600,800) → tiles (45,15)-(80,40)
    fill_tiles(chunk, TILE_GROUND, t(900), t(300), t(1600), t(800))
    # 4. 民房区域: (1400,600)-(2000,1200) → tiles (70,30)-(100,60)
    fill_tiles(chunk, TILE_GROUND, t(1400), t(600), t(2000), t(1200))
    # 5. 教堂区: (2000,1000)-(2500,1400) → tiles (100,50)-(125,70)
    fill_tiles(chunk, TILE_GROUND, t(2000), t(1000), t(2500), t(1400))
    # 6. 冰霜阶梯: (2300,1400)-(2700,2000) → tiles (115,70)-(135,100)
    fill_tiles(chunk, TILE_GROUND, t(2300), t(1400), t(2700), t(2000))
    # 7. 波尔多竞技场: (2400,1900)-(3100,2400) → tiles (120,95)-(155,120)
    fill_tiles(chunk, TILE_GROUND, t(2400), t(1900), t(3100), t(2400))

    # ===== Vordt arena walls (section 7: tiles 120..155, 95..120) =====
    # North wall with 5-tile entrance gap (tiles 133..137) connecting to 冰霜阶梯
    for x in range(120, 156):
        if x < 133 or x > 137:
            if 0 <= x < CHUNK_SIZE:
                chunk[95][x] = TILE_WALL
    # West wall
    for y in range(95, 121):
        if 0 <= y < CHUNK_SIZE:
            chunk[y][120] = TILE_WALL
    # East wall
    for y in range(95, 121):
        if 0 <= y < CHUNK_SIZE:
            chunk[y][155] = TILE_WALL
    # South wall
    for x in range(120, 156):
        if 0 <= x < CHUNK_SIZE:
            chunk[120][x] = TILE_WALL

    # ===== 城墙入口 walls (section 1: tiles 0-30, 0-30) =====
    # South wall of entrance area, gaps at x:3-6 (return gate) and x:12-18 (to courtyard)
    for x in range(0, 31):
        if (x < 3 or x > 6) and (x < 12 or x > 18):
            chunk[22][x] = TILE_WALL
    # Side walls creating corridors
    for y in range(0, 22):
        chunk[y][8] = TILE_WALL     # west corridor wall
    # Stone gate pillars — castle entrance arch
    fill_tiles(chunk, TILE_WALL, 10, 5, 12, 10)    # gate pillar left
    fill_tiles(chunk, TILE_WALL, 17, 5, 19, 10)    # gate pillar right
    fill_tiles(chunk, TILE_WALL, 20, 8, 22, 12)    # guard post
    fill_tiles(chunk, TILE_WALL, 25, 15, 27, 19)   # stone column
    # Battlement walls along top edge
    for x in range(0, 30):
        if x % 4 < 2:  # crenellation pattern
            chunk[0][x] = TILE_WALL
    # Rubble near entrance
    fill_tiles(chunk, TILE_WALL, 4, 15, 6, 17)
    fill_tiles(chunk, TILE_WALL, 22, 18, 24, 20)

    # ===== 骑士庭院 walls (section 2: tiles 25-55, 25-50) =====
    # South wall, gap at x:38-42 for passage to 民房
    for x in range(25, 56):
        if x < 38 or x > 42:
            chunk[50][x] = TILE_WALL
    # East wall with gate to dragon roof
    for y in range(25, 50):
        if y < 30 or y > 35:
            chunk[y][55] = TILE_WALL
    # Courtyard interior: stone pillars and dead tree
    fill_tiles(chunk, TILE_WALL, 32, 33, 34, 35)   # pillar NW
    fill_tiles(chunk, TILE_WALL, 46, 36, 48, 38)   # pillar NE
    fill_tiles(chunk, TILE_WALL, 36, 42, 42, 43)   # low wall (dead tree base)
    # Knight training dummies (wall blocks)
    fill_tiles(chunk, TILE_WALL, 28, 40, 29, 41)
    fill_tiles(chunk, TILE_WALL, 50, 44, 51, 45)
    # Broken wall segment
    for x in range(38, 48):
        if x < 41 or x > 44:
            chunk[32][x] = TILE_WALL

    # ===== 飞龙屋顶 narrow bridge (section 3: tiles 45-80, 15-40) =====
    # "通往屋顶的狭长通道" — partial walls narrowing the path
    # North side wall from x:50 eastward (gap at x:50-54 for courtyard access)
    for x in range(50, 81):
        if x < 50 or x > 54:
            chunk[22][x] = TILE_WALL
    # South side wall from x:50 eastward (gap at x:60-64 for passage south)
    for x in range(50, 81):
        if x < 60 or x > 64:
            chunk[36][x] = TILE_WALL
    # Dragon perch area — large wall structure representing dragon roost
    fill_tiles(chunk, TILE_WALL, 65, 24, 67, 34)   # dragon perch column
    # Dragon bones/skeleton (wall clusters around perch)
    fill_tiles(chunk, TILE_WALL, 60, 26, 62, 30)   # bone pile left
    fill_tiles(chunk, TILE_WALL, 70, 28, 72, 32)   # bone pile right
    # Burned pillars (fire-scorched structures)
    fill_tiles(chunk, TILE_WALL, 55, 25, 56, 28)
    fill_tiles(chunk, TILE_WALL, 75, 30, 76, 33)
    # Narrow bridge gaps in the walls
    for x in range(63, 67):
        chunk[22][x] = TILE_WALL  # close gap near dragon
    for x in range(58, 62):
        chunk[36][x] = TILE_WALL  # close gap near dragon

    # ===== 民房区域 internal walls (narrow alleys, tiles 70..100, 30..60) =====
    # Building walls creating narrow street alleys (DS3-style multi-story houses)
    # Row of buildings — walls with door gaps
    fill_tiles(chunk, TILE_WALL, 74, 36, 94, 36)
    fill_tiles(chunk, TILE_WALL, 72, 46, 92, 46)
    fill_tiles(chunk, TILE_WALL, 76, 54, 96, 54)
    # N-S divider walls creating alleyways
    fill_tiles(chunk, TILE_WALL, 85, 32, 85, 40)
    fill_tiles(chunk, TILE_WALL, 78, 42, 78, 50)
    fill_tiles(chunk, TILE_WALL, 92, 48, 92, 56)
    # House corner blocks (building foundations)
    fill_tiles(chunk, TILE_WALL, 72, 32, 74, 35)
    fill_tiles(chunk, TILE_WALL, 95, 50, 98, 53)
    fill_tiles(chunk, TILE_WALL, 70, 56, 73, 59)
    # Wooden debris (collapsed structures)
    fill_tiles(chunk, TILE_WALL, 88, 38, 90, 40)
    fill_tiles(chunk, TILE_WALL, 80, 50, 82, 52)

    # ===== 教堂区 walls (section 5: tiles 100-125, 50-70) =====
    # Church building with interior
    # West wall, gap at y:57-62 for entrance from 民房
    for y in range(50, 71):
        if y < 57 or y > 62:
            chunk[y][100] = TILE_WALL
    # East wall, gap at y:57-62 for exit to 冰霜阶梯
    for y in range(50, 71):
        if y < 57 or y > 62:
            chunk[y][125] = TILE_WALL
    # North wall
    for x in range(100, 126):
        chunk[50][x] = TILE_WALL
    # South wall, gap at x:110-115 for back exit
    for x in range(100, 126):
        if x < 110 or x > 115:
            chunk[70][x] = TILE_WALL
    # Interior: altar, pews
    fill_tiles(chunk, TILE_WALL, 109, 65, 117, 67)  # altar
    fill_tiles(chunk, TILE_WALL, 104, 58, 106, 63)  # left pew
    fill_tiles(chunk, TILE_WALL, 120, 58, 122, 63)  # right pew

    # ===== 冰霜阶梯 narrow staircase (section 6: tiles 115-135, 70-100) =====
    # West staircase wall (start at y=73 to leave gap at y:70-72 for church connection)
    for y in range(73, 95):
        chunk[y][115] = TILE_WALL
    # East staircase wall (gap at y:95-100 for arena entrance)
    for y in range(70, 95):
        chunk[y][135] = TILE_WALL


    # ===== Player spawn & bonfires =====
    entities.append(make_entity("PlayerSpawn", p(300), p(300), [make_field("heal", "Bool", False)]))
    entities.append(make_entity("Bonfire", p(300), p(300)))     # 高墙入口篝火
    entities.append(make_entity("Bonfire", p(1200), p(600)))    # 高墙边塔篝火

    # ===== Boss: Vordt =====
    entities.append(make_entity("BossSpawn", p(2750), p(2150)))

    # ===== Enemies from design doc (22 entries, LothricWyvern skipped) =====
    for kind, dx, dy, count in [
        ("HollowSoldier", 400, 350, 2),    # 城墙入口巡逻
        ("HollowSoldier", 550, 450, 1),     # 城墙角落站哨
        ("LothricKnight", 700, 700, 1),     # 骑士庭院
        ("HollowSoldier", 800, 600, 3),     # 庭院士兵群
        ("StarvedHound", 650, 800, 2),      # 庭院下方饿犬
        ("HollowSoldier", 1000, 400, 2),    # 飞龙屋顶通道
        ("HollowSoldier", 1100, 500, 3),    # 龙焰桥梁旁
        ("HollowSoldier", 1500, 700, 2),    # 民房入口
        ("HollowSoldier", 1600, 850, 2),    # 民房巷道
        ("Assassin", 1650, 750, 1),         # 民房暗处刺客
        ("LothricKnight", 1800, 900, 1),    # 民房深处骑士
        ("HollowSoldier", 2100, 1100, 2),   # 教堂区前士兵
        ("StarvedHound", 2200, 1200, 2),    # 教堂附近猎犬
        ("LothricKnight", 2500, 1600, 1),   # 冰霜阶梯骑士
        ("HollowSoldier", 2450, 1750, 2),   # 阶梯下方士兵
        ("CrystalLizard", 1150, 550, 1),    # 飞龙屋顶水晶蜥蜴
        ("Darkwraith", 1700, 1000, 1),      # 民房区域深处
        ("WingedKnight", 950, 750, 1),      # 高塔翼骑士
        ("HollowSoldier", 1350, 650, 1),    # 民房区附近 (LargeHollowSoldier→HollowSoldier)
        ("PusOfMan", 1100, 350, 1),         # 飞龙人之脓
        ("CrystalLizard", 600, 900, 1),     # 庭院下方水晶蜥蜴
    ]:
        for i in range(count):
            ox = (i * 24) % 48 - 24
            oy = (i * 18) % 36 - 18
            entities.append(make_entity("Enemy", p(dx) + ox, p(dy) + oy, [
                make_field("kind", "LocalEnum.EnemyKind", kind),
            ]))

    # ===== Items from design doc =====
    for kind, dx, dy, extra in [
        ("SoulOrb", 350, 400, [("value", "Int", 200)]),
        ("SoulOrb", 750, 650, [("value", "Int", 300)]),
        ("SoulOrb", 1150, 450, [("value", "Int", 400)]),
        ("SoulOrb", 1200, 480, [("value", "Int", 500)]),
        ("EstusShard", 1050, 550, []),
        ("EstusShard", 1550, 800, []),
        ("HomewardBone", 1450, 700, []),
        ("SoulOrb", 2350, 1550, [("value", "Int", 300)]),
        ("SoulOrb", 2600, 1800, [("value", "Int", 500)]),
        ("WeaponDrop", 900, 700, [("name", "String", "克莱莫大剑")]),
        ("WeaponDrop", 1550, 650, [("name", "String", "亚斯特拉直剑")]),
        ("WeaponDrop", 1600, 900, [("name", "String", "刺剑")]),
        ("WeaponDrop", 1750, 800, [("name", "String", "长弓")]),
        ("Consumable", 950, 800, [("name", "String", "银鸢盾")]),
        ("Firebomb", 500, 500, [("name", "String", "火焰壶")]),
        ("Consumable", 1650, 750, [("name", "String", "投掷小刀")]),
        ("TitaniteShard", 1300, 600, [("name", "String", "楔形石碎片")]),
        ("TitaniteShard", 2100, 1150, [("name", "String", "楔形石碎片")]),
        ("Consumable", 750, 700, [("name", "String", "熟练宝石")]),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        for fname, ftype, fval in extra:
            fields.append(make_field(fname, ftype, fval))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    # ===== Chests from design doc =====
    for dx, dy, lk, lv, ln, mimic in [
        (620, 750, "WeaponDrop", 0, "长剑", False),
        (1700, 900, "Consumable", 0, "牢房钥匙", False),
        (1850, 750, "WeaponDrop", 0, "阔剑", False),
        (1450, 800, "WeaponDrop", 0, "匕首", False),
        (1050, 550, "WeaponDrop", 0, "深渊战斧", True),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv),
            make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    # ===== NPCs from design doc =====
    for name, kind, dx, dy, color, dialogue in [
        ("艾玛", "Dialogue", 2150, 1150, "#c0a0d0",
         "你好，无火的灰烬。|我是艾玛，洛斯里克的高阶女祭司。|洛斯里克王子……他已无心继任薪王之位。|请找到他，将这小环旗交给他吧。|[Enter] 获取小环旗"),
        ("葛雷瑞特", "Dialogue", 1550, 800, "#a0a0a0",
         "……你是谁？是来放我出去的吗？|如果你能帮我找到牢房钥匙，我愿意为你效劳。|我是个小偷，但我知道感恩。"),
        ("青教誓约", "Dialogue", 2050, 1100, "#6080c0",
         "你愿意宣誓青教誓约吗？我们将共同守护这片土地。"),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name),
            make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    # ===== Fog gates =====
    # 1. Return to CemeteryOfAsh (west side of entrance, horizontal gate)
    entities.append(make_entity("FogGate", p(100), p(300), [
        make_field("dest_area", "String", "CemeteryOfAsh"),
        make_field("dest_x", "Float", 1050.0),
        make_field("dest_y", "Float", 450.0),
        make_field("width", "Float", 200.0),
        make_field("height", "Float", 32.0),
    ]))
    # 2. Boss fog gate — Vordt arena north entrance (self-referential)
    entities.append(make_entity("FogGate", p(2700), p(1900), [
        make_field("dest_area", "String", "LothricWall"),
        make_field("dest_x", "Float", float(p(2700))),
        make_field("dest_y", "Float", float(p(2000))),
        make_field("width", "Float", 80.0),
        make_field("height", "Float", 32.0),
    ]))
    # 3. To UndeadSettlement (after Vordt, doc: x:2900, y:2050)
    entities.append(make_entity("FogGate", p(2900), p(2050), [
        make_field("dest_area", "String", "UndeadSettlement"),
        make_field("dest_x", "Float", 200.0),
        make_field("dest_y", "Float", 300.0),
        make_field("width", "Float", float(p(200))),
        make_field("height", "Float", float(p(40))),
    ]))
    # 4. To LothricCastle (from church area east side)
    entities.append(make_entity("FogGate", p(2500), p(1200), [
        make_field("dest_area", "String", "LothricCastle"),
        make_field("dest_x", "Float", 300.0),
        make_field("dest_y", "Float", 400.0),
        make_field("width", "Float", 40.0),
        make_field("height", "Float", 100.0),
    ]))

    # ===== Lights from design doc =====
    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 300, 180, 0.8, 0.7, 0.5, 0.6),
        (1200, 600, 180, 0.8, 0.7, 0.5, 0.6),
        (1100, 450, 200, 1.0, 0.5, 0.1, 0.8),
        (2150, 1150, 120, 0.6, 0.5, 0.8, 0.4),
        (2800, 2200, 180, 0.8, 0.7, 0.5, 0.6),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    return chunk, entities

def make_undead_settlement():
    chunk = new_chunk()
    entities = []

    # Design doc: 4000×3200, max content ~2900×2100
    # Scale to fit 2560×2560: S=0.8
    S = 0.8
    def t(v): return max(0, min(CHUNK_SIZE - 1, int(v * S) // 16))
    def p(v): return int(v * S)

    # ===== Terrain: 9 sections from UndeadSettlement.json =====
    # 1. 聚落入口: (0,0)-(600,500)
    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(600), t(500))
    # 2. 民房街道: (500,400)-(1100,900)
    fill_tiles(chunk, TILE_GROUND, t(500), t(400), t(1100), t(900))
    # 3. 巨人塔: (1000,300)-(1500,900)
    fill_tiles(chunk, TILE_GROUND, t(1000), t(300), t(1500), t(900))
    # 4. 篝火广场: (1400,700)-(1900,1100)
    fill_tiles(chunk, TILE_GROUND, t(1400), t(700), t(1900), t(1100))
    # 5. 铁笼道: (1800,500)-(2300,900)
    fill_tiles(chunk, TILE_GROUND, t(1800), t(500), t(2300), t(900))
    # 6. 火恶魔广场: (2000,900)-(2400,1300)
    fill_tiles(chunk, TILE_GROUND, t(2000), t(900), t(2400), t(1300))
    # 7. 朝圣者营地: (2200,600)-(2600,900) extended to x=148 to reach FogGate
    fill_tiles(chunk, TILE_GROUND, t(2200), t(600), t(2600), t(900))
    fill_tiles(chunk, TILE_GROUND, t(2600), t(600), 148, t(900))
    # 8. 地洞深渊 (boss arena): (1600,1500)-(2400,2100)
    fill_tiles(chunk, TILE_GROUND, t(1600), t(1500), t(2400), t(2100))
    # 9. 伊莉娜囚室: (2600,800)-(2900,1100)
    fill_tiles(chunk, TILE_GROUND, t(2600), t(800), t(2900), t(1100))

    # ===== Boss arena walls (section 8: tiles 80..120, 75..105) =====
    # North wall with entrance gap (tiles 90..95 open)
    for x in range(80, 121):
        if x < 90 or x > 95:
            if 0 <= x < CHUNK_SIZE:
                chunk[75][x] = TILE_WALL
    # West wall
    for y in range(75, 106):
        if 0 <= y < CHUNK_SIZE:
            chunk[y][80] = TILE_WALL
    # East wall
    for y in range(75, 106):
        if 0 <= y < CHUNK_SIZE:
            chunk[y][120] = TILE_WALL
    # South wall
    for x in range(80, 121):
        if 0 <= x < CHUNK_SIZE:
            chunk[105][x] = TILE_WALL

    # ===== Corridor from section 4 to boss arena entrance =====
    fill_tiles(chunk, TILE_GROUND, 90, 55, 96, 76)

    # ===== Section 1: 聚落入口 — narrow entrance corridor walls =====
    # Section tiles: (0,0)-(30,25). FogGate at tile (5,12), PlayerSpawn at (10,10)
    # North boundary wall (y=0) with small gap for atmosphere
    for x in range(0, 11):
        chunk[0][x] = TILE_WALL
    for x in range(14, 31):
        chunk[0][x] = TILE_WALL
    # South boundary wall (y=25) with gap at x:15-20 for connection to section 2
    for x in range(0, 15):
        chunk[25][x] = TILE_WALL
    for x in range(21, 31):
        chunk[25][x] = TILE_WALL
    # West boundary: narrow corridor walls funneling to FogGate at (5,12)
    for y in range(0, 10):
        chunk[y][0] = TILE_WALL
    for y in range(15, 26):
        chunk[y][0] = TILE_WALL
    # Wooden fence line inside entrance (middle divider, gaps for passage)
    for x in range(3, 8):
        chunk[6][x] = TILE_WALL
    for x in range(12, 18):
        chunk[15][x] = TILE_WALL

    # ===== Section 2: 民房街道 — dense building walls creating narrow alleys =====
    # Section tiles: (25,20)-(55,45). Maze-like residential area
    # Row 1 of buildings (y=28) — two wall segments with alley gap
    fill_tiles(chunk, TILE_WALL, 27, 28, 35, 28)
    fill_tiles(chunk, TILE_WALL, 38, 28, 47, 28)
    # Row 2 of buildings (y=36) — offset walls for maze feel
    fill_tiles(chunk, TILE_WALL, 28, 36, 38, 36)
    fill_tiles(chunk, TILE_WALL, 41, 36, 50, 36)
    # Building blocks (solid filled rectangles)
    fill_tiles(chunk, TILE_WALL, 29, 29, 33, 31)   # building A
    fill_tiles(chunk, TILE_WALL, 41, 29, 45, 31)   # building B
    fill_tiles(chunk, TILE_WALL, 32, 37, 36, 39)   # building C
    fill_tiles(chunk, TILE_WALL, 44, 37, 48, 39)   # building D
    # South edge buildings
    fill_tiles(chunk, TILE_WALL, 27, 42, 31, 42)
    fill_tiles(chunk, TILE_WALL, 40, 42, 50, 42)
    # North edge partial wall (keeps connection open to section 3)
    fill_tiles(chunk, TILE_WALL, 25, 20, 25, 24)

    # ===== Section 3: 巨人塔 — tower structure =====
    # Section tiles: (50,15)-(75,45). Tower in center
    # Tower walls — hollow rectangle in the middle of the section
    fill_tiles(chunk, TILE_WALL, 57, 22, 68, 22)   # north tower wall
    fill_tiles(chunk, TILE_WALL, 57, 34, 68, 34)   # south tower wall
    # West tower wall with door gap at y:27-29
    for y in range(22, 27):
        chunk[y][57] = TILE_WALL
    for y in range(30, 35):
        chunk[y][57] = TILE_WALL
    # East tower wall with door gap at y:27-29
    for y in range(22, 27):
        chunk[y][68] = TILE_WALL
    for y in range(30, 35):
        chunk[y][68] = TILE_WALL

    # ===== Section 4: 篝火广场 — open plaza with perimeter walls =====
    # Section tiles: (70,35)-(95,55). Open central area
    # North perimeter wall with gap at x:77-82 (path from section 3)
    for x in range(70, 77):
        chunk[35][x] = TILE_WALL
    for x in range(83, 96):
        chunk[35][x] = TILE_WALL
    # South perimeter wall with gap at x:85-90 (path to boss corridor)
    for x in range(70, 85):
        chunk[55][x] = TILE_WALL
    for x in range(91, 96):
        chunk[55][x] = TILE_WALL
    # Corner buttresses / small wall features around the plaza
    fill_tiles(chunk, TILE_WALL, 70, 35, 70, 38)   # NW pillar
    fill_tiles(chunk, TILE_WALL, 95, 35, 95, 38)   # NE pillar
    fill_tiles(chunk, TILE_WALL, 70, 52, 70, 55)   # SW pillar
    fill_tiles(chunk, TILE_WALL, 95, 52, 95, 55)   # SE pillar

    # ===== Section 5: 铁笼道 — narrow cage corridor =====
    # Section tiles: (90,25)-(115,45). Cliffside narrow path
    # North wall (cliff face) — solid with small gaps for atmosphere
    for x in range(90, 98):
        chunk[25][x] = TILE_WALL
    for x in range(100, 115):
        chunk[25][x] = TILE_WALL
    # South wall (abyss edge) — partial railing
    for x in range(90, 103):
        chunk[45][x] = TILE_WALL
    for x in range(105, 116):
        chunk[45][x] = TILE_WALL
    # Cage structures along the corridor
    fill_tiles(chunk, TILE_WALL, 95, 28, 97, 30)   # cage block A (north side)
    fill_tiles(chunk, TILE_WALL, 105, 33, 107, 35)  # cage block B (south side)
    # Narrowing walls at mid-point
    fill_tiles(chunk, TILE_WALL, 100, 25, 100, 28)  # north pinch
    fill_tiles(chunk, TILE_WALL, 103, 42, 103, 45)  # south pinch

    # ===== Section 9: 伊莉娜囚室 — small cell room =====
    # Section tiles: (130,40)-(145,55). Cell with iron door
    # Cell walls — enclosed room with entrance gap on west side
    fill_tiles(chunk, TILE_WALL, 130, 40, 130, 43)  # west wall upper part (gap at y:44-47)
    fill_tiles(chunk, TILE_WALL, 130, 48, 130, 55)  # west wall lower part
    fill_tiles(chunk, TILE_WALL, 145, 40, 145, 55)  # east wall (solid)
    fill_tiles(chunk, TILE_WALL, 130, 40, 145, 40)  # north wall (solid)
    fill_tiles(chunk, TILE_WALL, 130, 55, 145, 55)  # south wall (solid)
    # Interior partition creating a small antechamber
    fill_tiles(chunk, TILE_WALL, 137, 44, 137, 50)  # internal wall (gap at y:51-52)

    # ===== Player spawn & bonfires =====
    entities.append(make_entity("PlayerSpawn", p(200), p(200), [make_field("heal", "Bool", False)]))
    entities.append(make_entity("Bonfire", p(200), p(200)))       # 高墙下方
    entities.append(make_entity("Bonfire", p(600), p(480)))       # 不死聚落
    entities.append(make_entity("Bonfire", p(1200), p(800)))      # 颓旧桥端

    # ===== Boss: Curse-Rotted Greatwood =====
    entities.append(make_entity("BossSpawn", p(2000), p(1800)))

    # ===== Enemies from design doc =====
    for kind, dx, dy, count in [
        ("HollowSoldier", 400, 350, 2),      # 聚落入口
        ("HollowSoldier", 550, 500, 1),       # 民房街道入口
        ("HollowSoldier", 650, 600, 2),       # 街道士兵
        ("HollowSoldier", 800, 550, 2),       # 民房屋顶附近
        ("Assassin", 700, 650, 1),            # 街道屋顶刺客
        ("HollowSoldier", 1100, 500, 2),      # 巨人塔底部
        ("HollowSoldier", 1250, 650, 3),      # 巨人塔周围
        ("Evangelist", 1500, 800, 1),         # 篝火广场
        ("HollowSoldier", 1500, 800, 3),      # 篝火广场周围
        ("HollowSoldier", 1650, 750, 2),      # 广场侧面
        ("Assassin", 1900, 600, 2),           # 铁笼道刺客
        ("HollowSoldier", 2050, 700, 2),      # 铁笼道末端
        ("HollowSoldier", 2100, 1000, 2),     # 火恶魔广场附近
        ("Evangelist", 2100, 1050, 2),        # 火恶魔区域传教士
        ("HollowSoldier", 2700, 900, 2),      # 伊莉娜囚室附近
        ("StarvedHound", 500, 600, 2),        # 街道饿犬
        ("StarvedHound", 1700, 650, 2),       # 广场附近饿犬
        ("FireDemon", 2050, 950, 1),          # 火恶魔
        ("Thrall", 1000, 600, 3),             # 屋顶奴隶刺客
        ("PeasantHollow", 300, 300, 3),       # 聚落入口农民
        ("Dog", 1900, 1100, 4),               # 下水道老鼠(Rat→Dog)
        ("CrystalLizard", 2700, 850, 1),      # 伊莉娜附近水晶蜥蜴
        ("CrystalLizard", 1800, 1300, 1),     # Hodrick入侵区水晶蜥蜴
        ("Knight", 2900, 750, 1),             # 冷冽谷骑士(BorealKnight→Knight)
        ("Skeleton", 2550, 900, 4),           # 墓地骷髅兵
        ("Knight", 1250, 900, 1),             # 霍德里克(Hodrick→Knight)
        ("PeasantHollow", 2200, 1050, 3),     # 铁笼空心(CagedHollow→PeasantHollow)
        ("StarvedHound", 350, 350, 3),        # 入口亡犬群
    ]:
        for i in range(count):
            ox = (i * 24) % 48 - 24
            oy = (i * 18) % 36 - 18
            entities.append(make_entity("Enemy", p(dx) + ox, p(dy) + oy, [
                make_field("kind", "LocalEnum.EnemyKind", kind),
            ]))

    # ===== Items (key ones from design doc, using available ItemSpawnKinds) =====
    for kind, dx, dy, extra in [
        ("SoulOrb", 200, 250, [("value", "Int", 400)]),
        ("Consumable", 450, 400, [("name", "String", "诱敌头盖骨")]),
        ("HomewardBone", 500, 350, []),
        ("EstusShard", 1550, 850, []),
        ("Ember", 1600, 850, []),
        ("SoulOrb", 900, 580, [("value", "Int", 400)]),
        ("SoulOrb", 1050, 580, [("value", "Int", 200)]),
        ("HomewardBone", 1100, 520, []),
        ("WeaponDrop", 650, 550, [("name", "String", "小皮盾")]),
        ("TitaniteShard", 1850, 580, [("name", "String", "楔形石碎片")]),
        ("WeaponDrop", 2000, 520, [("name", "String", "手斧")]),
        ("Ember", 1750, 1050, []),
        ("TitaniteShard", 1400, 900, [("name", "String", "楔形石碎片")]),
        ("WeaponDrop", 1600, 950, [("name", "String", "鞭子")]),
        ("HomewardBone", 1950, 1780, []),
        ("SoulOrb", 2150, 700, [("value", "Int", 400)]),
        ("SoulOrb", 2450, 810, [("value", "Int", 400)]),
        ("UndeadBoneShard", 2280, 750, []),
        ("HomewardBone", 2080, 1100, []),
        ("TitaniteShard", 2560, 870, [("name", "String", "楔形石碎片")]),
        ("WeaponDrop", 2480, 880, [("name", "String", "红柄戟")]),
        ("SoulOrb", 2520, 900, [("value", "Int", 300)]),
        ("Ember", 2350, 820, []),
        ("SoulOrb", 2300, 800, [("value", "Int", 200)]),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        for fname, ftype, fval in extra:
            fields.append(make_field(fname, ftype, fval))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    # ===== Chests =====
    for dx, dy, lk, lv, ln, mimic in [
        (2150, 1050, "Consumable", 0, "人松脂", False),
        (1300, 600, "EstusShard", 0, "", False),
        (500, 700, "WeaponDrop", 0, "匕首", False),
        (750, 1200, "ArmorDrop", 0, "空心士兵铠甲", True),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv),
            make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    # ===== NPCs from design doc =====
    for name, kind, dx, dy, color, dialogue in [
        ("杰克塔尔的洋葱骑士", "Dialogue", 1050, 450, "#d4a840",
         "嗯？哦，你好啊！|我是杰克塔尔的杰克迈耶。你可以叫我洋葱骑士。|前面有个火焰恶魔，看起来不太好对付。|要不要一起去？两个总比一个好！"),
        ("隆道尔的尤艾尔", "Dialogue", 2300, 700, "#505060",
         "你也是……无火的灰烬吗？|我是尤艾尔，来自隆道尔的朝圣者。|我可以给你一份力量。免费的，不需要回报。"),
        ("大沼的柯弭库斯", "Dialogue", 1900, 550, "#a08050",
         "嘿！有人吗？！我被关在这个铁笼里了！|我是咒术师柯弭库斯。如果你放了我，我可以教你咒术！"),
        ("卡里姆的伊莉娜", "Dialogue", 2650, 850, "#d0a0c0",
         "……是谁？我是伊莉娜，来自卡里姆的盲眼少女。|如果你能带我离开这里……我可以为你解读奇迹经文。"),
        ("卡里姆的伊贡", "Dialogue", 2580, 820, "#606060",
         "停在那里。后面的女人归我保护。|如果你没有恶意，那就走开。"),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name),
            make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    # ===== Fog gates =====
    # 1. Return to LothricWall (west side, horizontal)
    entities.append(make_entity("FogGate", p(100), p(250), [
        make_field("dest_area", "String", "LothricWall"),
        make_field("dest_x", "Float", 2320.0),
        make_field("dest_y", "Float", 1640.0),
        make_field("width", "Float", 200.0),
        make_field("height", "Float", 32.0),
    ]))
    # 2. Boss fog gate — Greatwood arena entrance (corridor at tiles 90-95)
    # Center of entrance gap: tile x=92-93, y=75 → pixel (1488, 1200)
    entities.append(make_entity("FogGate", 1488, 1200, [
        make_field("dest_area", "String", "UndeadSettlement"),
        make_field("dest_x", "Float", float(p(2000))),
        make_field("dest_y", "Float", float(p(1800))),
        make_field("width", "Float", 80.0),
        make_field("height", "Float", 32.0),
    ]))
    # 3. To RoadOfSacrifices (east side, horizontal)
    entities.append(make_entity("FogGate", p(2900), p(700), [
        make_field("dest_area", "String", "RoadOfSacrifices"),
        make_field("dest_x", "Float", 200.0),
        make_field("dest_y", "Float", 400.0),
        make_field("width", "Float", float(p(200))),
        make_field("height", "Float", 32.0),
    ]))

    # ===== Lights =====
    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 400, 180, 0.8, 0.7, 0.5, 0.6),
        (600, 500, 150, 0.8, 0.7, 0.5, 0.5),
        (1200, 800, 180, 0.8, 0.7, 0.5, 0.6),
        (2000, 1800, 180, 0.8, 0.7, 0.5, 0.6),
        (2050, 950, 200, 1.0, 0.4, 0.1, 0.7),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    return chunk, entities

def make_cathedral_deep():
    chunk = new_chunk()
    entities = []

    # Design doc: 3400×2600, max content to (3400,2600)
    # Scale to fit 2560×2560: S=0.75
    S = 0.75
    def t(v): return max(0, min(CHUNK_SIZE - 1, int(v * S) // 16))
    def p(v): return int(v * S)

    # ===== Terrain: 11 sections from CathedralDeep.json =====
    # 1. 墓地入口: (0,0)-(600,600)
    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(600), t(600))
    # 2. 净身小教会: (200,300)-(600,600)
    fill_tiles(chunk, TILE_GROUND, t(200), t(300), t(600), t(600))
    # 3. 外部墓园: (600,500)-(1300,1100)
    fill_tiles(chunk, TILE_GROUND, t(600), t(500), t(1300), t(1100))
    # 4. 教堂正门: (1200,800)-(1700,1200)
    fill_tiles(chunk, TILE_GROUND, t(1200), t(800), t(1700), t(1200))
    # 5. 教堂侧廊: (1500,900)-(1900,1400)
    fill_tiles(chunk, TILE_GROUND, t(1500), t(900), t(1900), t(1400))
    # 6. 教堂中庭: (1300,1000)-(1900,1500)
    fill_tiles(chunk, TILE_GROUND, t(1300), t(1000), t(1900), t(1500))
    # 7. 上层回廊: (1600,800)-(2200,1200)
    fill_tiles(chunk, TILE_GROUND, t(1600), t(800), t(2200), t(1200))
    # 8. 井中洋葱: (1400,1300)-(1600,1500)
    fill_tiles(chunk, TILE_GROUND, t(1400), t(1300), t(1600), t(1500))
    # 9. 主教祭坛 (boss arena): (1800,1600)-(2500,2100)
    fill_tiles(chunk, TILE_GROUND, t(1800), t(1600), t(2500), t(2100))
    # 10. 蛞蝓走廊: (2600,2000)-(3000,2400)
    fill_tiles(chunk, TILE_GROUND, t(2600), t(2000), t(3000), t(2400))
    # 11. 罗莎莉亚寝室: (3000,2200)-(3400,2600)
    fill_tiles(chunk, TILE_GROUND, t(3000), t(2200), t(3400), t(2600))

    # ===== Corridor: section 6 → boss arena (section 9) =====
    fill_tiles(chunk, TILE_GROUND, 84, 70, 92, 76)
    # ===== Corridor: boss arena → 蛞蝓走廊 (section 10) =====
    fill_tiles(chunk, TILE_GROUND, 117, 93, 122, 98)
    # ===== Corridor: section 10 → Rosaria chamber (section 11) =====
    fill_tiles(chunk, TILE_GROUND, 137, 103, 144, 112)

    # ===== Detailed wall structures =====

    # --- Section 1-2: Graveyard exterior (tiles 0-28, 0-28) ---
    # Ruined wall fragments scattered through graveyard
    for wx, wy in [(5, 8), (6, 8), (18, 5), (19, 5), (10, 20), (11, 20)]:
        chunk[wy][wx] = TILE_WALL
    # Tombstone rows in graveyard (1x2 wall blocks)
    for tx, ty in [(3, 12), (3, 13), (7, 10), (7, 11), (12, 15), (12, 16),
                   (16, 12), (16, 13), (22, 10), (22, 11), (25, 18), (25, 19),
                   (14, 22), (14, 23), (8, 25), (8, 26)]:
        chunk[ty][tx] = TILE_WALL
    # Dead trees (2x2 wall pillars)
    for dx, dy in [(4, 17), (20, 14)]:
        for ddy in range(2):
            for ddx in range(2):
                chunk[dy + ddy][dx + ddx] = TILE_WALL
    # Small chapel wall (section 2) - interior wall with doorway
    for x in range(9, 24):
        if x < 14 or x > 16:  # door gap at x=14..16
            chunk[17][x] = TILE_WALL

    # --- Section 3: Exterior graveyard (tiles 28-60, 23-51) ---
    # Broken perimeter wall (north side)
    for x in range(28, 58):
        if x < 32 or (x > 35 and x < 38) or (x > 41 and x < 45) or x > 48:
            chunk[23][x] = TILE_WALL
    # Tombstone clusters in graveyard
    for tx, ty in [(30, 28), (30, 29), (35, 32), (35, 33), (40, 30), (40, 31),
                   (45, 35), (45, 36), (50, 28), (50, 29), (55, 33), (55, 34),
                   (32, 38), (32, 39), (38, 42), (38, 43), (48, 40), (48, 41),
                   (52, 45), (52, 46), (42, 47), (42, 48)]:
        chunk[ty][tx] = TILE_WALL
    # Dead trees in graveyard
    for dx, dy in [(34, 26), (47, 37), (53, 42)]:
        for ddy in range(2):
            for ddx in range(2):
                chunk[dy + ddy][dx + ddx] = TILE_WALL
    # Giant tree (large wall pillar, 3x3)
    for dy in range(3):
        for dx in range(3):
            chunk[44 + dy][36 + dx] = TILE_WALL

    # --- Section 4: Cathedral main gate (tiles 56-79, 37-56) ---
    # Grand cathedral front wall (south side with closed gate)
    for x in range(56, 80):
        if x < 62 or x > 67:  # closed gate at x=62..67
            chunk[56][x] = TILE_WALL
    # Gate pillars (flanking the closed gate)
    for y in range(52, 57):
        chunk[y][61] = TILE_WALL
        chunk[y][68] = TILE_WALL
    # Side walls of gate approach
    for y in range(48, 56):
        chunk[y][56] = TILE_WALL
        chunk[y][79] = TILE_WALL
    # Inner courtyard pillars
    for px in [60, 65, 70, 75]:
        for py in range(42, 45):
            chunk[py][px] = TILE_WALL

    # --- Section 5: Cathedral side hall (tiles 70-89, 42-65) ---
    # Narrow corridor walls
    for y in range(42, 66):
        chunk[y][70] = TILE_WALL
    # Statue alcoves (small wall pillars along corridor)
    for sy in range(46, 62, 4):
        for dy in range(2):
            chunk[sy + dy][73] = TILE_WALL
            chunk[sy + dy][76] = TILE_WALL
    # Dark corner ambush walls
    for dx in range(2):
        for dy in range(3):
            chunk[60 + dy][87 + dx] = TILE_WALL

    # --- Section 6: Cathedral nave / interior (tiles 60-89, 46-70) ---
    # Interior pillars (cathedral columns, 2x2 each)
    pillar_positions = [(63, 50), (63, 58), (63, 66),
                        (74, 50), (74, 58), (74, 66),
                        (85, 50), (85, 58)]
    for px, py in pillar_positions:
        for dy in range(2):
            for dx in range(2):
                chunk[py + dy][px + dx] = TILE_WALL
    # Pew rows (1-wide wall lines representing benches)
    for pew_y in [53, 54, 61, 62]:
        for x in range(66, 73):
            chunk[pew_y][x] = TILE_WALL
    # Altar platform wall at front of nave
    for x in range(65, 88):
        if x < 68 or x > 70:  # gap to approach altar
            chunk[46][x] = TILE_WALL
    # Deep pit edge (where Patches kicks player)
    for x in range(70, 80):
        chunk[68][x] = TILE_WALL
    # Pit opening (gap to fall through)
    for x in range(72, 78):
        chunk[68][x] = TILE_GROUND  # leave opening in pit wall

    # --- Section 7: Upper gallery (tiles 75-103, 37-56) ---
    # Gallery railing (low wall along overlook)
    for x in range(75, 104):
        chunk[56][x] = TILE_WALL
    # Railing gap to look down into nave
    for x in range(85, 90):
        chunk[56][x] = TILE_GROUND
    # Gallery interior pillars
    for px in [80, 90, 100]:
        for dy in range(2):
            chunk[44 + dy][px] = TILE_WALL
    # Hidden path wall (partial, with gap for secret route)
    for y in range(37, 50):
        chunk[y][103] = TILE_WALL
    # Hidden path gap
    for y in range(42, 46):
        chunk[y][103] = TILE_GROUND
    # Cathedral knight station (wall block)
    for dy in range(2):
        for dx in range(3):
            chunk[38 + dy][95 + dx] = TILE_WALL

    # --- Section 8: Well area (tiles 65-75, 60-70) ---
    # Well shaft walls (square ring with opening)
    for x in range(67, 74):
        if x < 69 or x > 71:
            chunk[63][x] = TILE_WALL
            chunk[67][x] = TILE_WALL
    for y in range(63, 68):
        chunk[y][67] = TILE_WALL
        if y < 65 or y > 66:
            chunk[y][73] = TILE_WALL
    # Well opening (keep ground at center)
    fill_tiles(chunk, TILE_GROUND, 69, 64, 71, 66)
    # Surrounding ruined walls
    for wx in [65, 75]:
        for wy in range(60, 70):
            chunk[wy][wx] = TILE_WALL
    # Gap to enter well area from nave
    for y in range(63, 68):
        chunk[y][65] = TILE_GROUND

    # ===== Boss arena walls (section 9: tiles 84..117, 75..98) =====
    # North wall with entrance gap (tiles 88..92 open)
    for x in range(84, 118):
        if x < 88 or x > 92:
            if 0 <= x < CHUNK_SIZE:
                chunk[75][x] = TILE_WALL
    # West wall
    for y in range(75, 99):
        if 0 <= y < CHUNK_SIZE:
            chunk[y][84] = TILE_WALL
    # East wall (gap at y:93-98 for corridor to section 10)
    for y in range(75, 99):
        if (y < 93 or y > 98) and 0 <= y < CHUNK_SIZE:
            chunk[y][117] = TILE_WALL
    # South wall (gap at x:117-122 for corridor to section 10)
    for x in range(84, 118):
        if x < 117 and 0 <= x < CHUNK_SIZE:
            chunk[98][x] = TILE_WALL
    # Boss arena interior: altar at far end
    for dy in range(2):
        for dx in range(4):
            chunk[80 + dy][98 + dx] = TILE_WALL
    # Boss arena: deep chalice/vessel (wall pillar)
    for dy in range(2):
        for dx in range(2):
            chunk[82 + dy][104 + dx] = TILE_WALL
    # Boss arena: side pillars
    for py in [82, 90]:
        for dy in range(2):
            chunk[py + dy][88] = TILE_WALL
            chunk[py + dy][113] = TILE_WALL

    # --- Section 10: Slug corridor (tiles 121-140, 93-112) ---
    # Narrow corridor walls (squeeze passage) — west wall with entrance gap
    for y in range(93, 113):
        if y < 93 or y > 98:  # gap at y=93-98 for corridor from boss arena
            chunk[y][121] = TILE_WALL
    # Corridor narrows at points
    for y in range(98, 103):
        chunk[y][125] = TILE_WALL
    for y in range(105, 110):
        chunk[y][135] = TILE_WALL
    # Slime-covered wall protrusions (avoid blocking corridor to Rosaria at x>=136)
    for sx, sy in [(128, 96), (132, 100), (126, 106), (130, 108), (134, 99)]:
        chunk[sy][sx] = TILE_WALL

    # --- Section 11: Rosaria's chamber (tiles 140-159, 103-121) ---
    # Chamber walls forming a room
    for x in range(140, 160):
        if x < 137 or x > 144:  # skip corridor connection area
            chunk[103][x] = TILE_WALL
    # Chamber side walls (west wall with gap for corridor entry at y=103-112)
    for y in range(103, 122):
        if 0 <= y < CHUNK_SIZE:
            if y < 103 or y > 112:  # gap at y=103-112 for corridor
                chunk[y][140] = TILE_WALL
    for y in range(103, 122):
        if 0 <= y < CHUNK_SIZE:
            chunk[y][159] = TILE_WALL
    # South wall
    for x in range(140, 160):
        if 0 <= x < CHUNK_SIZE:
            chunk[121][x] = TILE_WALL
    # Rosaria's bed alcove (wall niche)
    for dy in range(2):
        for dx in range(3):
            chunk[115 + dy][152 + dx] = TILE_WALL
    # Chamber interior: ornate pillars
    for px in [145, 155]:
        for py in range(2):
            chunk[108 + py][px] = TILE_WALL
    # Covenant altar wall
    for dy in range(2):
        for dx in range(2):
            chunk[113 + dy][148 + dx] = TILE_WALL

    # ===== Poison pools (积水墓地) =====
    fill_tiles(chunk, TILE_POISON, 12, 18, 20, 24)
    fill_tiles(chunk, TILE_POISON, 50, 28, 70, 35)

    # ===== Player spawn & bonfires =====
    entities.append(make_entity("PlayerSpawn", p(300), p(300), [make_field("heal", "Bool", False)]))
    entities.append(make_entity("Bonfire", p(300), p(300)))          # 幽邃教堂
    entities.append(make_entity("Bonfire", p(900), p(700)))          # 净身小教会
    entities.append(make_entity("Bonfire", p(2150), p(1850)))        # 主教群(击败后)
    entities.append(make_entity("Bonfire", p(3200), p(2400)))        # 罗莎莉亚寝室

    # ===== Boss: Deacons of the Deep =====
    entities.append(make_entity("BossSpawn", p(2150), p(1850)))

    # ===== Enemies from design doc (substituted to available EnemyKinds) =====
    for kind, dx, dy, count in [
        ("HollowSoldier", 400, 400, 2),       # DevoutHollow
        ("StarvedHound", 500, 450, 2),
        ("HollowSoldier", 650, 550, 1),       # DevoutHollow
        ("CathedralKnight", 800, 650, 1),
        ("Thrall", 900, 700, 2),              # HollowSlave
        ("Skeleton", 950, 750, 4),            # ReanimatedCorpse
        ("InfestedCorpse", 850, 800, 2),
        ("Evangelist", 1000, 700, 1),         # CathedralEvangelist
        ("Knight", 1100, 750, 1),             # CathedralGraveWarden
        ("CrystalLizard", 750, 700, 1),
        ("CrystalLizard", 1050, 850, 1),      # RavenousCrystalLizard
        ("PeasantHollow", 1200, 900, 1),      # WrithingRottenFlesh
        ("CathedralKnight", 1300, 950, 1),
        ("Thrall", 1500, 1000, 3),            # HollowSlave
        ("HollowSoldier", 1550, 1050, 3),     # DevoutHollow
        ("Evangelist", 1600, 1100, 1),        # CathedralEvangelist
        ("PeasantHollow", 1650, 1150, 3),     # CorpseGrub
        ("CathedralKnight", 1400, 1100, 1),
        ("Knight", 1450, 1050, 2),            # CathedralGraveWarden
        ("Knight", 1500, 1200, 1),            # GiantSlave
        ("Knight", 1600, 1300, 1),            # GiantSlave
        ("Darkwraith", 1550, 1250, 1),        # LongfingerKirk
        ("DeepAccursed", 1700, 1400, 1),
        ("CathedralKnight", 1800, 850, 1),
        ("Thrall", 1850, 900, 3),             # HollowSlave
        ("Evangelist", 1900, 950, 1),         # CathedralEvangelist
        ("PeasantHollow", 2000, 1500, 1),      # was Mimic (chest property, not enemy)
        ("HollowSoldier", 2000, 1700, 6),     # DevoutHollow
        ("Deacon", 2100, 1800, 8),
        ("ManGrub", 2600, 2100, 3),
        ("ManGrub", 2750, 2200, 3),
        ("PeasantHollow", 1350, 1350, 2),     # WrithingRottenFlesh
        ("CathedralKnight", 2500, 1700, 2),
    ]:
        for i in range(count):
            ox = (i * 24) % 48 - 24
            oy = (i * 18) % 36 - 18
            entities.append(make_entity("Enemy", p(dx) + ox, p(dy) + oy, [
                make_field("kind", "LocalEnum.EnemyKind", kind),
            ]))

    # ===== Items (key ones from design doc, using available ItemSpawnKinds) =====
    for kind, dx, dy, extra in [
        ("SoulOrb", 450, 380, [("value", "Int", 200)]),
        ("SoulOrb", 600, 500, [("value", "Int", 300)]),
        ("SoulOrb", 950, 800, [("value", "Int", 500)]),
        ("SoulOrb", 1500, 1050, [("value", "Int", 500)]),
        ("SoulOrb", 1800, 1400, [("value", "Int", 500)]),
        ("SoulOrb", 1900, 1350, [("value", "Int", 500)]),
        ("HomewardBone", 2850, 1550, []),
        ("TitaniteShard", 650, 550, [("name", "String", "楔形石碎片")]),
        ("TitaniteShard", 1350, 1150, [("name", "String", "楔形石碎片")]),
        ("TitaniteShard", 1200, 1050, [("name", "String", "楔形石碎片")]),
        ("TitaniteShard", 1550, 1200, [("name", "String", "大楔形石碎片")]),
        ("TitaniteShard", 1650, 1300, [("name", "String", "大楔形石碎片")]),
        ("TitaniteShard", 780, 720, [("name", "String", "光辉楔形石")]),
        ("TitaniteShard", 1080, 860, [("name", "String", "光辉楔形石")]),
        ("EstusShard", 900, 800, []),
        ("Consumable", 1750, 850, [("name", "String", "骨碎片")]),
        ("Consumable", 1100, 900, [("name", "String", "修理粉")]),
        ("Consumable", 1400, 1000, [("name", "String", "红色驱虫丸")]),
        ("Ember", 1600, 1100, []),
        ("Ember", 1700, 1400, []),
        ("Ember", 1850, 1250, []),
        ("Consumable", 1500, 1000, [("name", "String", "不死猎人魅惑")]),
        ("Consumable", 1950, 1300, [("name", "String", "决斗魅惑")]),
        ("Consumable", 1400, 1050, [("name", "String", "生锈硬币")]),
        ("Consumable", 1650, 1350, [("name", "String", "苍白舌头")]),
        ("Consumable", 1600, 1150, [("name", "String", "深邃变质石")]),
        ("PurpleMoss", 1500, 1050, []),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        for fname, ftype, fval in extra:
            fields.append(make_field(fname, ftype, fval))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    # ===== Chests (key ones from design doc) =====
    for dx, dy, lk, ln, mimic in [
        (400, 350, "Consumable", "骑士的骨灰", False),
        (550, 500, "Consumable", "纹章盾", False),
        (900, 800, "EstusShard", "", False),
        (1100, 850, "WeaponDrop", "亚斯特拉大剑", False),
        (1300, 1000, "WeaponDrop", "锯齿鞭", False),
        (1700, 1200, "RingDrop", "毒咬戒指", False),
        (2000, 1500, "Consumable", "深邃点字圣典", True),
        (2300, 900, "RingDrop", "深邃戒指", False),
        (2600, 1500, "ArmorDrop", "少女套装", False),
        (2700, 1400, "WeaponDrop", "多兰锤", False),
        (3200, 1700, "ArmorDrop", "大司祭套装", False),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", 0),
            make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    # ===== NPCs from design doc =====
    for name, kind, dx, dy, color, dialogue in [
        ("卡塔利纳的杰克巴尔多", "Dialogue", 1420, 1320, "#d4a840",
         "我被困在这个井里了……能帮帮我吗？|附近应该有机关可以打开井盖。"),
        ("不屈不挠的帕奇斯", "Dialogue", 1450, 1100, "#808080",
         "嘿你好啊！看那下面的宝物，闪闪发光！你不下去看看吗？"),
        ("罗莎莉亚", "Dialogue", 3100, 2300, "#d0a0b0",
         "你来……为指……服务吗？|给我苍白的舌头……作为誓约的证明。"),
        ("亚斯特拉的安里", "Dialogue", 2050, 1750, "#c0c0d0",
         "你是独自旅行吗？我也是。|前面是幽邃主教群，要小心。"),
        ("沉默的霍雷斯", "Dialogue", 2080, 1760, "#606060",
         "……我在这里等安里。|如果你见到了他，请告诉他我在这里。"),
        ("无光之地的希里斯", "Dialogue", 2050, 1720, "#a0a0c0",
         "你是灰烬吗？我叫希里斯。|如果你需要帮助，我可以协助你。"),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name),
            make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    # ===== Fog gates =====
    # 1. Return to RoadOfSacrifices (west side, vertical)
    entities.append(make_entity("FogGate", p(100), p(250), [
        make_field("dest_area", "String", "RoadOfSacrifices"),
        make_field("dest_x", "Float", 2100.0),
        make_field("dest_y", "Float", 800.0),
        make_field("width", "Float", 32.0),
        make_field("height", "Float", 200.0),
    ]))
    # 2. Boss fog gate — Deacons arena entrance (self-referential)
    # Corridor center: tile 90, y=75 → pixel (1440, 1200)
    entities.append(make_entity("FogGate", 1440, 1200, [
        make_field("dest_area", "String", "CathedralDeep"),
        make_field("dest_x", "Float", float(p(2150))),
        make_field("dest_y", "Float", float(p(1850))),
        make_field("width", "Float", 80.0),
        make_field("height", "Float", 32.0),
    ]))
    # 3. To Irithyll (after Rosaria's area, east edge)
    entities.append(make_entity("FogGate", p(3200), p(2400), [
        make_field("dest_area", "String", "Irithyll"),
        make_field("dest_x", "Float", 200.0),
        make_field("dest_y", "Float", 400.0),
        make_field("width", "Float", 32.0),
        make_field("height", "Float", 200.0),
    ]))

    # ===== Lights =====
    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 400, 180, 0.8, 0.7, 0.5, 0.6),
        (1500, 1200, 180, 0.8, 0.7, 0.5, 0.6),
        (3200, 2400, 180, 0.6, 0.4, 0.7, 0.5),
        (1300, 1000, 100, 0.5, 0.3, 0.6, 0.4),
        (2150, 1850, 250, 0.4, 0.2, 0.7, 0.6),
        (700, 600, 120, 0.5, 0.5, 0.4, 0.3),
        (3100, 2300, 150, 0.7, 0.5, 0.7, 0.5),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    return chunk, entities

def make_irithyll():
    chunk = new_chunk()
    entities = []

    # Design doc: 3100×2100
    # Scale to fit 2560×2560: S=0.8
    S = 0.8
    def t(v): return max(0, min(CHUNK_SIZE - 1, int(v * S) // 16))
    def p(v): return int(v * S)

    # ===== Terrain: 11 sections from Irithyll.json =====
    # 1. 冰桥入口: (0,200)+(400,400)
    fill_tiles(chunk, TILE_GROUND, t(0), t(200), t(400), t(600))
    # 2. 城市下街: (300,300)+(500,400)
    fill_tiles(chunk, TILE_GROUND, t(300), t(300), t(800), t(700))
    # 3. 中央伊鲁席尔: (500,500)+(400,350)
    fill_tiles(chunk, TILE_GROUND, t(500), t(500), t(900), t(850))
    # 4. 中央广场: (700,500)+(500,500)
    fill_tiles(chunk, TILE_GROUND, t(700), t(500), t(1200), t(1000))
    # 5. 幽儿希卡教会: (1000,600)+(400,400)
    fill_tiles(chunk, TILE_GROUND, t(1000), t(600), t(1400), t(1000))
    # 6. 水边小径: (1400,400)+(600,400)
    fill_tiles(chunk, TILE_GROUND, t(1400), t(400), t(2000), t(800))
    # 7. 地下水道: (800,1100)+(500,350)
    fill_tiles(chunk, TILE_GROUND, t(800), t(1100), t(1300), t(1450))
    # 8. 离街废屋: (1800,400)+(400,400)
    fill_tiles(chunk, TILE_GROUND, t(1800), t(400), t(2200), t(800))
    # 9. 教宗骑士大道: (1600,1000)+(600,500)
    fill_tiles(chunk, TILE_GROUND, t(1600), t(1000), t(2200), t(1500))
    # 10. 银骑士阶梯: (200,900)+(400,500)
    fill_tiles(chunk, TILE_GROUND, t(200), t(900), t(600), t(1400))
    # 11. 沙力万大教堂 (boss): (2300,1500)+(800,600)
    fill_tiles(chunk, TILE_GROUND, t(2300), t(1500), t(3100), t(2100))

    # ===== Corridors =====
    # Section 4 → 7 (中央广场 → 地下水道)
    fill_tiles(chunk, TILE_GROUND, 50, 50, 55, 55)
    # Section 8 → 9 (离街废屋 → 教宗骑士大道)
    fill_tiles(chunk, TILE_GROUND, 95, 40, 100, 50)
    # Section 2 → 10 (城市下街 → 银骑士阶梯)
    fill_tiles(chunk, TILE_GROUND, 15, 35, 20, 45)
    # Section 9 → 11 (教宗骑士大道 → boss arena)
    fill_tiles(chunk, TILE_GROUND, 110, 75, 115, 80)
    # Extend corridor through west wall gap into arena
    fill_tiles(chunk, TILE_GROUND, 115, 76, 120, 80)

    # ===== Detailed wall structures — Irithyll frozen city =====

    # --- 冰桥入口 (tiles 0-20, 10-30): bridge railing walls ---
    # Bridge is narrow, walls on north and south edges with gaps
    for x in range(0, 21):
        if x < 4 or x > 6:           # entrance gap at west
            chunk[10][x] = TILE_WALL
        if x < 4 or x > 6:
            chunk[30][x] = TILE_WALL
    # Bridge side walls (north/south faces)
    for y in range(10, 18):
        chunk[y][0] = TILE_WALL
    for y in range(22, 31):
        chunk[y][0] = TILE_WALL

    # --- 城市下街 (tiles 15-40, 15-35): dense stone buildings & narrow alleys ---
    # Building 1: NW block (tiles 17-22, 17-22)
    fill_tiles(chunk, TILE_WALL, 17, 17, 22, 17)
    fill_tiles(chunk, TILE_WALL, 17, 17, 17, 22)
    fill_tiles(chunk, TILE_WALL, 22, 17, 22, 22)
    fill_tiles(chunk, TILE_WALL, 17, 22, 22, 22)
    # Interior (ground) — leave hollow
    fill_tiles(chunk, TILE_GROUND, 18, 18, 21, 21)
    # Building 2: NE block (tiles 33-38, 17-22) — narrow alley between bldg 1 & 2
    fill_tiles(chunk, TILE_WALL, 33, 17, 38, 17)
    fill_tiles(chunk, TILE_WALL, 33, 17, 33, 22)
    fill_tiles(chunk, TILE_WALL, 38, 17, 38, 22)
    fill_tiles(chunk, TILE_WALL, 33, 22, 38, 22)
    fill_tiles(chunk, TILE_GROUND, 34, 18, 37, 21)
    # Building 3: SW block (tiles 20-25, 28-33)
    fill_tiles(chunk, TILE_WALL, 20, 28, 25, 28)
    fill_tiles(chunk, TILE_WALL, 20, 28, 20, 33)
    fill_tiles(chunk, TILE_WALL, 25, 28, 25, 33)
    fill_tiles(chunk, TILE_WALL, 20, 33, 25, 33)
    fill_tiles(chunk, TILE_GROUND, 21, 29, 24, 32)
    # Building 4: SE block (tiles 35-39, 29-33)
    fill_tiles(chunk, TILE_WALL, 35, 29, 39, 29)
    fill_tiles(chunk, TILE_WALL, 35, 29, 35, 33)
    fill_tiles(chunk, TILE_WALL, 39, 29, 39, 33)
    fill_tiles(chunk, TILE_WALL, 35, 33, 39, 33)
    fill_tiles(chunk, TILE_GROUND, 36, 30, 38, 32)

    # --- 中央伊鲁席尔 (tiles 25-45, 25-42): dense alleyways, patrol routes ---
    # Pillar row along center avenue (east-west spine at y=33)
    for x in range(26, 45, 3):
        chunk[33][x] = TILE_WALL
    # Building 5: NW corner (tiles 26-30, 26-30)
    fill_tiles(chunk, TILE_WALL, 26, 26, 30, 26)
    fill_tiles(chunk, TILE_WALL, 26, 26, 26, 30)
    fill_tiles(chunk, TILE_WALL, 30, 26, 30, 30)
    fill_tiles(chunk, TILE_WALL, 26, 30, 30, 30)
    fill_tiles(chunk, TILE_GROUND, 27, 27, 29, 29)
    # Building 6: NE corner (tiles 39-44, 26-30)
    fill_tiles(chunk, TILE_WALL, 39, 26, 44, 26)
    fill_tiles(chunk, TILE_WALL, 39, 26, 39, 30)
    fill_tiles(chunk, TILE_WALL, 44, 26, 44, 30)
    fill_tiles(chunk, TILE_WALL, 39, 30, 44, 30)
    fill_tiles(chunk, TILE_GROUND, 40, 27, 43, 29)
    # Building 7: south side (tiles 30-35, 37-41)
    fill_tiles(chunk, TILE_WALL, 30, 37, 35, 37)
    fill_tiles(chunk, TILE_WALL, 30, 37, 30, 41)
    fill_tiles(chunk, TILE_WALL, 35, 37, 35, 41)
    fill_tiles(chunk, TILE_WALL, 30, 41, 35, 41)
    fill_tiles(chunk, TILE_GROUND, 31, 38, 34, 40)

    # --- 中央广场 (tiles 35-60, 25-50): gothic buildings, frozen fountain ---
    # Frozen fountain (center of plaza at tiles 47-49, 37-39)
    fill_tiles(chunk, TILE_WALL, 47, 37, 49, 37)
    fill_tiles(chunk, TILE_WALL, 47, 39, 49, 39)
    fill_tiles(chunk, TILE_WALL, 47, 37, 47, 39)
    fill_tiles(chunk, TILE_WALL, 49, 37, 49, 39)
    # North building row (tiles 36-59, 25-28) with entrance gaps
    for x in range(36, 60):
        if x < 41 or x > 43:           # central entrance gap
            chunk[25][x] = TILE_WALL
    for y in range(25, 29):
        chunk[y][36] = TILE_WALL
        chunk[y][59] = TILE_WALL
    # South building row (tiles 38-58, 47-50) with gaps
    for x in range(38, 59):
        if x < 44 or x > 46:
            chunk[50][x] = TILE_WALL
    for y in range(47, 51):
        chunk[y][38] = TILE_WALL
        chunk[y][58] = TILE_WALL
    # Side pillars along plaza edges
    for y in range(27, 48, 4):
        chunk[y][36] = TILE_WALL
    for y in range(27, 48, 4):
        chunk[y][59] = TILE_WALL

    # --- 幽儿希卡教会 (tiles 50-70, 30-50): church with stained glass ---
    # Church outer walls (tiles 52-68, 32-48)
    for x in range(52, 69):
        if x < 58 or x > 62:           # front entrance gap
            chunk[32][x] = TILE_WALL
    for x in range(52, 69):
        chunk[48][x] = TILE_WALL       # back wall
    for y in range(32, 49):
        chunk[y][52] = TILE_WALL       # west wall
    for y in range(32, 49):
        if y < 38 or y > 42:           # side door gap
            chunk[y][68] = TILE_WALL   # east wall
    # Interior pillars (4 pillars inside church)
    for px, py in [(55, 36), (55, 44), (65, 36), (65, 44)]:
        chunk[py][px] = TILE_WALL
    # Altar at back
    fill_tiles(chunk, TILE_WALL, 58, 46, 62, 47)
    # Leave interior walkable
    fill_tiles(chunk, TILE_GROUND, 53, 33, 67, 45)

    # --- 水边小径 (tiles 70-100, 20-40): canal-side path with high balconies ---
    # North row of buildings (balconies for Fire Witches, tiles 72-98, 20-23)
    for x in range(72, 99):
        if x < 77 or x > 79:           # alley gap
            chunk[20][x] = TILE_WALL
    for x in range(72, 99):
        if x < 85 or x > 87:           # alley gap
            chunk[23][x] = TILE_WALL
    # South canal wall (frozen canal edge, tiles 70-100, y=40)
    for x in range(70, 101):
        chunk[40][x] = TILE_WALL
    # Canal crossing pillars
    for x in [80, 90]:
        for y in range(35, 40):
            chunk[y][x] = TILE_WALL

    # --- 地下水道 (tiles 40-65, 55-72): dark sewer with hidden passages ---
    # Sewer tunnel walls — narrow channels
    # North wall of sewer
    for x in range(40, 66):
        if x < 48 or x > 50:           # entrance from above
            chunk[55][x] = TILE_WALL
    # South wall
    for x in range(40, 66):
        if x < 58 or x > 60:           # exit to IrithyllDungeon
            chunk[72][x] = TILE_WALL
    # Central sewer pillars
    for x in [45, 55, 62]:
        for y in [60, 66]:
            chunk[y][x] = TILE_WALL
    # Side alcove walls (hidden corners)
    fill_tiles(chunk, TILE_WALL, 40, 55, 42, 57)
    fill_tiles(chunk, TILE_WALL, 63, 69, 65, 72)

    # --- 离街废屋 (tiles 90-110, 20-40): manor building ---
    # Manor outer walls (tiles 92-108, 22-38)
    for x in range(92, 109):
        if x < 97 or x > 99:           # front entrance
            chunk[22][x] = TILE_WALL
    for x in range(92, 109):
        chunk[38][x] = TILE_WALL
    for y in range(22, 39):
        chunk[y][92] = TILE_WALL
    for y in range(22, 39):
        if y < 28 or y > 32:           # side door to IrithyllDungeon
            chunk[y][108] = TILE_WALL
    # Manor interior partition (kitchen wall, gap at y=28-30)
    for y in range(24, 37):
        if y < 28 or y > 30:
            chunk[y][100] = TILE_WALL
    fill_tiles(chunk, TILE_GROUND, 93, 23, 99, 37)
    fill_tiles(chunk, TILE_GROUND, 101, 23, 107, 37)

    # --- 教宗骑士大道 (tiles 80-110, 50-75): grand avenue with stone pillars ---
    # Pillar-lined avenue — rows of pillars on both sides
    for y in range(52, 74, 3):
        chunk[y][80] = TILE_WALL       # west pillars
    for y in range(52, 74, 3):
        chunk[y][110] = TILE_WALL      # east pillars
    # Central pillars (decorative, Pontiff knight patrol route markers)
    for x in [85, 92, 99, 106]:
        chunk[60][x] = TILE_WALL
        chunk[68][x] = TILE_WALL
    # Stone bridge over chasm (tiles 95-105, y=65)
    for x in range(90, 106):
        if x < 96 or x > 100:          # bridge railings
            chunk[64][x] = TILE_WALL
            chunk[67][x] = TILE_WALL

    # --- 银骑士阶梯 (tiles 10-30, 45-70): stone staircase with silver knights ---
    # Staircase side walls (left and right)
    # West wall: leave gap at y=53-57 for AnorLondo exit fog gate at tile (10,55)
    for y in range(45, 71):
        if y < 53 or y > 57:
            chunk[y][10] = TILE_WALL
    # East wall with mid-staircase alcove gap
    for y in range(45, 71):
        if y < 55 or y > 58:
            chunk[y][30] = TILE_WALL
    # Decorative statues at intervals
    for y in [48, 53, 63, 68]:
        chunk[y][13] = TILE_WALL       # left-side statues
    # Upper landing wall with gap for entry from above
    for x in range(10, 31):
        if x < 14 or x > 18:           # entry gap from corridor above
            chunk[45][x] = TILE_WALL
    # AnorLondo exit: ensure ground tiles reach the west edge gap
    fill_tiles(chunk, TILE_GROUND, 9, 53, 11, 57)

    # --- Corridor connections (ensure critical paths open) ---
    # Re-open corridors that buildings may have blocked
    fill_tiles(chunk, TILE_GROUND, 14, 20, 17, 20)   # spawn area to lower street
    fill_tiles(chunk, TILE_GROUND, 23, 33, 25, 33)   # lower street to central Irithyll
    fill_tiles(chunk, TILE_GROUND, 44, 33, 50, 33)   # central to plaza
    fill_tiles(chunk, TILE_GROUND, 60, 35, 70, 35)   # plaza to church area
    fill_tiles(chunk, TILE_GROUND, 70, 30, 80, 40)   # church to waterside path
    fill_tiles(chunk, TILE_GROUND, 100, 40, 105, 50)  # waterside to Pontiff avenue
    fill_tiles(chunk, TILE_GROUND, 95, 40, 100, 42)   # manor to Pontiff avenue
    fill_tiles(chunk, TILE_GROUND, 14, 38, 18, 46)    # lower street to silver knight stairs
    fill_tiles(chunk, TILE_GROUND, 50, 50, 55, 55)    # plaza area to sewer entrance
    fill_tiles(chunk, TILE_GROUND, 95, 40, 100, 50)   # ensure manor connects down
    # Critical: avenue to boss arena — wide corridor
    fill_tiles(chunk, TILE_GROUND, 108, 73, 122, 97)  # wide path from avenue into arena entrance

    # ===== Boss arena walls (section 11: tiles 115..155, 75..105) =====
    # Grand cathedral walls
    for x in range(115, 156):
        if x < 118 or x > 132:         # wide entrance gap for corridor
            chunk[75][x] = TILE_WALL
    # West wall with wide entrance gap (corridor enters from NW)
    for y in range(75, 106):
        if y < 78 or y > 97:           # wide entrance gap y=78-97
            chunk[y][115] = TILE_WALL
    # East wall
    for y in range(75, 106):
        chunk[y][155] = TILE_WALL
    # South wall
    for x in range(115, 156):
        chunk[105][x] = TILE_WALL
    # Cathedral interior pillars (4 grand columns)
    for px, py in [(125, 85), (125, 95), (145, 85), (145, 95)]:
        chunk[py][px] = TILE_WALL
    # Altar at far end
    fill_tiles(chunk, TILE_WALL, 132, 100, 138, 103)
    # Arena floor (re-apply ground after walls)
    fill_tiles(chunk, TILE_GROUND, 116, 76, 154, 104)
    # Entrance corridor (re-open after arena walls applied)
    fill_tiles(chunk, TILE_GROUND, 108, 76, 118, 97)   # avenue connects into arena
    # Restore interior pillars over floor
    for px, py in [(125, 85), (125, 95), (145, 85), (145, 95)]:
        chunk[py][px] = TILE_WALL

    # ===== Poison (地下水道) =====
    fill_tiles(chunk, TILE_POISON, 50, 60, 60, 70)
    fill_tiles(chunk, TILE_POISON, 60, 65, 70, 72)

    # ===== Player spawn & bonfires =====
    entities.append(make_entity("PlayerSpawn", p(300), p(400), [make_field("heal", "Bool", False)]))
    entities.append(make_entity("Bonfire", p(300), p(400)))          # 冷冽谷的伊鲁席尔
    entities.append(make_entity("Bonfire", p(1200), p(800)))         # 幽儿希卡教会
    entities.append(make_entity("Bonfire", p(1800), p(600)))         # 离街废屋
    entities.append(make_entity("Bonfire", p(2600), p(1800)))        # 教宗沙力万

    # ===== Boss: Pontiff Sulyvahn =====
    entities.append(make_entity("BossSpawn", p(2700), p(1800)))

    # ===== Enemies =====
    for kind, dx, dy, count in [
        ("Dog", 200, 350, 1),               # SulyvahnsBeast
        ("HollowSoldier", 400, 380, 2),     # IrithyllSlave
        ("CrystalLizard", 350, 380, 1),
        ("HollowSoldier", 550, 450, 1),     # IrithyllSlave
        ("HollowSoldier", 650, 500, 2),     # IrithyllSlave
        ("Knight", 800, 650, 2),            # PontiffKnight
        ("HollowSoldier", 950, 700, 2),     # IrithyllSlave
        ("DarkMage", 1500, 500, 1),         # FireWitch
        ("HollowSoldier", 1400, 550, 2),    # IrithyllSlave
        ("DarkMage", 1700, 600, 1),         # FireWitch
        ("Knight", 1750, 1200, 2),          # PontiffKnight
        ("DarkMage", 1900, 1050, 1),        # FireWitch
        ("HollowSoldier", 1850, 1300, 2),   # IrithyllSlave
        ("SilverKnight", 350, 1050, 1),
        ("SilverKnight", 400, 1200, 1),
        ("Dog", 450, 420, 2),               # IrithyllianBeasthound
        ("Dog", 700, 600, 2),               # IrithyllianBeasthound
        ("Knight", 600, 620, 1),            # PontiffKnight
        ("Dog", 850, 750, 2),               # IrithyllianBeasthound
        ("Knight", 1650, 950, 1),           # GiantSlave
        ("PeasantHollow", 900, 1200, 1),    # SewerCentipede
        ("PeasantHollow", 1050, 1300, 1),   # SewerCentipede
        ("PeasantHollow", 1200, 1250, 1),   # SewerCentipede
        ("CrystalLizard", 1150, 850, 1),
        ("CrystalLizard", 2100, 1350, 1),
        ("HollowSoldier", 1600, 1100, 3),   # IrithyllSlave
    ]:
        for i in range(count):
            ox = (i * 24) % 48 - 24
            oy = (i * 18) % 36 - 18
            entities.append(make_entity("Enemy", p(dx) + ox, p(dy) + oy, [
                make_field("kind", "LocalEnum.EnemyKind", kind),
            ]))

    # ===== Items =====
    for kind, dx, dy, extra in [
        ("SoulOrb", 400, 380, [("value", "Int", 500)]),
        ("SoulOrb", 600, 500, [("value", "Int", 500)]),
        ("SoulOrb", 950, 700, [("value", "Int", 800)]),
        ("HomewardBone", 500, 500, []),
        ("SoulOrb", 250, 400, [("value", "Int", 800)]),
        ("EstusShard", 700, 1000, []),
        ("TitaniteShard", 800, 650, [("name", "String", "楔形石碎片")]),
        ("Ember", 1000, 850, []),
        ("Ember", 1600, 1100, []),
        ("PurpleMoss", 300, 450, []),
        ("SoulOrb", 1200, 800, [("value", "Int", 500)]),
        ("HomewardBone", 300, 950, []),
        ("Consumable", 600, 650, [("name", "String", "决斗魅惑")]),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        for fname, ftype, fval in extra:
            fields.append(make_field(fname, ftype, fval))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    # ===== Chests =====
    for dx, dy, lk, ln, mimic in [
        (350, 400, "RingDrop", "深邃戒指", False),
        (550, 550, "EstusShard", "", False),
        (850, 600, "RingDrop", "太阳公主戒指", False),
        (1050, 900, "ArmorDrop", "教宗骑士套装", False),
        (250, 1050, "RingDrop", "银猫戒指", False),
        (750, 1250, "RingDrop", "魔力庇护戒指", False),
        (900, 600, "ArmorDrop", "黄铜套装", True),
        (1150, 850, "WeaponDrop", "教宗骑士曲剑", False),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", 0),
            make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    # ===== NPCs =====
    for name, kind, dx, dy, color, dialogue in [
        ("亚斯特拉的安里", "Dialogue", 1180, 820, "#c0c0c0",
         "你来了……我们又见面了。|我一直在寻找霍拉斯……沙力万就在前方的大教堂中。"),
        ("卡塔利纳的杰克巴尔多", "Dialogue", 1850, 650, "#d4a520",
         "哦！是你啊！我一路追寻老友的踪迹来到了这座冰城。|这间庄园的厨房不错，我正在煮一锅好汤。"),
        ("无光之地的希里斯", "Dialogue", 320, 420, "#b0c0d0",
         "灰烬大人……我是希莉丝，无日之国的骑士。|教宗沙力万……就让我与你一同面对他吧。"),
        ("骑士团长幽儿希卡", "Dialogue", 1250, 500, "#c0c0e0",
         "……你是灰烬大人吗？|我是幽儿希卡，暗月骑士团的团长。|如果你愿意效忠暗月，我会赐予你力量。"),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name),
            make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    # ===== Fog gates =====
    # 1. Return to CatacombsOfCarthus (west side)
    entities.append(make_entity("FogGate", p(100), p(250), [
        make_field("dest_area", "String", "CatacombsOfCarthus"),
        make_field("dest_x", "Float", 2400.0),
        make_field("dest_y", "Float", 1800.0),
        make_field("width", "Float", 32.0),
        make_field("height", "Float", 200.0),
    ]))
    # 2. To AnorLondo (from 银骑士阶梯, south)
    entities.append(make_entity("FogGate", p(200), p(1100), [
        make_field("dest_area", "String", "AnorLondo"),
        make_field("dest_x", "Float", 100.0),
        make_field("dest_y", "Float", 400.0),
        make_field("width", "Float", 200.0),
        make_field("height", "Float", 32.0),
    ]))
    # 3. To IrithyllDungeon (from 离街废屋)
    entities.append(make_entity("FogGate", p(1900), p(750), [
        make_field("dest_area", "String", "IrithyllDungeon"),
        make_field("dest_x", "Float", 100.0),
        make_field("dest_y", "Float", 200.0),
        make_field("width", "Float", 32.0),
        make_field("height", "Float", 200.0),
    ]))
    # 4. Boss fog gate (self-referential)
    # Boss arena entrance: tiles 125-130 at y=75, center = pixel (2032, 1200)
    entities.append(make_entity("FogGate", 2032, 1200, [
        make_field("dest_area", "String", "Irithyll"),
        make_field("dest_x", "Float", float(p(2700))),
        make_field("dest_y", "Float", float(p(1800))),
        make_field("width", "Float", 80.0),
        make_field("height", "Float", 32.0),
    ]))
    # 5. To IrithyllDungeon (from 地下水道)
    entities.append(make_entity("FogGate", p(1300), p(1350), [
        make_field("dest_area", "String", "IrithyllDungeon"),
        make_field("dest_x", "Float", 300.0),
        make_field("dest_y", "Float", 800.0),
        make_field("width", "Float", 32.0),
        make_field("height", "Float", 200.0),
    ]))

    # ===== Lights =====
    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 400, 200, 0.6, 0.7, 1.0, 0.6),
        (1200, 800, 180, 0.6, 0.7, 1.0, 0.6),
        (1800, 600, 180, 0.6, 0.7, 1.0, 0.6),
        (1500, 500, 100, 1.0, 0.6, 0.2, 0.5),
        (2600, 1800, 180, 0.6, 0.7, 1.0, 0.6),
        (600, 400, 300, 0.8, 0.85, 1.0, 0.5),
        (750, 650, 150, 0.6, 0.7, 1.0, 0.4),
        (1650, 950, 120, 1.0, 0.6, 0.2, 0.4),
        (1000, 1200, 60, 0.3, 0.4, 0.5, 0.2),
        (350, 1050, 100, 0.7, 0.8, 1.0, 0.3),
        (2700, 1800, 200, 0.5, 0.3, 0.8, 0.5),
        (2100, 1350, 80, 0.6, 0.7, 1.0, 0.3),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    return chunk, entities

def make_road_of_sacrifices():
    S = 0.8
    chunk = new_chunk()
    def t(v): return max(0, min(159, int(v * S) // 16))
    def p(v): return int(v * S)

    # --- Terrain from design doc ---
    # Section 1: 入口密林 (x=0,y=0,w=800,h=800)
    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(800), t(800))
    # Section 2: 半道要塞 (x=1000,y=500,w=500,h=500)
    fill_tiles(chunk, TILE_GROUND, t(1000), t(500), t(1500), t(1000))
    # Section 3: 磔罪森林 (x=1700,y=300,w=600,h=500)
    fill_tiles(chunk, TILE_GROUND, t(1700), t(300), t(2300), t(800))
    # Section 4: 鸦人森林 (x=2200,y=800,w=600,h=600)
    fill_tiles(chunk, TILE_GROUND, t(2200), t(800), t(2800), t(1400))
    # Section 5: 结晶洞穴 (x=2300,y=1200,w=800,h=600)
    fill_tiles(chunk, TILE_GROUND, t(2300), t(1200), t(3100), t(1800))

    # --- Corridors ---
    fill_tiles(chunk, TILE_GROUND, t(800), t(400), t(1000), t(500))   # 1→2
    fill_tiles(chunk, TILE_GROUND, t(1500), t(400), t(1700), t(500))  # 2→3

    # --- Boss arena walls (Crystal Sage) ---
    fill_tiles(chunk, TILE_WALL, 120, 86, 150, 86)     # south
    fill_tiles(chunk, TILE_WALL, 119, 64, 119, 86)     # west
    fill_tiles(chunk, TILE_WALL, 151, 64, 151, 86)     # east
    fill_tiles(chunk, TILE_WALL, 120, 64, 124, 64)     # north-left
    fill_tiles(chunk, TILE_WALL, 131, 64, 150, 64)     # north-right (gap 125..130)

    # --- Detailed wall structures ---

    # 1) 入口密林: Tree clusters (root obstacles) flanking the path
    #    Narrow path runs roughly x=10..20, y=0..40 through sec1
    #    Left tree cluster
    for y in range(2, 18):
        for x in range(1, 8):
            chunk[y][x] = TILE_WALL
    for y in range(22, 38):
        for x in range(1, 10):
            chunk[y][x] = TILE_WALL
    #    Right tree cluster
    for y in range(2, 15):
        for x in range(24, 35):
            chunk[y][x] = TILE_WALL
    for y in range(18, 35):
        for x in range(22, 38):
            chunk[y][x] = TILE_WALL
    #    Scattered root obstacles along the path
    for wx, wy in [(7, 5), (8, 5), (18, 8), (19, 8), (12, 14), (13, 14), (6, 25), (7, 25), (20, 28), (21, 28)]:
        chunk[wy][wx] = TILE_WALL

    # 2) Narrow forest corridor between sec1 and sec2 (tree walls)
    fill_tiles(chunk, TILE_WALL, 40, 15, 50, 18)   # top wall of corridor
    fill_tiles(chunk, TILE_WALL, 40, 27, 50, 30)   # bottom wall of corridor

    # 3) 半道要塞: Stone fortress walls (partial ruins)
    #    North wall of fortress with gap (gap 63..67 for entry, plus 72..75 for corridor access)
    fill_tiles(chunk, TILE_WALL, 52, 25, 62, 25)   # north wall left
    fill_tiles(chunk, TILE_WALL, 68, 25, 71, 25)   # north wall middle
    #    South wall fragments
    fill_tiles(chunk, TILE_WALL, 52, 48, 58, 48)
    fill_tiles(chunk, TILE_WALL, 65, 48, 74, 48)
    #    East wall fragment (shortened to not block corridor entry)
    fill_tiles(chunk, TILE_WALL, 74, 30, 74, 40)
    #    Interior wall fragment (ruined room)
    fill_tiles(chunk, TILE_WALL, 58, 32, 58, 38)
    fill_tiles(chunk, TILE_WALL, 58, 38, 63, 38)
    #    Interior column ruins
    chunk[30][60] = TILE_WALL
    chunk[30][61] = TILE_WALL
    chunk[44][65] = TILE_WALL
    chunk[44][66] = TILE_WALL

    # 4) Narrow forest corridor between sec2 and sec3
    fill_tiles(chunk, TILE_WALL, 75, 15, 85, 19)
    fill_tiles(chunk, TILE_WALL, 75, 27, 85, 30)

    # 5) 磔罪森林: Tree clusters and root obstacles around the poison pools
    #    Large tree cluster top-left of sec3
    for y in range(16, 22):
        for x in range(86, 92):
            chunk[y][x] = TILE_WALL
    #    Tree cluster right side
    for y in range(18, 25):
        for x in range(108, 115):
            chunk[y][x] = TILE_WALL
    #    Scattered trees in the forest
    for wx, wy in [(95, 18), (96, 18), (100, 22), (101, 22), (90, 28), (91, 28),
                   (105, 32), (106, 32), (95, 35), (96, 35), (110, 26), (111, 26),
                   (88, 38), (89, 38), (102, 37), (103, 37)]:
        chunk[wy][wx] = TILE_WALL
    #    Overgrown ruin fragments (low walls)
    fill_tiles(chunk, TILE_WALL, 92, 22, 92, 25)
    fill_tiles(chunk, TILE_WALL, 98, 28, 98, 32)

    # 6) Connection corridor sec3 → sec4 (鸦人森林): forest narrows
    #    Path through overlap at x=110..115, y=38..43 must stay open
    fill_tiles(chunk, TILE_WALL, 112, 35, 115, 37)   # top narrows (keep x=110,111 open)
    fill_tiles(chunk, TILE_WALL, 112, 44, 115, 45)   # bottom narrows (keep x=110,111 open)

    # 7) 鸦人森林: Dense tree clusters creating winding paths
    #    Top-left cluster
    for y in range(42, 48):
        for x in range(112, 118):
            chunk[y][x] = TILE_WALL
    #    Center cluster
    for y in range(52, 57):
        for x in range(120, 127):
            chunk[y][x] = TILE_WALL
    #    Scattered tree obstacles (avoid blocking right side path to FarronKeep gate)
    for wx, wy in [(125, 42), (126, 42), (130, 48), (131, 48), (118, 56), (119, 56),
                   (115, 62), (116, 62), (128, 60), (129, 60),
                   (122, 66), (123, 66), (132, 50), (133, 50)]:
        chunk[wy][wx] = TILE_WALL
    #    Tree line along top edge (keep path open at y=40..41)
    fill_tiles(chunk, TILE_WALL, 118, 40, 130, 40)

    # 8) Connection sec4 → sec5 (结晶洞穴): rocky narrows
    fill_tiles(chunk, TILE_WALL, 115, 56, 118, 59)
    fill_tiles(chunk, TILE_WALL, 115, 64, 118, 64)

    # 9) 结晶洞穴: Crystal obstacles inside arena + approach
    #    Crystal pillars scattered in the arena
    for wx, wy in [(125, 70), (126, 70), (135, 72), (136, 72),
                   (130, 78), (131, 78), (140, 80), (141, 80),
                   (122, 84), (123, 84), (133, 85), (134, 85),
                   (145, 75), (146, 75), (138, 88), (139, 88)]:
        chunk[wy][wx] = TILE_WALL
    #    Rocky outcrop near entrance
    fill_tiles(chunk, TILE_WALL, 117, 62, 117, 65)

    # --- Poison pools (水洼 in 磔罪森林) ---
    for y in range(t(450), t(600)):
        for x in range(t(1800), t(2100)):
            chunk[y][x] = TILE_POISON

    entities = []

    # --- Player spawn & bonfires ---
    entities.append(make_entity("PlayerSpawn", p(300), p(400), [make_field("heal", "Bool", False)]))
    for bx, by in [(300, 400), (1200, 700), (2000, 500), (2600, 1400)]:
        entities.append(make_entity("Bonfire", p(bx), p(by)))

    # --- Boss spawn ---
    entities.append(make_entity("BossSpawn", p(2700), p(1500)))

    # --- Enemies ---
    # 入口密林
    for kind, dx, dy in [
        ("Assassin", 450, 350), ("Assassin", 480, 380),
        ("Assassin", 650, 500),
        ("DarkMage", 550, 300),
        ("WingedKnight", 900, 650), ("WingedKnight", 860, 620),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))
    # 半道要塞
    for kind, dx, dy in [
        ("Assassin", 1150, 600),
        ("Assassin", 1500, 750), ("Assassin", 1450, 700), ("Assassin", 1400, 780),
        ("PeasantHollow", 1350, 450),
        ("CrystalLizard", 1050, 650),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))
    # 磔罪森林
    for kind, dx, dy in [
        ("Wretch", 1600, 400), ("Wretch", 1650, 430),
        ("Assassin", 1900, 450), ("Assassin", 1950, 480),
        ("Dog", 1950, 550), ("Dog", 1980, 520),
        ("CathedralKnight", 1900, 600),
        ("CathedralKnight", 2000, 550),
        ("Darkwraith", 1700, 500),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))
    # 鸦人森林
    for kind, dx, dy in [
        ("BlackKnight", 2100, 900),
        ("Assassin", 2400, 1000), ("Assassin", 2450, 1030),
        ("Ghru", 2200, 900), ("Ghru", 2250, 930), ("Ghru", 2300, 870),
        ("CrystalLizard", 2350, 900),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))
    # 结晶洞穴
    for kind, dx, dy in [
        ("Basilisk", 2300, 1300), ("Basilisk", 2400, 1350), ("Basilisk", 2500, 1280),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))

    # --- Items ---
    for kind, dx, dy, val in [
        ("SoulOrb", 450, 380, 300),
        ("SoulOrb", 1400, 600, 500),
        ("SoulOrb", 1300, 500, 800),
        ("HomewardBone", 1800, 500, 0),
        ("HomewardBone", 2400, 950, 0),
        ("PurpleMoss", 2200, 950, 0),
        ("PurpleMoss", 1800, 550, 0),
        ("EstusShard", 1100, 500, 0),
        ("TitaniteShard", 600, 450, 0),
        ("TitaniteShard", 2150, 950, 0),
        ("Firebomb", 650, 550, 0),
        ("Consumable", 2050, 480, 0),
        ("Consumable", 1700, 550, 0),
        ("Consumable", 2450, 1050, 0),
        ("Consumable", 2500, 1000, 0),
        ("Consumable", 2500, 1100, 0),
        ("UndeadBoneShard", 1750, 400, 0),
        ("RingDrop", 2100, 1000, 0),
        ("RingDrop", 1600, 450, 0),
        ("RingDrop", 1850, 500, 0),
        ("WeaponDrop", 500, 450, 0),
        ("ArmorDrop", 1450, 700, 0),
        ("WeaponDrop", 2350, 1050, 0),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb": fields.append(make_field("value", "Int", val))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    # --- Chests ---
    for lk, lv, ln, dx, dy, mimic in [
        ("WeaponDrop", 0, "Grass Crest Shield", 850, 550, False),
        ("EstusShard", 0, "", 1100, 750, False),
        ("WeaponDrop", 0, "Bandit Axe", 1300, 400, False),
        ("RingDrop", 0, "Sacrifice Ring", 1800, 350, False),
        ("RingDrop", 0, "Morne's Ring", 2350, 1150, False),
        ("WeaponDrop", 0, "Heretic's Staff", 2500, 950, False),
        ("ArmorDrop", 0, "Brigand Set", 2100, 800, False),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv), make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    # --- NPCs ---
    for name, color, dialogue, kind, dx, dy in [
        ("亚斯特拉的安里", "#c0c0c0",
         "你好，我叫安里。这位是我的同伴霍拉斯。我们为了寻找深渊监视者而踏上了旅途。前方有两条路——左边通往法兰要塞，右边通往幽邃教堂。",
         "Dialogue", 1180, 720),
        ("沉默的霍雷斯", "#505050",
         "……（霍雷斯沉默不语，只是点了点头）",
         "Dialogue", 1230, 730),
        ("彼海姆的欧贝克", "#6688aa",
         "如果你有足够的智力，我可以教你魔法。但我要的不是免费的。给我找到魔法卷轴，我就教你新的术。",
         "Merchant", 1950, 450),
        ("卡里姆的伊贡", "#887766",
         "……你又在寻找帮助了吗？真是个废物。不过算了，这结晶怪物确实令人不快。",
         "Dialogue", 2300, 1300),
        ("圣骑士霍德里克", "#556644",
         "哈哈哈哈！来吧来吧！一起享受杀戮！",
         "Dialogue", 1650, 350),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name),
            make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue),
            make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    # --- Lights ---
    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 400, 180, 0.8, 0.7, 0.5, 0.6),
        (1200, 700, 180, 0.8, 0.7, 0.5, 0.6),
        (2000, 500, 180, 0.8, 0.7, 0.5, 0.6),
        (2600, 1400, 120, 0.3, 0.4, 0.9, 0.5),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    # --- Fog gates ---
    for da, ddx, ddy, dx, dy, w, h in [
        ("UndeadSettlement", p(1600), p(1200), p(100), p(400), 32, 200),
        ("FarronKeep", p(200), p(400), p(2800), p(1100), 32, 200),
        ("CathedralDeep", p(200), p(400), p(2000), p(800), 200, 32),
    ]:
        entities.append(make_entity("FogGate", dx, dy, [
            make_field("dest_area", "String", da),
            make_field("dest_x", "Float", float(ddx)), make_field("dest_y", "Float", float(ddy)),
            make_field("width", "Float", float(w)), make_field("height", "Float", float(h)),
        ]))

    # Boss fog gate (self-referential → triggers Crystal Sage fight)
    entities.append(make_entity("FogGate", 2048, 1024, [
        make_field("dest_area", "String", "RoadOfSacrifices"),
        make_field("dest_x", "Float", 2160.0),
        make_field("dest_y", "Float", 1200.0),
        make_field("width", "Float", 96.0),
        make_field("height", "Float", 48.0),
    ]))

    return chunk, entities


def make_farron_keep():
    S = 0.6
    chunk = new_chunk()
    def t(v): return max(0, min(159, int(v * S) // 16))
    def p(v): return int(v * S)

    # Section 1: 要塞入口 (x=0,y=0,w=600,h=600)
    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(600), t(600))
    # Section 2: 外围沼泽 (x=200,y=600,w=800,h=800)
    fill_tiles(chunk, TILE_GROUND, t(200), t(600), t(1000), t(1400))
    # Section 3: 左侧火炬区 (x=600,y=400,w=500,h=500)
    fill_tiles(chunk, TILE_GROUND, t(600), t(400), t(1100), t(900))
    # Section 4: 中央火炬区 (x=1600,y=800,w=500,h=500)
    fill_tiles(chunk, TILE_GROUND, t(1600), t(800), t(2100), t(1300))
    # Section 5: 右侧火炬区 (x=2400,y=600,w=500,h=500)
    fill_tiles(chunk, TILE_GROUND, t(2400), t(600), t(2900), t(1100))
    # Section 6: 要塞遗迹 (x=1800,y=1600,w=500,h=400)
    fill_tiles(chunk, TILE_GROUND, t(1800), t(1600), t(2300), t(2000))
    # Section 7: 老狼之塔 (x=1000,y=2200,w=400,h=500)
    fill_tiles(chunk, TILE_GROUND, t(1000), t(2200), t(1400), t(2700))
    # Section 8: 诅咒洞穴 (x=400,y=1600,w=400,h=400)
    fill_tiles(chunk, TILE_GROUND, t(400), t(1600), t(800), t(2000))
    # Section 9: 深渊骑士巡游区 (x=2200,y=2000,w=600,h=600)
    fill_tiles(chunk, TILE_GROUND, t(2200), t(2000), t(2800), t(2600))
    # Section 10: 正门通道 (x=2800,y=2400,w=300,h=400)
    fill_tiles(chunk, TILE_GROUND, t(2800), t(2400), t(3100), t(2800))
    # Section 11: 深渊监视者大厅 (x=3000,y=2600,w=800,h=800)
    fill_tiles(chunk, TILE_GROUND, t(3000), t(2600), t(3800), t(3400))

    # Corridors
    fill_tiles(chunk, TILE_GROUND, t(400), t(400), t(600), t(600))   # 1→3
    fill_tiles(chunk, TILE_GROUND, t(1100), t(800), t(1600), t(900)) # 3→4
    fill_tiles(chunk, TILE_GROUND, t(2100), t(800), t(2400), t(900)) # 4→5
    fill_tiles(chunk, TILE_GROUND, t(1400), t(1300), t(1800), t(1600)) # 4→6
    fill_tiles(chunk, TILE_GROUND, t(1800), t(2000), t(2200), t(2200)) # 6→9
    fill_tiles(chunk, TILE_GROUND, t(2800), t(2600), t(3000), t(2700)) # 10→11
    fill_tiles(chunk, TILE_GROUND, t(2800), t(2600), t(2800), t(2800)) # 9→10
    # Additional corridors for previously disconnected sections
    fill_tiles(chunk, TILE_GROUND, t(600), t(1400), t(800), t(1600))  # 2→8 (外围沼泽→诅咒洞穴)
    fill_tiles(chunk, TILE_GROUND, t(700), t(1400), t(1000), t(2200)) # 2→7 (外围沼泽→老狼之塔)

    # Boss arena walls (Abyss Watchers) at section 11
    fill_tiles(chunk, TILE_WALL, t(3050), t(2650), t(3750), t(2650))  # north
    fill_tiles(chunk, TILE_WALL, t(3050), t(3350), t(3750), t(3350))  # south
    fill_tiles(chunk, TILE_WALL, t(3000), t(2650), t(3000), t(3350))  # west
    # East wall with entrance gap around y=112 (tiles 109-115)
    for y in range(t(2650), t(3350) + 1):
        if y < 109 or y > 115:
            if 0 <= y < CHUNK_SIZE:
                chunk[y][t(3800)] = TILE_WALL
    # Entrance gap in north wall
    fill_tiles(chunk, TILE_GROUND, t(3050), t(2650), t(3130), t(2650))
    # Ground corridor through east wall gap to reach FogGate at (142,112)
    fill_tiles(chunk, TILE_GROUND, 142, 109, 146, 116)

    # --- Detailed wall structures ---

    # 1) 要塞入口: Broken stone walls and dead trees at entry
    fill_tiles(chunk, TILE_WALL, 3, 0, 3, 8)        # left wall fragment
    fill_tiles(chunk, TILE_WALL, 10, 0, 10, 5)       # right wall fragment
    fill_tiles(chunk, TILE_WALL, 18, 0, 22, 0)       # top edge wall
    fill_tiles(chunk, TILE_WALL, 0, 15, 0, 22)       # far left wall
    #    Scattered dead tree stumps
    for wx, wy in [(5, 8), (6, 8), (15, 5), (16, 5), (8, 18), (9, 18), (17, 12), (18, 12)]:
        chunk[wy][wx] = TILE_WALL

    # 2) Corridor 1→3: Narrow path flanked by walls
    fill_tiles(chunk, TILE_WALL, 15, 12, 22, 14)    # top wall
    fill_tiles(chunk, TILE_WALL, 15, 23, 22, 24)    # bottom wall

    # 3) 外围沼泽: Scattered ruin blocks in the swamp
    #    Collapsed pillars and stone platforms
    for wx, wy in [(12, 30), (13, 30), (28, 35), (29, 35), (18, 42), (19, 42),
                   (32, 28), (33, 28), (15, 48), (16, 48), (25, 45), (26, 45),
                   (10, 38), (11, 38), (34, 48), (35, 48)]:
        chunk[wy][wx] = TILE_WALL
    #    Broken wall segment across swamp
    fill_tiles(chunk, TILE_WALL, 20, 32, 20, 36)

    # 4) 左侧火炬区: Ruined tower around the torch
    fill_tiles(chunk, TILE_WALL, 24, 15, 30, 15)    # north wall left
    fill_tiles(chunk, TILE_WALL, 34, 15, 38, 15)    # north wall right (gap 31..33)
    fill_tiles(chunk, TILE_WALL, 24, 15, 24, 22)    # west wall
    fill_tiles(chunk, TILE_WALL, 38, 15, 38, 22)    # east wall
    fill_tiles(chunk, TILE_WALL, 24, 30, 30, 30)    # south wall left (gap for exit)
    fill_tiles(chunk, TILE_WALL, 35, 30, 38, 30)    # south wall right

    # 5) Corridor 3→4: Narrow path with ruin fragments
    fill_tiles(chunk, TILE_WALL, 41, 26, 55, 28)    # top wall
    fill_tiles(chunk, TILE_WALL, 41, 35, 55, 36)    # bottom wall
    #    Ruin block mid-corridor (off to the side)
    chunk[29][50] = TILE_WALL
    chunk[29][51] = TILE_WALL

    # 6) 中央火炬区: Broken walls around torch
    fill_tiles(chunk, TILE_WALL, 62, 30, 67, 30)    # north wall left
    fill_tiles(chunk, TILE_WALL, 72, 30, 78, 30)    # north wall right (gap 68..71)
    fill_tiles(chunk, TILE_WALL, 60, 36, 60, 42)    # west wall fragment
    fill_tiles(chunk, TILE_WALL, 78, 35, 78, 40)    # east wall fragment
    fill_tiles(chunk, TILE_WALL, 62, 48, 68, 48)    # south wall left
    fill_tiles(chunk, TILE_WALL, 73, 48, 78, 48)    # south wall right
    #    Interior ruin columns
    chunk[36][65] = TILE_WALL
    chunk[36][66] = TILE_WALL
    chunk[42][73] = TILE_WALL
    chunk[42][74] = TILE_WALL

    # 7) Corridor 4→5: Narrow path through ruins
    fill_tiles(chunk, TILE_WALL, 78, 26, 88, 28)    # top wall
    fill_tiles(chunk, TILE_WALL, 78, 35, 88, 37)    # bottom wall

    # 8) 右侧火炬区: Stone platform with scattered ruins
    fill_tiles(chunk, TILE_WALL, 92, 22, 96, 22)    # north wall left (gap for entry)
    fill_tiles(chunk, TILE_WALL, 103, 22, 108, 22)  # north wall right
    fill_tiles(chunk, TILE_WALL, 89, 22, 89, 26)    # west wall fragment (moved from path)
    fill_tiles(chunk, TILE_WALL, 108, 26, 108, 35)  # east wall fragment
    #    Ruin debris
    for wx, wy in [(95, 30), (96, 30), (100, 35), (101, 35), (94, 38), (95, 38)]:
        chunk[wy][wx] = TILE_WALL

    # 9) Corridor 4→6: Winding swamp path
    fill_tiles(chunk, TILE_WALL, 52, 50, 58, 52)    # top wall
    fill_tiles(chunk, TILE_WALL, 55, 56, 65, 57)    # bottom wall (shortened, keep sec6 entry open)

    # 10) 要塞遗迹: Large ruined building walls
    fill_tiles(chunk, TILE_WALL, 69, 60, 74, 60)    # north wall left
    fill_tiles(chunk, TILE_WALL, 79, 60, 86, 60)    # north wall right (gap 75..78)
    fill_tiles(chunk, TILE_WALL, 67, 66, 67, 72)    # west wall (gap at y=60..65 for corridor entry)
    fill_tiles(chunk, TILE_WALL, 86, 66, 86, 72)    # east wall
    fill_tiles(chunk, TILE_WALL, 69, 75, 75, 75)    # south wall left
    # (gap 76..86 for corridor 6→9 exit)
    #    Interior walls (ruined rooms) - with gaps for navigation
    fill_tiles(chunk, TILE_WALL, 73, 63, 73, 66)    # room divider left (gap at y=67..)
    fill_tiles(chunk, TILE_WALL, 80, 63, 80, 66)    # room divider right (gap at y=67..)
    #    No cross wall to avoid boxing in

    # 11) Corridor 6→9: Swamp path (keep corridor 67..82, y=75..82 clear)
    fill_tiles(chunk, TILE_WALL, 67, 73, 77, 74)    # top wall (above corridor)
    fill_tiles(chunk, TILE_WALL, 70, 83, 82, 85)    # bottom wall (below corridor)

    # 12) 老狼之塔: Tower ruin walls
    fill_tiles(chunk, TILE_WALL, 38, 82, 42, 82)    # north wall left (gap for entry)
    fill_tiles(chunk, TILE_WALL, 48, 82, 52, 82)    # north wall right
    fill_tiles(chunk, TILE_WALL, 37, 87, 37, 95)    # west wall
    fill_tiles(chunk, TILE_WALL, 52, 87, 52, 95)    # east wall
    fill_tiles(chunk, TILE_WALL, 38, 101, 52, 101)  # south wall
    #    Interior platform wall
    fill_tiles(chunk, TILE_WALL, 40, 92, 49, 92)    # interior divider (gap at edges)
    fill_tiles(chunk, TILE_GROUND, 44, 92, 45, 92)  # gap in divider

    # 13) 诅咒洞穴: Cave walls creating narrow passages
    fill_tiles(chunk, TILE_WALL, 15, 62, 15, 70)    # west wall
    fill_tiles(chunk, TILE_WALL, 30, 62, 30, 70)    # east wall
    #    Interior stalagmite obstacles
    for wx, wy in [(20, 65), (21, 65), (25, 68), (26, 68), (18, 72), (19, 72)]:
        chunk[wy][wx] = TILE_WALL

    # 14) 深渊骑士巡游区: Scattered ruin walls
    fill_tiles(chunk, TILE_WALL, 84, 75, 84, 82)    # west wall fragment
    fill_tiles(chunk, TILE_WALL, 103, 78, 103, 85)  # east wall fragment
    #    Broken stone bridge
    fill_tiles(chunk, TILE_WALL, 88, 80, 88, 84)
    fill_tiles(chunk, TILE_WALL, 96, 82, 96, 87)
    #    Ruin debris
    for wx, wy in [(90, 90), (91, 90), (98, 93), (99, 93), (85, 95), (86, 95)]:
        chunk[wy][wx] = TILE_WALL

    # 15) 正门通道: Great stone gate corridor walls
    fill_tiles(chunk, TILE_WALL, 106, 88, 106, 95)  # left wall
    fill_tiles(chunk, TILE_WALL, 116, 88, 116, 95)  # right wall
    #    Pillar ruins in corridor
    chunk[92][110] = TILE_WALL
    chunk[92][111] = TILE_WALL
    chunk[98][109] = TILE_WALL
    chunk[98][110] = TILE_WALL

    # Poison pools (沼泽)
    for y in range(t(600), t(1400)):
        for x in range(t(400), t(1000)):
            chunk[y][x] = TILE_POISON
    for y in range(t(1200), t(1600)):
        for x in range(t(1400), t(1800)):
            chunk[y][x] = TILE_POISON

    entities = []

    # Player spawn & bonfires
    entities.append(make_entity("PlayerSpawn", p(100), p(300), [make_field("heal", "Bool", False)]))
    for bx, by in [(100, 300), (300, 400), (2000, 1800), (1200, 2400), (3200, 2800)]:
        entities.append(make_entity("Bonfire", p(bx), p(by)))

    # Boss spawn
    entities.append(make_entity("BossSpawn", p(3400), p(3000)))

    # Enemies
    for kind, dx, dy in [
        ("Ghru", 800, 700), ("Ghru", 850, 750), ("Ghru", 780, 650),
        ("Ghru", 900, 500), ("Ghru", 950, 550),
        ("DarkMage", 2500, 700), ("DarkMage", 2600, 750), ("DarkMage", 2550, 650),
        ("DarkMage", 1800, 900), ("DarkMage", 1850, 950),
        ("Ghru", 1700, 1000), ("Ghru", 1750, 1050), ("Ghru", 1800, 1000), ("Ghru", 1850, 980),
        ("Dog", 500, 900), ("Dog", 550, 950), ("Dog", 480, 870), ("Dog", 520, 920), ("Dog", 600, 880),
        ("Dog", 1400, 1200), ("Dog", 1450, 1250), ("Dog", 1350, 1180), ("Dog", 1420, 1230),
        ("Basilisk", 550, 1700), ("Basilisk", 600, 1750), ("Basilisk", 650, 1680),
        ("Darkwraith", 2300, 2100), ("Darkwraith", 2350, 2150),
        ("Darkwraith", 2500, 2300), ("Darkwraith", 2550, 2350),
        ("Ghru", 2000, 2000), ("Ghru", 2050, 2050), ("Ghru", 2100, 2000),
        ("Ghru", 2100, 2200), ("Ghru", 2150, 2250),
        ("CathedralKnight", 1150, 1800),
        ("WingedKnight", 700, 1100), ("WingedKnight", 750, 1150), ("WingedKnight", 800, 1080),
        ("CrystalLizard", 2200, 1400), ("CrystalLizard", 2250, 1450),
        ("CrystalLizard", 1050, 2150),
        ("CathedralKnight", 2600, 1900),
        ("Assassin", 2700, 2200), ("Assassin", 2750, 2250), ("Assassin", 2680, 2150),
        ("DarkMage", 2750, 2150),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))

    # Items
    for kind, dx, dy, val in [
        ("SoulOrb", 450, 500, 500),
        ("SoulOrb", 1900, 1900, 800),
        ("EstusShard", 2050, 1750, 0),
        ("HomewardBone", 350, 500, 0),
        ("PurpleMoss", 1200, 1000, 0),
        ("PurpleMoss", 800, 1200, 0),
        ("TitaniteShard", 2600, 800, 0),
        ("Consumable", 700, 1000, 0),
        ("Consumable", 500, 1300, 0),
        ("Consumable", 600, 750, 0),
        ("Consumable", 2400, 1700, 0),
        ("Consumable", 1200, 1300, 0),
        ("Consumable", 2400, 1200, 0),
        ("Consumable", 2250, 1450, 0),
        ("Consumable", 300, 500, 0),
        ("Consumable", 2650, 1950, 0),
        ("Consumable", 280, 430, 0),
        ("Consumable", 750, 1150, 0),
        ("Consumable", 600, 950, 0),
        ("Consumable", 2300, 1350, 0),
        ("Consumable", 2700, 2100, 0),
        ("UndeadBoneShard", 600, 950, 0),
        ("Consumable", 2300, 1500, 0),
        ("UndeadBoneShard", 1050, 2150, 0),
        ("RingDrop", 1500, 1500, 0),
        ("RingDrop", 1100, 800, 0),
        ("RingDrop", 2100, 1600, 0),
        ("WeaponDrop", 600, 1200, 0),
        ("ArmorDrop", 1300, 1450, 0),
        ("ArmorDrop", 550, 1050, 0),
        ("ArmorDrop", 1900, 1650, 0),
        ("ArmorDrop", 1550, 1550, 0),
        ("ArmorDrop", 750, 1080, 0),
        ("WeaponDrop", 3300, 2850, 0),
        ("Consumable", 2700, 2300, 0),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb": fields.append(make_field("value", "Int", val))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    # Chests
    for lk, lv, ln, dx, dy, mimic in [
        ("ArmorDrop", 0, "Antiquated Set", 580, 1750, False),
        ("WeaponDrop", 0, "Greatsword", 950, 650, False),
        ("WeaponDrop", 0, "Greataxe", 1150, 550, False),
        ("WeaponDrop", 0, "Sunlight Talisman", 1350, 1350, False),
        ("ArmorDrop", 0, "Brigand Set", 2300, 1500, False),
        ("WeaponDrop", 0, "Dragon Crest Shield", 2300, 1500, False),
        ("WeaponDrop", 0, "Stone Parma", 1600, 1100, False),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv), make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    # NPCs
    for name, color, dialogue, kind, dx, dy in [
        ("法兰的老狼", "#8899aa",
         "（老狼沉默地注视着你，眼中映着远方的火光。它的存在本身就是一种回答。）",
         "Dialogue", 1200, 2500),
        ("黄指的海泽尔", "#ccaa33",
         "呵呵呵……又是一个愚蠢的余灰吗？这片沼泽是我罗萨利亚的手指们的猎场！",
         "Dialogue", 1000, 1400),
        ("黑手的哥达", "#778899",
         "……（召唤符号出现）",
         "Dialogue", 2900, 2550),
        ("隆德尔的苍白影子", "#445566",
         "……（召唤符号出现）",
         "Dialogue", 350, 450),
        ("太阳王女的希丽丝", "#99aabb",
         "……（召唤符号出现）",
         "Dialogue", 2950, 2580),
        ("霍克伍德", "#8B7355",
         "……深渊监视者的遗志……我也要守护它。",
         "Dialogue", 3400, 3050),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name),
            make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue),
            make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    # Lights
    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 400, 200, 0.8, 0.7, 0.4, 0.6),
        (850, 600, 150, 1.0, 0.6, 0.2, 0.7),
        (1850, 1000, 150, 1.0, 0.6, 0.2, 0.7),
        (2650, 800, 150, 1.0, 0.6, 0.2, 0.7),
        (2000, 1800, 200, 0.8, 0.7, 0.4, 0.6),
        (1200, 2500, 180, 0.6, 0.7, 0.8, 0.5),
        (3000, 2800, 250, 0.5, 0.5, 0.6, 0.4),
        (3400, 3000, 120, 0.3, 0.4, 0.7, 0.3),
        (500, 1650, 100, 0.4, 0.4, 0.3, 0.3),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    # Fog gates
    for da, ddx, ddy, dx, dy, w, h in [
        ("RoadOfSacrifices", p(3000), p(600), p(0), p(200), 32, 200),
        ("CatacombsOfCarthus", p(200), p(400), p(3800), p(3000), 32, 200),
    ]:
        entities.append(make_entity("FogGate", dx, dy, [
            make_field("dest_area", "String", da),
            make_field("dest_x", "Float", float(ddx)), make_field("dest_y", "Float", float(ddy)),
            make_field("width", "Float", float(w)), make_field("height", "Float", float(h)),
        ]))

    # Boss fog gate (Abyss Watchers)
    boss_gate_x = (t(3050) + t(3130)) * 16 // 2
    boss_gate_y = t(2650) * 16
    entities.append(make_entity("FogGate", boss_gate_x, boss_gate_y, [
        make_field("dest_area", "String", "FarronKeep"),
        make_field("dest_x", "Float", float(p(3400))),
        make_field("dest_y", "Float", float(p(3000))),
        make_field("width", "Float", 80.0),
        make_field("height", "Float", 32.0),
    ]))

    return chunk, entities


def make_catacombs_of_carthus():
    S = 0.6
    chunk = new_chunk()
    def t(v): return max(0, min(159, int(v * S) // 16))
    def p(v): return int(v * S)

    # Section 1: 入口阶梯 (0,0,600,700)
    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(600), t(700))
    # Section 2: 骷髅球走廊 (400,600,1400,1000)
    fill_tiles(chunk, TILE_GROUND, t(400), t(600), t(1400), t(1000))
    # Section 3: 下层墓室 (400,900,1200,1600)
    fill_tiles(chunk, TILE_GROUND, t(400), t(900), t(1200), t(1600))
    # Section 4: 绳索吊桥 (1200,400,2200,1000)
    fill_tiles(chunk, TILE_GROUND, t(1200), t(400), t(2200), t(1000))
    # Section 5: 通向熏烟湖密道 (800,1500,1500,2400)
    fill_tiles(chunk, TILE_GROUND, t(800), t(1500), t(1500), t(2400))
    # Section 6: 沃尼尔战场 (2500,2300,3500,3100)
    fill_tiles(chunk, TILE_GROUND, t(2500), t(2300), t(3500), t(3100))
    # Section 7: 骸骨沉睡之间 (2200,1800,2800,2300)
    fill_tiles(chunk, TILE_GROUND, t(2200), t(1800), t(2800), t(2300))

    # Corridor: 4→7 (vertical)
    fill_tiles(chunk, TILE_GROUND, t(2150), t(1000), t(2250), t(1800))

    # ===== Detailed wall structures =====

    # --- Section 1: Entrance stairs (tiles 0-22, 0-26) ---
    # Stone stairway walls (flanking the entrance descent)
    for y in range(0, 26):
        if y < 5 or y > 9:  # gap for FarronKeep return gate at (0,7)
            chunk[y][0] = TILE_WALL
    # Stair-side sarcophagi (stone coffins along walls)
    for sx, sy in [(2, 5), (3, 5), (2, 12), (3, 12), (8, 8), (9, 8), (14, 4), (15, 4),
                   (5, 20), (6, 20), (10, 16), (11, 16)]:
        chunk[sy][sx] = TILE_WALL
    # Torch sconces (wall pillars)
    for tx, ty in [(1, 3), (1, 10), (1, 18), (20, 6), (20, 14)]:
        chunk[ty][tx] = TILE_WALL
    # Entrance hall divider wall with archway
    for x in range(5, 20):
        if x < 9 or x > 12:  # arch gap
            chunk[10][x] = TILE_WALL
    # Skeleton decoration walls (carved skull walls)
    for dy in range(2):
        for dx in range(2):
            chunk[22 + dy][18 + dx] = TILE_WALL

    # --- Section 2: Skeleton ball corridor (tiles 15-52, 22-37) ---
    # Long corridor walls (narrow the passage for ball rolling)
    for y in range(22, 38):
        chunk[y][15] = TILE_WALL
    # South wall of corridor (partial, leaving exits)
    for x in range(15, 53):
        if x < 25 or (x > 28 and x < 35) or (x > 38 and x < 45) or x > 48:
            chunk[37][x] = TILE_WALL
    # Alcove recesses in corridor walls (where skeletons hide)
    for ax, ay in [(17, 26), (17, 30), (17, 34), (50, 26), (50, 30), (50, 34)]:
        chunk[ay][ax] = TILE_WALL
    # Skeleton pile obstacles
    for sx, sy in [(22, 28), (23, 28), (30, 32), (31, 32), (40, 27), (41, 27),
                   (35, 25), (36, 25), (45, 34), (46, 34)]:
        chunk[sy][sx] = TILE_WALL
    # Ball track channel walls (center divider, partial)
    for y in range(24, 35):
        chunk[y][33] = TILE_WALL
    # Gap in center divider for crossing
    for y in range(28, 32):
        chunk[y][33] = TILE_GROUND

    # --- Section 3: Lower tomb chambers (tiles 15-45, 33-60) ---
    # Chamber dividing walls (creating connected rooms)
    # Wall between chamber A and B (with doorway)
    for x in range(15, 46):
        if x < 22 or x > 25:
            chunk[40][x] = TILE_WALL
    # Wall between chamber B and C
    for x in range(15, 46):
        if x < 30 or x > 33:
            chunk[50][x] = TILE_WALL
    # Interior wall segments creating room structure
    for y in range(33, 50):
        if y < 37 or y > 39:
            chunk[y][25] = TILE_WALL
    # Doorway in vertical wall
    for y in range(43, 47):
        chunk[y][25] = TILE_GROUND
    # Tomb niches in chamber walls
    for tn_x, tn_y in [(18, 35), (19, 35), (18, 44), (19, 44), (18, 53), (19, 53),
                        (28, 36), (29, 36), (28, 46), (29, 46), (28, 55), (29, 55),
                        (38, 38), (39, 38), (38, 48), (39, 48), (38, 56), (39, 56),
                        (42, 42), (43, 42), (42, 52), (43, 52)]:
        chunk[tn_y][tn_x] = TILE_WALL
    # Ritual altar (wall block)
    for dy in range(2):
        for dx in range(3):
            chunk[36 + dy][35 + dx] = TILE_WALL
    # Weapon rack walls
    for wy in range(2):
        chunk[57 + wy][40] = TILE_WALL
        chunk[57 + wy][42] = TILE_WALL

    # --- Section 4: Rope bridge over abyss (tiles 45-82, 15-37) ---
    # Bridge approach walls (stone platform edges)
    for x in range(45, 55):
        chunk[15][x] = TILE_WALL
    # Far platform walls
    for x in range(72, 83):
        chunk[15][x] = TILE_WALL
    # Bridge railing (thin walls along bridge sides) - represents rope bridge
    for x in range(55, 72):
        chunk[22][x] = TILE_WALL
        chunk[30][x] = TILE_WALL
    # Bridge planking gaps (keep ground on bridge itself)
    fill_tiles(chunk, TILE_GROUND, 55, 23, 71, 29)
    # Bridge approach paths (upper and lower platforms)
    fill_tiles(chunk, TILE_GROUND, 55, 16, 71, 21)
    fill_tiles(chunk, TILE_GROUND, 55, 31, 71, 36)
    # Archway skeleton platforms (high ledges for archers)
    for dx in range(3):
        for dy in range(2):
            chunk[17 + dy][60 + dx] = TILE_WALL
            chunk[17 + dy][68 + dx] = TILE_WALL
    # Abyss edge (wall line marking drop-off)
    for x in range(55, 72):
        chunk[36][x] = TILE_WALL
    # Gap to cross abyss bridge
    for x in range(60, 67):
        chunk[36][x] = TILE_GROUND

    # --- Section 5: Smouldering Lake path (tiles 30-56, 56-90) ---
    # Narrow tunnel walls
    for y in range(56, 91):
        chunk[y][30] = TILE_WALL
    # Tunnel narrows progressively
    for y in range(56, 68):
        chunk[y][56] = TILE_WALL
    for y in range(68, 80):
        chunk[y][52] = TILE_WALL
    for y in range(80, 91):
        chunk[y][48] = TILE_WALL
    # Rock formations in tunnel
    for rx, ry in [(35, 60), (36, 60), (40, 68), (41, 68), (45, 75), (46, 75),
                   (38, 82), (39, 82), (34, 70), (35, 70)]:
        chunk[ry][rx] = TILE_WALL
    # Lava glow crevices (wall blocks near floor)
    for dy in range(2):
        for dx in range(2):
            chunk[85 + dy][42 + dx] = TILE_WALL
    # Hidden cave opening wall
    for y in range(74, 82):
        chunk[y][55] = TILE_WALL
    for y in range(77, 80):
        chunk[y][55] = TILE_GROUND  # gap to enter

    # --- Section 7: Bone sleeping hall (tiles 82-105, 67-86) ---
    # Hall perimeter walls
    for x in range(82, 106):
        chunk[67][x] = TILE_WALL
        if 0 <= 86 < CHUNK_SIZE:
            chunk[86][x] = TILE_WALL
    # Entrance gap from corridor (4->7) at tiles 80-84
    for x in range(82, 85):
        chunk[67][x] = TILE_GROUND
    # Exit gap to Wolnir arena approach (aligned with boss arena north gap at x=101-106)
    for x in range(101, 107):
        chunk[86][x] = TILE_GROUND
    # Bone pile walls (skeletons sleeping on ground)
    bone_positions = [(84, 70), (85, 70), (88, 72), (89, 72), (92, 70), (93, 70),
                      (86, 75), (87, 75), (90, 78), (91, 78), (95, 73), (96, 73),
                      (100, 76), (101, 76), (84, 80), (85, 80), (98, 82), (99, 82),
                      (88, 83), (89, 83), (93, 80), (94, 80)]
    for bx, by in bone_positions:
        chunk[by][bx] = TILE_WALL
    # Stone ramp wall (leading up to bridge high platform)
    for dx in range(3):
        for dy in range(2):
            chunk[69 + dy][102 + dx] = TILE_WALL
    # Skull pile centerpiece
    for dy in range(2):
        for dx in range(3):
            chunk[75 + dy][91 + dx] = TILE_WALL

    # ===== Boss arena walls (High Lord Wolnir) =====
    fill_tiles(chunk, TILE_WALL, 93, 85, 100, 85)    # north-left
    fill_tiles(chunk, TILE_WALL, 107, 85, 131, 85)   # north-right (gap 101..106)
    fill_tiles(chunk, TILE_WALL, 93, 117, 131, 117)  # south
    fill_tiles(chunk, TILE_WALL, 92, 85, 92, 117)    # west
    # East wall with gap for Irithyll exit gate at tile ~(131,108)
    for y in range(85, 118):
        if 0 <= y < CHUNK_SIZE:
            if y < 105 or y > 111:  # gap at y=105-111 for Irithyll gate
                chunk[y][132] = TILE_WALL
    # Ground tiles to reach Irithyll gate beyond east wall
    for y in range(105, 112):
        for x in range(132, 136):
            if 0 <= y < CHUNK_SIZE and 0 <= x < CHUNK_SIZE:
                chunk[y][x] = TILE_GROUND
    # Boss arena interior: bone wall clusters
    for bx, by in [(97, 90), (98, 90), (105, 90), (106, 90),
                   (100, 95), (101, 95), (110, 95), (111, 95),
                   (95, 100), (96, 100), (115, 100), (116, 100),
                   (103, 108), (104, 108)]:
        chunk[by][bx] = TILE_WALL
    # Wolnir's giant sword (wall obstacle)
    for dy in range(4):
        for dx in range(2):
            chunk[92 + dy][102 + dx] = TILE_WALL
    # Dark fog edge walls (abyss boundary markers)
    for dy in range(3):
        for dx in range(3):
            if 0 <= 114 + dy < CHUNK_SIZE and 0 <= 126 + dx < CHUNK_SIZE:
                chunk[114 + dy][126 + dx] = TILE_WALL

    entities = []
    entities.append(make_entity("PlayerSpawn", p(300), p(400), [make_field("heal", "Bool", False)]))
    for bx, by in [(300, 400), (3000, 2800), (1200, 2200)]:
        entities.append(make_entity("Bonfire", p(bx), p(by)))
    entities.append(make_entity("BossSpawn", p(3000), p(2800)))

    # Enemies
    for kind, dx, dy in [
        ("Skeleton", 500, 500), ("Skeleton", 550, 550),
        ("Skeleton", 700, 750), ("Skeleton", 750, 700), ("Skeleton", 800, 780),
        ("Skeleton", 550, 1100), ("Skeleton", 600, 1150),
        ("Skeleton", 650, 1300), ("Skeleton", 700, 1350), ("Skeleton", 600, 1400),
        ("Skeleton", 800, 1200), ("Skeleton", 850, 1250),
        ("Archer", 1700, 500), ("Archer", 1750, 520),
        ("Archer", 1900, 450),
        ("Skeleton", 1000, 1700), ("Skeleton", 1050, 1750),
        ("Skeleton", 1100, 2000), ("Skeleton", 1150, 2050),
        ("CathedralKnight", 1300, 700),
        ("CathedralKnight", 600, 1050),
        ("Dog", 700, 1800), ("Dog", 750, 1850), ("Dog", 800, 1780),
        ("Dog", 600, 1900),
        ("FireDemon", 900, 1800),
        ("Skeleton", 2400, 2000), ("Skeleton", 2450, 2050), ("Skeleton", 2500, 2000),
        ("Darkwraith", 2600, 2400), ("Darkwraith", 2700, 2450),
        ("CrystalLizard", 600, 500),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))

    # Items
    for kind, dx, dy, val in [
        ("SoulOrb", 250, 250, 500), ("SoulOrb", 500, 350, 800),
        ("SoulOrb", 800, 450, 1200), ("SoulOrb", 900, 550, 1000),
        ("SoulOrb", 1000, 700, 1500), ("HomewardBone", 600, 500, 0),
        ("EstusShard", 1100, 1500, 0), ("PurpleMoss", 900, 1600, 0),
        ("TitaniteShard", 700, 800, 0), ("Firebomb", 500, 600, 0),
        ("Consumable", 1200, 1800, 0), ("Consumable", 1300, 2000, 0),
        ("WeaponDrop", 600, 1200, 0), ("RingDrop", 500, 600, 0),
        ("ArmorDrop", 850, 500, 0), ("Consumable", 500, 350, 0),
        ("Consumable", 1100, 2200, 0), ("UndeadBoneShard", 950, 1900, 0),
        ("RingDrop", 2400, 1900, 0), ("Consumable", 2600, 2500, 0),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb": fields.append(make_field("value", "Int", val))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    # Chests
    for lk, lv, ln, dx, dy, mimic in [
        ("RingDrop", 0, "Carthus Bloodring", 500, 600, False),
        ("WeaponDrop", 0, "Carthus Curved Sword", 750, 500, False),
        ("WeaponDrop", 0, "Murakumo", 650, 600, True),
        ("ArmorDrop", 0, "Carthus Set", 850, 500, False),
        ("WeaponDrop", 0, "Carthus Shotel", 1100, 2100, False),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv), make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    # NPCs
    for name, color, dialogue, kind, dx, dy in [
        ("亚斯特拉的安里", "#c0c0c0",
         "……又见面了。霍拉斯不见了。如果你见到霍拉斯，请告诉我。",
         "Dialogue", 600, 500),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name),
            make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue),
            make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    # Lights
    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 400, 180, 0.9, 0.7, 0.4, 0.6),
        (500, 400, 150, 0.9, 0.7, 0.4, 0.4),
        (700, 500, 120, 0.5, 0.4, 0.3, 0.2),
        (1200, 2200, 150, 0.8, 0.6, 0.3, 0.4),
        (3000, 2800, 250, 0.3, 0.2, 0.4, 0.5),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    # Fog gates
    for da, ddx, ddy, dx, dy, w, h in [
        ("FarronKeep", p(200), p(300), p(0), p(200), 32, 200),
        ("SmoulderingLake", p(300), p(300), p(1200), p(2100), 32, 200),
        ("Irithyll", p(200), p(200), p(3500), p(2900), 32, 200),
    ]:
        entities.append(make_entity("FogGate", dx, dy, [
            make_field("dest_area", "String", da),
            make_field("dest_x", "Float", float(ddx)), make_field("dest_y", "Float", float(ddy)),
            make_field("width", "Float", float(w)), make_field("height", "Float", float(h)),
        ]))

    # Boss fog gate (High Lord Wolnir)
    entities.append(make_entity("FogGate", 104*16, 85*16, [
        make_field("dest_area", "String", "CatacombsOfCarthus"),
        make_field("dest_x", "Float", float(p(3000))),
        make_field("dest_y", "Float", float(p(2800))),
        make_field("width", "Float", 96.0),
        make_field("height", "Float", 32.0),
    ]))

    return chunk, entities


def make_smouldering_lake():
    chunk = new_chunk()
    # Design doc: 3600×3000 → scale to fit 2560×2560
    S = 0.7
    def t(v): return max(0, min(CHUNK_SIZE - 1, int(v * S) // 16))
    def p(v): return int(v * S)

    # ===== Terrain: 5 sections from SmoulderingLake.json =====
    # 1. 地下洞穴入口: (0,0)+(600,600)
    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(600), t(600))
    # 2. 熏烟湖岸: (400,600)+(1800,1600)
    fill_tiles(chunk, TILE_GROUND, t(400), t(600), t(1800), t(1600))
    # 3. 恶魔遗迹外殿: (1200,1400)+(2000,2000)
    fill_tiles(chunk, TILE_GROUND, t(1200), t(1400), t(2000), t(2000))
    # 4. 恶魔教徒回廊: (1800,1600)+(2400,2100)
    fill_tiles(chunk, TILE_GROUND, t(1800), t(1600), t(2400), t(2100))
    # 5. 老恶魔王竞技场: (2200,2000)+(3200,2700)
    fill_tiles(chunk, TILE_GROUND, t(2200), t(2000), t(3200), t(2700))

    # ===== Corridors (connect sections) =====
    # Section 1 → 2 (cave exit to lakeshore)
    fill_tiles(chunk, TILE_GROUND, t(200), t(500), t(500), t(700))
    # Section 2 → 3 (lakeshore to demon ruins)
    fill_tiles(chunk, TILE_GROUND, t(1200), t(1200), t(1500), t(1500))
    # Section 3 → 4 (ruins to cultist corridor)
    fill_tiles(chunk, TILE_GROUND, t(1800), t(1500), t(2000), t(1700))
    # Section 4 → 5 (corridor to boss arena)
    fill_tiles(chunk, TILE_GROUND, t(2200), t(1900), t(2400), t(2050))

    # ===== Lava pools (TILE_POISON for lava) =====
    # Lava pool 1: central lake area
    fill_tiles(chunk, TILE_POISON, t(500), t(700), t(1000), t(1100))
    # Lava pool 2: east lakeshore
    fill_tiles(chunk, TILE_POISON, t(1100), t(800), t(1500), t(1200))
    # Lava pool 3: demon ruins floor cracks
    fill_tiles(chunk, TILE_POISON, t(1300), t(1500), t(1500), t(1650))
    # Lava pool 4: boss arena edges
    fill_tiles(chunk, TILE_POISON, t(2300), t(2100), t(2600), t(2300))
    fill_tiles(chunk, TILE_POISON, t(2800), t(2400), t(3000), t(2600))

    # ===== Detailed wall structures — Smouldering Lake =====

    # --- 地下洞穴入口 (tiles 0-26, 0-26): rocky tunnels ---
    # Tunnel walls — narrow entrance corridor
    for y in range(0, 27):
        if y < 8 or y > 16:                # gap at y=8-16 (tunnel passage)
            chunk[y][8] = TILE_WALL
    for y in range(0, 27):
        if y < 10 or y > 18:
            chunk[y][20] = TILE_WALL
    # Rock formations along tunnel walls
    for x in range(0, 10):
        chunk[0][x] = TILE_WALL
        chunk[26][x] = TILE_WALL
    for x in range(18, 27):
        chunk[0][x] = TILE_WALL
    # Stalactite/stalagmite pillars
    chunk[12][5] = TILE_WALL
    chunk[15][15] = TILE_WALL
    chunk[8][12] = TILE_WALL

    # --- 熏烟湖岸 (tiles 17-78, 26-70): wide lava shore with ruins ---
    # Crumbled ruin walls — scattered rock formations
    # Ruin cluster 1 (NW, tiles 20-25, 30-35)
    fill_tiles(chunk, TILE_WALL, 20, 30, 25, 30)
    fill_tiles(chunk, TILE_WALL, 20, 30, 20, 33)
    fill_tiles(chunk, TILE_WALL, 25, 30, 25, 35)
    # Ruin cluster 2 (center, tiles 40-48, 38-44)
    for x in range(40, 49):
        chunk[38][x] = TILE_WALL
    for y in range(38, 45):
        chunk[y][40] = TILE_WALL
        chunk[y][48] = TILE_WALL
    fill_tiles(chunk, TILE_GROUND, 41, 39, 47, 44)  # hollow inside
    # Ruin cluster 3 (east, tiles 60-67, 45-52)
    for x in range(60, 68):
        chunk[45][x] = TILE_WALL
    for y in range(45, 53):
        chunk[y][60] = TILE_WALL
        chunk[y][67] = TILE_WALL
    fill_tiles(chunk, TILE_GROUND, 61, 46, 66, 52)  # hollow inside
    # Scattered rock pillars (cover from ballista)
    for rx, ry in [(30, 42), (35, 55), (50, 48), (55, 35), (65, 58), (70, 45), (45, 60)]:
        chunk[ry][rx] = TILE_WALL
    # North cliff wall (lava edge)
    for x in range(17, 79):
        if x < 25 or x > 30:
            chunk[26][x] = TILE_WALL
    # Re-open corridor path
    fill_tiles(chunk, TILE_GROUND, 12, 20, 20, 30)

    # --- 恶魔遗迹外殿 (tiles 52-87, 61-87): demon ruins with stone pillars ---
    # Outer ruin walls
    for x in range(52, 88):
        if x < 62 or x > 66:              # entrance gap from south
            chunk[61][x] = TILE_WALL
    for x in range(52, 88):
        chunk[87][x] = TILE_WALL
    for y in range(61, 88):
        chunk[y][52] = TILE_WALL
    for y in range(61, 88):
        if y < 70 or y > 75:              # exit gap to corridor
            chunk[y][87] = TILE_WALL
    # Interior ground
    fill_tiles(chunk, TILE_GROUND, 53, 62, 86, 86)
    # Collapsed stone pillars (demon relief walls)
    for px, py in [(58, 68), (58, 78), (65, 65), (65, 82), (72, 68), (72, 78), (80, 70), (80, 80)]:
        chunk[py][px] = TILE_WALL
    # Fallen archway
    fill_tiles(chunk, TILE_WALL, 60, 73, 63, 76)
    fill_tiles(chunk, TILE_GROUND, 61, 74, 62, 75)  # walkable arch
    # Demon statue blocks
    for bx, by in [(55, 72), (83, 65), (83, 83)]:
        chunk[by][bx] = TILE_WALL

    # --- 恶魔教徒回廊 (tiles 78-105, 70-91): narrow corridors, cells ---
    # Corridor walls — maze-like passages
    # Outer walls
    for y in range(70, 92):
        chunk[y][78] = TILE_WALL
    for y in range(70, 92):
        if y < 78 or y > 84:              # entrance from ruins
            chunk[y][105] = TILE_WALL
    for x in range(78, 106):
        if x < 82 or x > 88:              # gap from ruins
            chunk[70][x] = TILE_WALL
    for x in range(78, 106):
        chunk[91][x] = TILE_WALL
    # Interior ground
    fill_tiles(chunk, TILE_GROUND, 79, 71, 104, 90)
    # Cell partition walls (narrow corridors)
    for y in range(72, 89):
        if y < 76 or y > 79:              # doorway 1
            chunk[y][85] = TILE_WALL
    for y in range(72, 89):
        if y < 82 or y > 85:              # doorway 2
            chunk[y][95] = TILE_WALL
    # Ritual altar room (tiles 96-103, 80-88)
    fill_tiles(chunk, TILE_WALL, 96, 80, 103, 80)
    fill_tiles(chunk, TILE_WALL, 96, 88, 103, 88)
    fill_tiles(chunk, TILE_WALL, 96, 80, 96, 88)
    fill_tiles(chunk, TILE_WALL, 103, 80, 103, 88)
    fill_tiles(chunk, TILE_GROUND, 97, 81, 102, 87)  # hollow
    # Demon statues in altar room
    chunk[84][99] = TILE_WALL
    chunk[84][100] = TILE_WALL
    # Connection corridor from cultist area east exit to boss arena entrance
    fill_tiles(chunk, TILE_GROUND, 103, 82, 118, 90)   # path from corridor exit to arena gap

    # --- 老恶魔王竞技场 (tiles 96-140, 87-118): boss arena ---
    # Arena walls
    for x in range(96, 141):
        if x < 104 or x > 118:            # wide entrance gap for corridor
            chunk[87][x] = TILE_WALL
    for x in range(96, 141):
        chunk[118][x] = TILE_WALL         # south wall
    for y in range(87, 119):
        chunk[y][96] = TILE_WALL          # west wall
    for y in range(87, 119):
        if y < 95 or y > 105:             # exit gap (Irithyll fog gate)
            chunk[y][140] = TILE_WALL
    # Arena floor
    fill_tiles(chunk, TILE_GROUND, 97, 88, 139, 117)
    # Central altar (ruined, with south entrance)
    fill_tiles(chunk, TILE_WALL, 114, 100, 120, 100)  # north wall
    fill_tiles(chunk, TILE_WALL, 114, 100, 114, 103)  # west wall
    fill_tiles(chunk, TILE_WALL, 120, 100, 120, 103)  # east wall
    # South wall with entrance gap
    for x in range(114, 121):
        if x < 116 or x > 118:            # entrance gap at x=116-118
            chunk[103][x] = TILE_WALL
    fill_tiles(chunk, TILE_GROUND, 115, 101, 119, 102)  # altar interior (above gap)
    # Stone pillar cover positions
    for px, py in [(102, 93), (102, 110), (133, 93), (133, 110),
                   (108, 98), (126, 98), (108, 108), (126, 108)]:
        chunk[py][px] = TILE_WALL
    # Demon throne ruins (SE corner)
    fill_tiles(chunk, TILE_WALL, 130, 112, 136, 116)
    fill_tiles(chunk, TILE_GROUND, 131, 113, 135, 115)  # hollow throne
    # Re-open entrance corridor (after arena walls applied)
    fill_tiles(chunk, TILE_GROUND, 103, 87, 118, 90)    # ensure connection from corridor
    # Exit corridor to Irithyll (beyond east wall)
    fill_tiles(chunk, TILE_GROUND, 139, 95, 148, 105)

    # --- Rock formations scattered throughout ---
    # Lava islands (safe spots in lava pools)
    for ix, iy in [(35, 50), (45, 55), (60, 52), (80, 50), (95, 55)]:
        chunk[iy][ix] = TILE_GROUND
    # Edge walls to define boundaries
    for y in range(0, 27):
        chunk[y][0] = TILE_WALL
    for x in range(0, 27):
        chunk[0][x] = TILE_WALL
    for x in range(0, 145):
        chunk[159][x] = TILE_WALL
    for y in range(0, 160):
        chunk[y][159] = TILE_WALL

    entities = []
    entities.append(make_entity("PlayerSpawn", p(300), p(300), [make_field("heal", "Bool", False)]))
    entities.append(make_entity("Bonfire", p(300), p(300)))          # 废弃地下墓地
    entities.append(make_entity("Bonfire", p(1400), p(1600)))        # 老王门厅
    entities.append(make_entity("Bonfire", p(1806), p(1900)))        # 恶魔遗迹
    entities.append(make_entity("Bonfire", p(2600), p(2200)))        # 恶魔老王

    # ===== Boss: Old Demon King =====
    entities.append(make_entity("BossSpawn", p(2700), p(2350)))

    # ===== Enemies =====
    for kind, dx, dy, count in [
        ("Skeleton", 500, 600, 2),
        ("Skeleton", 450, 550, 3),
        ("Dog", 700, 800, 3),
        ("FireDemon", 800, 900, 1),
        ("DarkMage", 1000, 1100, 1),
        ("Dog", 350, 350, 2),
        ("Ghru", 1500, 1500, 8),
        ("DemonStatue", 400, 400, 3),
        ("DemonStatue", 1000, 700, 2),
        ("FireDemon", 1900, 1800, 2),
        ("FireDemon", 2100, 1900, 1),
        ("BlackKnight", 700, 600, 1),
        ("BlackKnight", 1500, 1700, 1),
        ("BlackKnight", 1850, 2050, 1),
        ("CrystalLizard", 500, 500, 1),
        ("CrystalLizard", 1350, 1550, 2),
        ("Dog", 1200, 1400, 5),
        ("Dog", 1250, 1450, 2),
        ("Basilisk", 1700, 2000, 4),
        ("InfestedCorpse", 1550, 1650, 4),
        ("FireDemon", 800, 600, 1),
        ("FireDemon", 900, 700, 1),
        ("FireDemon", 1100, 800, 1),
        ("FireDemon", 1200, 900, 1),
    ]:
        for i in range(count):
            ox = (i * 24) % 48 - 24
            oy = (i * 18) % 36 - 18
            entities.append(make_entity("Enemy", p(dx) + ox, p(dy) + oy, [
                make_field("kind", "LocalEnum.EnemyKind", kind),
            ]))

    # ===== Items =====
    for kind, dx, dy, extra in [
        ("SoulOrb", 350, 350, [("value", "Int", 500)]),
        ("SoulOrb", 900, 1000, [("value", "Int", 800)]),
        ("HomewardBone", 1450, 1650, []),
        ("SoulOrb", 1000, 650, [("value", "Int", 1200)]),
        ("EstusShard", 600, 500, []),
        ("SoulOrb", 1200, 850, [("value", "Int", 1500)]),
        ("PurpleMoss", 800, 650, []),
        ("HomewardBone", 1100, 800, []),
        ("SoulOrb", 2500, 2150, [("value", "Int", 1000)]),
        ("Ember", 600, 700, []),
        ("Ember", 1600, 1850, []),
        ("Ember", 2300, 2050, []),
        ("TitaniteShard", 2000, 1900, [("name", "String", "大型楔形石碎片")]),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        for fname, ftype, fval in extra:
            fields.append(make_field(fname, ftype, fval))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    # ===== Chests =====
    for dx, dy, lk, ln, mimic in [
        (600, 500, "EstusShard", "", False),
        (1450, 1650, "Consumable", "伊札里斯咒术书", False),
        (1550, 1700, "WeaponDrop", "伊札里斯杖", False),
        (1480, 1680, "WeaponDrop", "黑骑士剑", False),
        (800, 650, "WeaponDrop", "Demon's Greataxe", False),
        (1000, 700, "RingDrop", "Fire Clutch Ring", False),
        (1100, 750, "ArmorDrop", "Pyromancer Set", False),
        (1200, 850, "WeaponDrop", "Demon's Fist", True),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", 0),
            make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    # ===== NPCs =====
    for name, kind, dx, dy, color, dialogue in [
        ("骑士杀手崔索格", "Dialogue", 1700, 1950, "#8B0000",
         "（入侵者从熔岩区域出现）|……又一个送死的灰烬。"),
        ("霍拉斯", "Dialogue", 650, 750, "#505050",
         "……|（霍拉斯沉默地面对你，眼中已失去理智）"),
        ("大沼的库库鲁斯", "Dialogue", 2500, 2100, "#cc6600",
         "（白灵召唤印记出现在老恶魔王Boss门前）"),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name),
            make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    # ===== Fog gates =====
    # 1. Return to CatacombsOfCarthus (north, cave entrance)
    entities.append(make_entity("FogGate", p(100), p(150), [
        make_field("dest_area", "String", "CatacombsOfCarthus"),
        make_field("dest_x", "Float", 1800.0),
        make_field("dest_y", "Float", 2400.0),
        make_field("width", "Float", 300.0),
        make_field("height", "Float", 40.0),
    ]))
    # 2. To Irithyll (east side, beyond boss arena)
    entities.append(make_entity("FogGate", p(2300), p(2100), [
        make_field("dest_area", "String", "Irithyll"),
        make_field("dest_x", "Float", 200.0),
        make_field("dest_y", "Float", 200.0),
        make_field("width", "Float", 40.0),
        make_field("height", "Float", 200.0),
    ]))
    # 3. Boss fog gate (self-referential → triggers boss fight)
    entities.append(make_entity("FogGate", p(2300), p(2100), [
        make_field("dest_area", "String", "SmoulderingLake"),
        make_field("dest_x", "Float", float(p(2700))),
        make_field("dest_y", "Float", float(p(2350))),
        make_field("width", "Float", 40.0),
        make_field("height", "Float", 200.0),
    ]))

    # ===== Lights =====
    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 300, 180, 0.8, 0.7, 0.5, 0.6),
        (800, 900, 250, 1.0, 0.4, 0.1, 0.8),
        (1000, 1100, 200, 0.9, 0.5, 0.2, 0.7),
        (1400, 1600, 180, 0.8, 0.7, 0.5, 0.6),
        (1800, 1900, 180, 0.8, 0.7, 0.5, 0.6),
        (1600, 1750, 150, 1.0, 0.3, 0.1, 0.5),
        (2700, 2350, 200, 1.0, 0.4, 0.1, 0.9),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    return chunk, entities

def make_irithyll_dungeon():
    # Design doc: 3200x2800, 7 sections. Scale S=0.8 to fit 2560x2560.
    S = 0.8
    chunk = new_chunk()
    def t(v): return max(0, min(CHUNK_SIZE - 1, int(v * S) // 16))
    def p(v): return int(v * S)

    # 1. 地下通道入口: (0,0)-(600,600) → tiles (0,0)-(30,30)
    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(600), t(600))
    # 2. 上层牢房区: (500,500)-(1300,1100) → tiles (25,25)-(65,55)
    fill_tiles(chunk, TILE_GROUND, t(500), t(500), t(1300), t(1100))
    # 3. 刑讯室: (1200,900)-(1800,1400) → tiles (60,45)-(90,70)
    fill_tiles(chunk, TILE_GROUND, t(1200), t(900), t(1800), t(1400))
    # 4. 地下水路: (700,1000)-(1300,1800) → tiles (35,50)-(65,90)
    fill_tiles(chunk, TILE_GROUND, t(700), t(1000), t(1300), t(1800))
    # 5. 杰克巴尔多牢房: (1600,1100)-(2000,1500) → tiles (80,55)-(100,75)
    fill_tiles(chunk, TILE_GROUND, t(1600), t(1100), t(2000), t(1500))
    # 6. 下层走廊: (1800,1400)-(2600,1900) → tiles (90,70)-(130,95)
    fill_tiles(chunk, TILE_GROUND, t(1800), t(1400), t(2600), t(1900))
    # 7. 出口通道: (2200,1800)-(3000,2600) → tiles (110,90)-(150,130)
    fill_tiles(chunk, TILE_GROUND, t(2200), t(1800), t(3000), t(2600))
    # Poison in 地下水路 lower portion
    fill_tiles(chunk, TILE_POISON, t(700), t(1400), t(1300), t(1800))
    # Connection corridors for non-overlapping sections
    fill_tiles(chunk, TILE_GROUND, t(90), t(65), t(90), t(75))  # 3→5 corridor
    fill_tiles(chunk, TILE_GROUND, t(100), t(75), t(110), t(90))  # 5→7 corridor

    # ---- Internal walls ----
    # Section 1: Underground passage entrance — narrow stone corridor
    # Walls narrowing the entrance passage to 4-tile wide
    for y in range(t(0), t(400)):
        if y < t(80) or y > t(150):
            chunk[y][t(400)] = TILE_WALL  # east wall
        if y < t(300) or y > t(400):
            chunk[y][t(100)] = TILE_WALL  # west wall
    # Stone debris in entrance
    fill_tiles(chunk, TILE_WALL, t(200), t(200), t(220), t(240))
    fill_tiles(chunk, TILE_WALL, t(350), t(350), t(370), t(380))

    # Section 2: Upper cell block — prison cells with walls and narrow doors
    # Cell walls: N-S dividers creating individual cells, each with a 2-tile door gap
    for cx in [t(650), t(800), t(950), t(1100), t(1200)]:
        for cy in range(t(500), t(1050)):
            # Door gaps at different positions per cell
            if cx == t(650) and t(600) <= cy <= t(620):
                continue
            if cx == t(800) and t(700) <= cy <= t(720):
                continue
            if cx == t(950) and t(580) <= cy <= t(600):
                continue
            if cx == t(1100) and t(750) <= cy <= t(770):
                continue
            if cx == t(1200) and t(650) <= cy <= t(670):
                continue
            if 0 <= cy < CHUNK_SIZE and 0 <= cx < CHUNK_SIZE:
                chunk[cy][cx] = TILE_WALL
    # E-W divider creating two rows of cells
    for ex in range(t(500), t(1300)):
        if t(850) <= ex <= t(870):  # gap
            continue
        if 0 <= t(850) < CHUNK_SIZE and 0 <= ex < CHUNK_SIZE:
            chunk[t(850)][ex] = TILE_WALL
    # Iron bar pillars at cell corners
    for px, py in [(t(650), t(500)), (t(800), t(500)), (t(950), t(500)), (t(1100), t(500)),
                    (t(650), t(1050)), (t(800), t(1050)), (t(950), t(1050)), (t(1100), t(1050))]:
        fill_tiles(chunk, TILE_WALL, px, py, px + 1, py + 1)

    # Section 3: Torture chamber — pillars, racks, cages
    # Central rack structure (large wall block)
    fill_tiles(chunk, TILE_WALL, t(1400), t(1050), t(1550), t(1080))
    fill_tiles(chunk, TILE_WALL, t(1450), t(1000), t(1500), t(1100))
    # Iron cage walls (corner structures)
    fill_tiles(chunk, TILE_WALL, t(1250), t(950), t(1280), t(980))
    fill_tiles(chunk, TILE_WALL, t(1700), t(950), t(1730), t(980))
    fill_tiles(chunk, TILE_WALL, t(1250), t(1300), t(1280), t(1330))
    fill_tiles(chunk, TILE_WALL, t(1700), t(1300), t(1730), t(1330))
    # Chains/pillars along walls
    for px in [t(1300), t(1450), t(1600), t(1750)]:
        fill_tiles(chunk, TILE_WALL, px, t(920), px + 1, t(935))
        fill_tiles(chunk, TILE_WALL, px, t(1350), px + 1, t(1365))

    # Section 4: Underground waterway — broken walls, sewage channels
    # Waterway walls creating narrow channels
    for wy in range(t(1050), t(1750)):
        if t(1200) <= wy <= t(1220):  # gap
            continue
        if 0 <= wy < CHUNK_SIZE:
            chunk[wy][t(750)] = TILE_WALL  # left channel wall
    for wy in range(t(1050), t(1750)):
        if t(1500) <= wy <= t(1520):  # gap
            continue
        if 0 <= wy < CHUNK_SIZE:
            chunk[wy][t(1250)] = TILE_WALL  # right channel wall
    # Broken pillar debris in water
    fill_tiles(chunk, TILE_WALL, t(850), t(1200), t(870), t(1230))
    fill_tiles(chunk, TILE_WALL, t(1050), t(1500), t(1070), t(1530))
    fill_tiles(chunk, TILE_WALL, t(900), t(1600), t(920), t(1630))

    # Section 5: Siegward's cell — small enclosed room with door
    fill_tiles(chunk, TILE_WALL, t(1650), t(1150), t(1950), t(1170))  # north wall
    fill_tiles(chunk, TILE_WALL, t(1650), t(1450), t(1950), t(1470))  # south wall
    fill_tiles(chunk, TILE_WALL, t(1650), t(1150), t(1670), t(1450))  # west wall
    fill_tiles(chunk, TILE_WALL, t(1930), t(1150), t(1950), t(1250))  # east wall top
    fill_tiles(chunk, TILE_WALL, t(1930), t(1350), t(1950), t(1450))  # east wall bottom
    # gap at east wall y:1250-1350 (door)

    # Section 6: Lower passage — corridor with side rooms
    # N-S dividing wall creating narrow corridor
    for ly in range(t(1450), t(1850)):
        if t(1550) <= ly <= t(1570):  # gap
            continue
        if t(1700) <= ly <= t(1720):  # gap
            continue
        if 0 <= ly < CHUNK_SIZE:
            chunk[ly][t(2100)] = TILE_WALL
    # Side room walls
    fill_tiles(chunk, TILE_WALL, t(1900), t(1650), t(2050), t(1670))
    fill_tiles(chunk, TILE_WALL, t(2200), t(1550), t(2350), t(1570))
    # Rubble
    fill_tiles(chunk, TILE_WALL, t(2000), t(1700), t(2020), t(1730))
    fill_tiles(chunk, TILE_WALL, t(2400), t(1800), t(2420), t(1830))

    # Section 7: Exit passage — narrowing corridors, stalactites
    # Stalactite pillars
    for px, py in [(t(2300), t(1900)), (t(2500), t(2000)), (t(2700), t(2100)),
                    (t(2400), t(2200)), (t(2600), t(2400)), (t(2800), t(2300))]:
        fill_tiles(chunk, TILE_WALL, px, py, px + 2, py + 3)
    # Corridor narrowing walls
    for ey in range(t(1900), t(2300)):
        if t(2000) <= ey <= t(2020):
            continue
        if 0 <= ey < CHUNK_SIZE:
            chunk[ey][t(2250)] = TILE_WALL
    for ey in range(t(2200), t(2500)):
        if t(2300) <= ey <= t(2320):
            continue
        if 0 <= ey < CHUNK_SIZE:
            chunk[ey][t(2750)] = TILE_WALL

    entities = []
    entities.append(make_entity("PlayerSpawn", p(200), p(200), [make_field("heal", "Bool", False)]))
    entities.append(make_entity("Bonfire", p(200), p(200)))
    for kind, dx, dy in [("Jailer",500,400),("Jailer",600,500),("Jailer",700,600),
                          ("Jailer",800,550),("Jailer",900,700),("Jailer",1000,650),
                          ("Jailer",1100,800),("Jailer",1200,900),
                          ("Dog",800,1100),("Dog",900,1200),("Dog",1000,1300),
                          ("Gargoyle",1400,1000),("Gargoyle",1600,1100),
                          ("Thrall",600,700),("Thrall",700,800),("Thrall",800,900),
                          ("Thrall",1000,1000),("Thrall",1100,1100),
                          ("PeasantHollow",400,500),("PeasantHollow",500,600),
                          ("CrystalLizard",900,800),("CrystalLizard",2200,1800)]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))
    for kind, dx, dy, val in [("SoulOrb",300,200,500),("SoulOrb",700,500,800),
                               ("SoulOrb",1200,800,1000),("EstusShard",500,400,0),
                               ("SoulOrb",2000,1200,1200),("HomewardBone",900,600,0),
                               ("PurpleMoss",600,700,0)]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb": fields.append(make_field("value", "Int", val))
        entities.append(make_entity("Item", p(dx), p(dy), fields))
    for lk, lv, ln, dx, dy, mimic in [
        ("RingDrop",0,"Deep Ring",600,500,False),
        ("WeaponDrop",0,"Morning Star",900,700,False),
        ("ArmorDrop",0,"Jailer Set",1300,900,False),
        ("RingDrop",0,"Speckled Stoneplate Ring",2000,1400,False),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv), make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))
    for name, color, dialogue, kind, dx, dy in [
        ("卡菈","#9070a0","……你来寻找暗术吗？如果你能找到我的卷轴，我可以教你。","Merchant",1400,1000),
        ("卡塔利纳的杰克巴尔多","#d4a520","哦！又是你！我被关在这个牢房里……能帮我找到钥匙吗？","Dialogue",1700,1200)]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name), make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue), make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))
    for dx, dy, r, cr, cg, cb, intensity in [
        (200,200,180,0.4,0.5,0.7,0.5),(700,500,120,0.5,0.4,0.6,0.3),
        (1100,800,100,0.5,0.4,0.6,0.3),(2000,1400,120,0.4,0.3,0.5,0.25)]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r), make_field("r", "Float", cr),
            make_field("g", "Float", cg), make_field("b", "Float", cb), make_field("intensity", "Float", intensity),
        ]))
    for da, ddx, ddy, dx, dy, w, h in [
        ("Irithyll",200,200,p(50),p(200),40,100),
        ("ProfanedCapital",300,400,p(2800),p(2000),40,100)]:
        entities.append(make_entity("FogGate", dx, dy, [
            make_field("dest_area", "String", da), make_field("dest_x", "Float", float(ddx)),
            make_field("dest_y", "Float", float(ddy)), make_field("width", "Float", float(w)), make_field("height", "Float", float(h)),
        ]))
    return chunk, entities

def make_profaned_capital():
    # Design doc: 3400x3200, 7 sections. Scale S=0.75 to fit 2560x2560.
    S = 0.75
    chunk = new_chunk()
    def t(v): return max(0, min(CHUNK_SIZE - 1, int(v * S) // 16))
    def p(v): return int(v * S)

    # 1. 罪都外围废墟: (0,200)-(800,900) → tiles (0,9)-(37,42)
    fill_tiles(chunk, TILE_GROUND, t(0), t(200), t(800), t(900))
    # 2. 罪业大街: (700,600)-(1500,1200) → tiles (32,28)-(70,56)
    fill_tiles(chunk, TILE_GROUND, t(700), t(600), t(1500), t(1200))
    # 3. 上层遗迹: (600,1100)-(1200,1600) → tiles (28,51)-(56,75)
    fill_tiles(chunk, TILE_GROUND, t(600), t(1100), t(1200), t(1600))
    # 4. 罪业水池: (1400,1000)-(2000,1500) → tiles (65,46)-(93,70)
    fill_tiles(chunk, TILE_GROUND, t(1400), t(1000), t(2000), t(1500))
    # 5. 罪都居住区: (1600,1400)-(2300,2000) → tiles (75,65)-(107,93)
    fill_tiles(chunk, TILE_GROUND, t(1600), t(1400), t(2300), t(2000))
    # 6. 王座大道: (1800,1900)-(2600,2400) → tiles (84,89)-(121,112)
    fill_tiles(chunk, TILE_GROUND, t(1800), t(1900), t(2600), t(2400))
    # 7. 尤姆王座大厅: (1800,2300)-(3000,3000) → tiles (84,107)-(140,140)
    fill_tiles(chunk, TILE_GROUND, t(1800), t(2300), t(3000), t(3000))
    # Poison in 罪业水池
    fill_tiles(chunk, TILE_POISON, t(1400), t(1200), t(2000), t(1500))
    # Connection corridors for non-overlapping sections
    fill_tiles(chunk, TILE_GROUND, t(56), t(75), t(65), t(80))  # 3→4 corridor
    fill_tiles(chunk, TILE_GROUND, t(93), t(65), t(107), t(70))  # 4→5 corridor
    fill_tiles(chunk, TILE_GROUND, t(107), t(93), t(121), t(100))  # 5→6 corridor

    # ---- Boss arena walls (尤姆王座大厅 at tiles 84-140, 107-140) ----
    # North wall with gap at x=100-108
    for x in range(84, 141):
        if x < 100 or x > 108:
            if 0 <= t(2300) - 1 < CHUNK_SIZE:
                chunk[t(2300) - 1][x] = TILE_WALL
    # South wall
    for x in range(84, 141):
        chunk[t(3000) + 1][x] = TILE_WALL if t(3000) + 1 < CHUNK_SIZE else 0
    # West wall with gap at y=115-120
    for y in range(t(2300), t(3000) + 1):
        if y < 115 or y > 120:
            if 0 <= y < CHUNK_SIZE:
                chunk[y][t(1800) - 1] = TILE_WALL
    # East wall
    for y in range(t(2300), t(3000) + 1):
        if 0 <= y < CHUNK_SIZE:
            chunk[y][t(3000) + 1] = TILE_WALL if t(3000) + 1 < CHUNK_SIZE else 0

    # ---- Internal walls ----
    # Section 1: Outer ruins — collapsed city walls creating narrow passages
    # Ruined building walls (creating corridors through the ruins)
    for x in range(t(0), t(300)):
        if x < t(100) or x > t(150):  # gap
            chunk[t(400)][x] = TILE_WALL
    for x in range(t(200), t(600)):
        if x < t(300) or x > t(350):  # gap
            chunk[t(600)][x] = TILE_WALL
    for y in range(t(200), t(500)):
        if y < t(300) or y > t(350):  # gap
            chunk[y][t(400)] = TILE_WALL
    # Collapsed tower ruins
    fill_tiles(chunk, TILE_WALL, t(100), t(300), t(180), t(380))
    fill_tiles(chunk, TILE_WALL, t(500), t(400), t(580), t(500))
    # Rubble piles
    fill_tiles(chunk, TILE_WALL, t(300), t(700), t(380), t(780))
    fill_tiles(chunk, TILE_WALL, t(50), t(700), t(120), t(760))

    # Section 2: Profaned Street — city buildings lining a main road
    # Building walls on north side of street (creating narrow street)
    for x in range(t(750), t(1400)):
        if t(900) <= x <= t(950):  # alley gap
            continue
        chunk[t(680)][x] = TILE_WALL
    # Building walls on south side of street
    for x in range(t(800), t(1300)):
        if t(1050) <= x <= t(1100):  # alley gap
            continue
        chunk[t(1000)][x] = TILE_WALL
    # Individual building blocks (multi-story houses)
    fill_tiles(chunk, TILE_WALL, t(850), t(700), t(900), t(900))    # building 1
    fill_tiles(chunk, TILE_WALL, t(1050), t(700), t(1150), t(900))  # building 2
    fill_tiles(chunk, TILE_WALL, t(1200), t(720), t(1300), t(850))  # building 3
    fill_tiles(chunk, TILE_WALL, t(1350), t(650), t(1400), t(800))  # building corner
    # South side buildings
    fill_tiles(chunk, TILE_WALL, t(1100), t(1020), t(1200), t(1100)) # building S1
    fill_tiles(chunk, TILE_WALL, t(1300), t(950), t(1380), t(1050))  # building S2
    # Street pillars (lamp posts / gargoyles)
    for px, py in [(t(800), t(850)), (t(1000), t(850)), (t(1200), t(850))]:
        fill_tiles(chunk, TILE_WALL, px, py, px + 2, py + 3)

    # Section 3: Upper ruins — stone ruins and staircases
    # Stepped walls creating multi-level terrain
    for x in range(t(600), t(1000)):
        if x < t(700) or x > t(750):  # gap
            chunk[t(1200)][x] = TILE_WALL
    for x in range(t(700), t(1100)):
        if x < t(800) or x > t(850):  # gap
            chunk[t(1400)][x] = TILE_WALL
    # Ruined pillars
    fill_tiles(chunk, TILE_WALL, t(700), t(1150), t(720), t(1200))
    fill_tiles(chunk, TILE_WALL, t(900), t(1300), t(920), t(1350))
    fill_tiles(chunk, TILE_WALL, t(1050), t(1450), t(1070), t(1500))

    # Section 4: Profaned Pool — bridges over poison, ruined platforms
    # Bridge across poison pool (ground on top of walls)
    fill_tiles(chunk, TILE_WALL, t(1500), t(1100), t(1550), t(1200))  # bridge pillar W
    fill_tiles(chunk, TILE_WALL, t(1700), t(1300), t(1800), t(1400))  # bridge pillar E
    # Central island in poison pool
    fill_tiles(chunk, TILE_WALL, t(1600), t(1200), t(1650), t(1230))  # island wall N
    fill_tiles(chunk, TILE_WALL, t(1600), t(1380), t(1650), t(1410))  # island wall S
    fill_tiles(chunk, TILE_WALL, t(1600), t(1230), t(1620), t(1380))  # island wall W
    fill_tiles(chunk, TILE_WALL, t(1630), t(1230), t(1650), t(1380))  # island wall E
    fill_tiles(chunk, TILE_GROUND, t(1620), t(1230), t(1630), t(1380))  # walkable island
    # Submerged walls
    fill_tiles(chunk, TILE_WALL, t(1450), t(1050), t(1500), t(1080))
    fill_tiles(chunk, TILE_WALL, t(1850), t(1400), t(1900), t(1450))

    # Section 5: Dwelling district — residential buildings
    # Building walls creating narrow alleys
    for y in range(t(1500), t(1850)):
        if t(1600) <= y <= t(1650):  # gap
            continue
        chunk[y][t(1800)] = TILE_WALL
    for y in range(t(1400), t(1700)):
        if t(1500) <= y <= t(1550):  # gap
            continue
        chunk[y][t(2000)] = TILE_WALL
    # House blocks
    fill_tiles(chunk, TILE_WALL, t(1700), t(1500), t(1750), t(1650))
    fill_tiles(chunk, TILE_WALL, t(1900), t(1550), t(1980), t(1700))
    fill_tiles(chunk, TILE_WALL, t(2050), t(1450), t(2150), t(1600))
    fill_tiles(chunk, TILE_WALL, t(2150), t(1700), t(2250), t(1850))

    # Section 6: Throne Approach — grand avenue with columns
    # Avenue walls creating grand approach to Yhorm
    for y in range(t(1950), t(2300)):
        if t(2050) <= y <= t(2100):  # gap
            continue
        chunk[y][t(1900)] = TILE_WALL  # left avenue wall
    for y in range(t(1950), t(2300)):
        if t(2050) <= y <= t(2100):  # gap
            continue
        chunk[y][t(2500)] = TILE_WALL  # right avenue wall
    # Grand columns along approach
    for px, py in [(t(2000), t(2000)), (t(2200), t(2100)), (t(2400), t(2200)),
                    (t(2000), t(2200)), (t(2200), t(2250)), (t(2400), t(2350))]:
        fill_tiles(chunk, TILE_WALL, px, py, px + 2, py + 3)

    # Section 7: Yhorm's Throne Hall — arena with throne and debris
    # Throne structure (large wall block at far end)
    fill_tiles(chunk, TILE_WALL, t(2300), t(2700), t(2700), t(2750))  # throne base
    fill_tiles(chunk, TILE_WALL, t(2350), t(2750), t(2650), t(2800))  # throne seat
    fill_tiles(chunk, TILE_WALL, t(2400), t(2600), t(2600), t(2700))  # throne back
    # Storm Ruler monument (central feature)
    fill_tiles(chunk, TILE_WALL, t(2300), t(2500), t(2350), t(2600))  # monument
    # Debris scattered in arena
    fill_tiles(chunk, TILE_WALL, t(2000), t(2500), t(2050), t(2580))
    fill_tiles(chunk, TILE_WALL, t(2600), t(2500), t(2670), t(2570))
    fill_tiles(chunk, TILE_WALL, t(2100), t(2800), t(2180), t(2870))
    fill_tiles(chunk, TILE_WALL, t(2700), t(2750), t(2780), t(2830))
    # Corner pillars
    fill_tiles(chunk, TILE_WALL, t(1900), t(2400), t(1920), t(2440))
    fill_tiles(chunk, TILE_WALL, t(2800), t(2400), t(2820), t(2440))
    fill_tiles(chunk, TILE_WALL, t(1900), t(2900), t(1920), t(2940))
    fill_tiles(chunk, TILE_WALL, t(2800), t(2900), t(2820), t(2940))

    entities = []
    entities.append(make_entity("PlayerSpawn", p(200), p(400), [make_field("heal", "Bool", False)]))
    entities.append(make_entity("Bonfire", p(200), p(400)))
    entities.append(make_entity("BossSpawn", p(2400), p(2600)))
    for kind, dx, dy in [("Gargoyle",500,400),("Gargoyle",600,500),("Gargoyle",800,400),
                          ("Gargoyle",1000,600),("Gargoyle",1200,700),
                          ("Gargoyle",1400,900),("Gargoyle",1600,1000),
                          ("Jailer",900,700),("Jailer",1100,800),
                          ("Thrall",400,600),("Thrall",500,700),("Thrall",700,800),
                          ("Thrall",1300,900),("Thrall",1500,1000),
                          ("ManGrub",1000,800),("ManGrub",1200,900),("ManGrub",1400,1100),
                          ("CrystalLizard",800,500)]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))
    for kind, dx, dy, val in [("SoulOrb",300,400,500),("SoulOrb",700,600,800),
                               ("SoulOrb",1100,800,1000),("SoulOrb",1800,1200,1500),
                               ("EstusShard",600,500,0),("HomewardBone",1000,700,0)]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb": fields.append(make_field("value", "Int", val))
        entities.append(make_entity("Item", p(dx), p(dy), fields))
    for lk, lv, ln, dx, dy, mimic in [
        ("WeaponDrop",0,"Gargoyle Flame Hammer",900,700,False),
        ("RingDrop",0,"Skull Ring",1300,900,False),
        ("ArmorDrop",0,"Alva Set",1600,1100,False),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv), make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))
    for name, color, dialogue, kind, dx, dy in [
        ("卡塔利纳的杰克巴尔多","#d4a520","我的老朋友……他一定在等着我。尤姆！让我来帮你！","Dialogue",1700,1500)]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name), make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue), make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))
    for dx, dy, r, cr, cg, cb, intensity in [
        (200,400,180,0.9,0.6,0.3,0.5),(700,600,120,0.8,0.5,0.2,0.3),
        (1200,900,150,0.9,0.5,0.2,0.4),(2400,2600,250,0.9,0.4,0.1,0.6)]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r), make_field("r", "Float", cr),
            make_field("g", "Float", cg), make_field("b", "Float", cb), make_field("intensity", "Float", intensity),
        ]))
    for da, ddx, ddy, dx, dy, w, h in [
        ("IrithyllDungeon",300,300,p(50),p(600),40,100)]:
        entities.append(make_entity("FogGate", dx, dy, [
            make_field("dest_area", "String", da), make_field("dest_x", "Float", float(ddx)),
            make_field("dest_y", "Float", float(ddy)), make_field("width", "Float", float(w)), make_field("height", "Float", float(h)),
        ]))
    # Boss fog gate
    entities.append(make_entity("FogGate", p(2300), p(2500), [
        make_field("dest_area", "String", "ProfanedCapital"),
        make_field("dest_x", "Float", float(p(2400))),
        make_field("dest_y", "Float", float(p(2600))),
        make_field("width", "Float", 40.0),
        make_field("height", "Float", 200.0),
    ]))
    return chunk, entities

def make_anor_londo():
    S = 0.9
    chunk = new_chunk()
    def t(v): return max(0, min(159, int(v * S) // 16))
    def p(v): return int(v * S)

    # Design doc: 2800x2000, 7 sections. Scale to 2560×2560.
    # Section 1: 大教堂入口厅 (100,200)-(600,600)
    fill_tiles(chunk, TILE_GROUND, t(100), t(200), t(600), t(600))
    # Section 2: 王城大道 (500,400)-(1200,900)
    fill_tiles(chunk, TILE_GROUND, t(500), t(400), t(1200), t(900))
    # Section 3: 隐形平台区域 (750,300)-(1150,600)
    fill_tiles(chunk, TILE_GROUND, t(750), t(300), t(1150), t(600))
    # Section 4: 约尔夏教会 (850,500)-(1150,800)
    fill_tiles(chunk, TILE_GROUND, t(850), t(500), t(1150), t(800))
    # Section 5: 银骑士大厅 (1200,600)-(1800,1000)
    fill_tiles(chunk, TILE_GROUND, t(1200), t(600), t(1800), t(1000))
    # Section 6: 阶梯走廊 (1700,800)-(2200,1300)
    fill_tiles(chunk, TILE_GROUND, t(1700), t(800), t(2200), t(1300))
    # Section 7: 暗月神殿 Boss arena (1900,1200)-(2600,1700)
    fill_tiles(chunk, TILE_GROUND, t(1900), t(1200), t(2600), t(1700))
    # ---- Boss arena walls (Section 7: 暗月神殿) ----
    # Arena: t(1900)=106 to t(2600)=146 x, t(1200)=67 to t(1700)=95 y
    # North wall with gap for corridor entry
    for x in range(t(1900), t(2600) + 1):
        if x < t(2050) or x > t(2150):
            if 0 <= t(1200) - 1 < CHUNK_SIZE:
                chunk[t(1200) - 1][x] = TILE_WALL
    # South wall
    for x in range(t(1900), t(2600) + 1):
        chunk[t(1700) + 1][x] = TILE_WALL
    # West wall with gap
    for y in range(t(1200), t(1700) + 1):
        if y < t(1350) or y > t(1500):
            chunk[y][t(1900) - 1] = TILE_WALL
    # East wall with gap for FogGate
    for y in range(t(1200), t(1700) + 1):
        if y < t(1400) or y > t(1500):
            chunk[y][t(2600) + 1] = TILE_WALL
    # Ground extension to reach east FogGate
    fill_tiles(chunk, TILE_GROUND, t(2600), t(1400), t(2600) + 5, t(1500))

    # ---- Section boundary walls ----
    # Section 1 (entrance) west wall, gap for entry from Irithyll
    for y in range(t(200), t(600) + 1):
        if y < t(300) or y > t(400):
            chunk[y][t(100) - 1] = TILE_WALL

    # Section 2 (avenue) south wall, gap at x=t(600)-t(700)
    for x in range(t(500), t(1200) + 1):
        if x < t(600) or x > t(700):
            chunk[t(900) + 1][x] = TILE_WALL

    # Section 3 (invisible platforms) — narrow paths with wall obstacles
    for x in range(t(750), t(1150) + 1):
        if x < t(850) or x > t(900):
            chunk[t(300) - 1][x] = TILE_WALL
    # Internal wall obstacles for narrow path feel
    for wx, wy in [(t(800), t(350)), (t(900), t(400)), (t(1000), t(350)), (t(1050), t(450))]:
        if 0 <= wy < CHUNK_SIZE and 0 <= wx < CHUNK_SIZE:
            chunk[wy][wx] = TILE_WALL

    # ===== HAND-CRAFTED ARCHITECTURAL DETAIL =====

    # ---- Section 1: 大教堂入口厅 (Cathedral Entrance Hall) ----
    # DS3: Grand stone entrance with arched doorway, flanking pillars
    # Entrance arch (west side, gap at y:17-22 for entry from Irithyll)
    fill_tiles(chunk, TILE_WALL, t(100), t(200), t(130), t(250))   # NW pillar
    fill_tiles(chunk, TILE_WALL, t(100), t(400), t(130), t(450))   # SW pillar
    # Interior colonnade — rows of pillars
    for py in [t(300), t(400), t(500)]:
        fill_tiles(chunk, TILE_WALL, t(200), py, t(220), py + 4)
        fill_tiles(chunk, TILE_WALL, t(450), py, t(470), py + 4)
    # Altar at east end
    fill_tiles(chunk, TILE_WALL, t(500), t(350), t(560), t(370))
    # Pews (low walls)
    fill_tiles(chunk, TILE_WALL, t(250), t(300), t(260), t(360))
    fill_tiles(chunk, TILE_WALL, t(250), t(400), t(260), t(460))

    # ---- Section 2: 王城大道 (Royal Avenue) ----
    # DS3: Grand avenue lined with columns, leading to the great hall
    # Column rows along the avenue
    for py in [t(500), t(600), t(700), t(800)]:
        fill_tiles(chunk, TILE_WALL, t(550), py, t(570), py + 3)
        fill_tiles(chunk, TILE_WALL, t(1100), py, t(1120), py + 3)
    # Central divider (low wall with gaps)
    for py in range(t(550), t(850)):
        if py < t(600) or py > t(650):
            if py < t(720) or py > t(770):
                chunk[py][t(800)] = TILE_WALL
                if t(801) < CHUNK_SIZE:
                    chunk[py][t(801)] = TILE_WALL
    # Broken wall segment (ruined section)
    fill_tiles(chunk, TILE_WALL, t(900), t(450), t(950), t(470))

    # ---- Section 4: 约尔夏教会 (Yorshka's Church) ----
    # DS3: Small church interior with altar, pews, side chapel
    # Church walls
    for x in range(t(850), t(1150) + 1):
        if x < t(920) or x > t(970):  # entrance gap
            chunk[t(500)][x] = TILE_WALL
    # South wall
    for x in range(t(850), t(1150) + 1):
        if x < t(950) or x > t(1000):  # exit gap
            chunk[t(800)][x] = TILE_WALL
    # West wall with gap
    for y in range(t(500), t(800) + 1):
        if y < t(620) or y > t(680):
            chunk[y][t(850)] = TILE_WALL
    # East wall with gap
    for y in range(t(500), t(800) + 1):
        if y < t(620) or y > t(680):
            chunk[y][t(1150)] = TILE_WALL
    # Altar at north end
    fill_tiles(chunk, TILE_WALL, t(960), t(520), t(1040), t(540))
    # Pew rows
    fill_tiles(chunk, TILE_WALL, t(880), t(580), t(890), t(640))
    fill_tiles(chunk, TILE_WALL, t(1110), t(580), t(1120), t(640))
    fill_tiles(chunk, TILE_WALL, t(880), t(690), t(890), t(750))
    fill_tiles(chunk, TILE_WALL, t(1110), t(690), t(1120), t(750))

    # ---- Section 5: 银骑士大厅 (Silver Knight Great Hall) ----
    # DS3: Grand hall with rows of massive columns, dark atmosphere
    # Grand column rows (2x4 pillars)
    for px in [t(1250), t(1400), t(1550), t(1700)]:
        for py in [t(650), t(850)]:
            fill_tiles(chunk, TILE_WALL, px, py, px + 3, py + 4)
    # South wall line (broken, with gaps)
    for x in range(t(1200), t(1800) + 1):
        if x < t(1300) or x > t(1350):
            if x < t(1500) or x > t(1550):
                if x < t(1650) or x > t(1700):
                    chunk[t(1000)][x] = TILE_WALL
    # North wall line
    for x in range(t(1200), t(1800) + 1):
        if x < t(1400) or x > t(1550):
            chunk[t(600)][x] = TILE_WALL
    # Throne debris at east end
    fill_tiles(chunk, TILE_WALL, t(1750), t(700), t(1780), t(750))

    # ---- Section 6: 阶梯走廊 (Grand Staircase Corridor) ----
    # DS3: Wide stone staircase leading to the boss chamber
    # West staircase wall
    for y in range(t(800), t(1300) + 1):
        if y < t(900) or y > t(1000):
            if 0 <= y < CHUNK_SIZE and t(1700) - 1 >= 0:
                chunk[y][t(1700) - 1] = TILE_WALL
    # East wall
    for y in range(t(800), t(1300) + 1):
        if y < t(1000) or y > t(1100):
            if 0 <= y < CHUNK_SIZE:
                chunk[y][t(2200) + 1] = TILE_WALL
    # Step walls (creating tiered staircase feel)
    for x in range(t(1700), t(2200) + 1):
        if x < t(1800) or x > t(1900):
            if 0 <= t(1050) < CHUNK_SIZE and 0 <= x < CHUNK_SIZE:
                chunk[t(1050)][x] = TILE_WALL
    # Second step
    for x in range(t(1750), t(2150) + 1):
        if x < t(1850) or x > t(1950):
            if 0 <= t(1150) < CHUNK_SIZE and 0 <= x < CHUNK_SIZE:
                chunk[t(1150)][x] = TILE_WALL
    # Flanking pillars on staircase
    fill_tiles(chunk, TILE_WALL, t(1720), t(900), t(1730), t(930))
    fill_tiles(chunk, TILE_WALL, t(2170), t(900), t(2180), t(930))

    # Boss arena internal pillars and throne debris
    for px, py in [(t(2000), t(1300)), (t(2100), t(1300)), (t(2300), t(1300)),
                   (t(2000), t(1500)), (t(2200), t(1550)), (t(2400), t(1400))]:
        if 0 <= py < CHUNK_SIZE and 0 <= px < CHUNK_SIZE:
            chunk[py][px] = TILE_WALL
    # Boss chamber: Gwyndolin's throne structure
    fill_tiles(chunk, TILE_WALL, t(2200), t(1600), t(2300), t(1630))  # throne base
    fill_tiles(chunk, TILE_WALL, t(2220), t(1550), t(2280), t(1600))  # throne back
    # Altar at center
    fill_tiles(chunk, TILE_WALL, t(2150), t(1450), t(2200), t(1470))

    # ---- 深渊沼泽 (Poison in boss arena lower portion) ----
    for y in range(t(1500), t(1700) + 1):
        for x in range(t(1900), t(2600) + 1):
            if 0 <= y < CHUNK_SIZE and 0 <= x < CHUNK_SIZE:
                if chunk[y][x] == TILE_GROUND:
                    chunk[y][x] = TILE_POISON

    entities = []
    entities.append(make_entity("PlayerSpawn", p(200), p(350), [make_field("heal", "Bool", False)]))
    entities.append(make_entity("Bonfire", p(200), p(350)))
    entities.append(make_entity("BossSpawn", p(2250), p(1450)))
    for kind, dx, dy in [
        ("SilverKnight", 350, 350), ("SilverKnight", 500, 400), ("SilverKnight", 550, 500),
        ("SilverKnight", 700, 600), ("SilverKnight", 750, 650), ("SilverKnight", 800, 550),
        ("Deacon", 850, 600), ("Deacon", 900, 650), ("Deacon", 950, 700),
        ("DeepAccursed", 1050, 700), ("SilverKnight", 1300, 700), ("SilverKnight", 1400, 800),
        ("SilverKnight", 1500, 750),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))
    for kind, dx, dy, val in [
        ("SoulOrb", 300, 350, 600), ("SoulOrb", 600, 500, 1000),
        ("SoulOrb", 900, 600, 1200), ("SoulOrb", 1500, 800, 1500),
        ("EstusShard", 500, 450, 0), ("HomewardBone", 700, 600, 0),
        ("SoulOrb", 300, 250, 500), ("SoulOrb", 800, 450, 400),
        ("EstusShard", 1100, 650, 0), ("SoulOrb", 1800, 900, 600),
        ("HomewardBone", 600, 800, 0), ("PurpleMoss", 2000, 1400, 0),
        ("SoulOrb", 2200, 1200, 500),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb": fields.append(make_field("value", "Int", val))
        entities.append(make_entity("Item", p(dx), p(dy), fields))
    entities.append(make_entity("Item", p(1000), p(350), [
        make_field("kind", "LocalEnum.ItemKind", "RingDrop"),
        make_field("name", "String", "Leo Ring"),
    ]))
    for lk, lv, ln, dx, dy, mimic in [
        ("RingDrop", 0, "Sun's First Born Ring", 450, 400, False),
        ("RingDrop", 0, "Silver Serpent Ring", 700, 600, False),
        ("ArmorDrop", 0, "Dark Set", 1200, 900, False),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv), make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))
    for dx, dy, r, cr, cg, cb, intensity in [
        (200, 350, 180, 0.9, 0.8, 0.5, 0.6), (600, 500, 180, 0.9, 0.8, 0.5, 0.5),
        (1000, 650, 150, 0.8, 0.7, 0.4, 0.4), (2250, 1450, 250, 0.9, 0.7, 0.3, 0.6),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r), make_field("r", "Float", cr),
            make_field("g", "Float", cg), make_field("b", "Float", cb), make_field("intensity", "Float", intensity),
        ]))
    for da, ddx, ddy, dx, dy, w, h in [
        ("Irithyll", 200, 350, p(50), p(350), 40, 100),
        ("LothricCastle", 200, 400, p(2450), p(1400), 40, 100),
    ]:
        entities.append(make_entity("FogGate", dx, dy, [
            make_field("dest_area", "String", da), make_field("dest_x", "Float", float(ddx)),
            make_field("dest_y", "Float", float(ddy)), make_field("width", "Float", float(w)), make_field("height", "Float", float(h)),
        ]))
    for name, color, dialogue, kind, dx, dy in [
        ("骑士团团长幽儿希卡", "#d0c0e0", "哦，是你啊……欢迎来到这个冰冷的世界。", "Dialogue", 950, 600),
        ("无光之地的希里斯", "#a0b0c0", "……我能感受到你的善意。让我们一起战斗。", "Dialogue", 600, 500),
        ("亚斯特拉的安里", "#c0d0e0", "我一直在寻找霍拉斯……你能帮我吗？", "Dialogue", 800, 700),
        ("指环指·雷奥纳德", "#404040", "指环的意义……你明白吗？", "Dialogue", 2000, 1200),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name), make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue), make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))
    # Boss fog gate
    entities.append(make_entity("FogGate", p(2100), p(1300), [
        make_field("dest_area", "String", "AnorLondo"),
        make_field("dest_x", "Float", float(p(2250))),
        make_field("dest_y", "Float", float(p(1450))),
        make_field("width", "Float", 40.0),
        make_field("height", "Float", 200.0),
    ]))
    return chunk, entities

def make_lothric_castle():
    chunk = new_chunk()
    entities = []

    # Design doc: 4000×3200, 6 sections
    # Scale to fit 2560×2560: S=0.65
    S = 0.65
    def t(v): return max(0, min(CHUNK_SIZE - 1, int(v * S) // 16))
    def p(v): return int(v * S)

    # ===== Terrain: 6 sections from LothricCastle.json =====
    # 1. 城堡正门: (0,0)-(800,1000) → tiles (0,0)-(32,40)
    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(800), t(1000))
    # 2. 外城回廊: (800,200)-(1600,1000) → tiles (32,8)-(65,40)
    fill_tiles(chunk, TILE_GROUND, t(800), t(200), t(1600), t(1000))
    # 3. 龙营: (1400,100)-(2400,800) → tiles (57,4)-(97,32)
    fill_tiles(chunk, TILE_GROUND, t(1400), t(100), t(2400), t(800))
    # 4. 内城阶梯: (2200,600)-(2800,1400) → tiles (89,24)-(113,56)
    fill_tiles(chunk, TILE_GROUND, t(2200), t(600), t(2800), t(1400))
    # 5. 城墙大桥: (2800,1000)-(3800,1800) → tiles (113,40)-(154,73)
    fill_tiles(chunk, TILE_GROUND, t(2800), t(1000), t(3800), t(1800))
    # 6. 王城花园入口: (1000,900)-(1400,1300) → tiles (40,36)-(56,52)
    fill_tiles(chunk, TILE_GROUND, t(1000), t(900), t(1400), t(1300))
    # ===== Section 5: Boss arena walls (城墙大桥 at tiles 113-154, 40-73) =====
    # North wall with entrance gap (tiles 120-124) connecting from 内城阶梯
    for x in range(113, 155):
        if x < 120 or x > 124:
            if 0 <= x < CHUNK_SIZE:
                chunk[40][x] = TILE_WALL
    # West wall with gap (y=42-46) for entry from 内城阶梯
    for y in range(40, 74):
        if y < 42 or y > 46:
            if 0 <= y < CHUNK_SIZE:
                chunk[y][112] = TILE_WALL
    # East wall
    for y in range(40, 74):
        if 0 <= y < CHUNK_SIZE:
            chunk[y][154] = TILE_WALL
    # South wall
    for x in range(113, 155):
        if 0 <= x < CHUNK_SIZE:
            chunk[73][x] = TILE_WALL

    # ===== Internal walls: castle architecture =====

    # Section 1: main gate — archway walls, statues, dragon skeletons
    fill_tiles(chunk, TILE_WALL, 12, 8, 13, 14)    # gate pillar left
    fill_tiles(chunk, TILE_WALL, 28, 8, 29, 14)    # gate pillar right
    fill_tiles(chunk, TILE_WALL, 20, 18, 21, 22)   # knight statue
    fill_tiles(chunk, TILE_WALL, 8, 15, 9, 20)     # left approach wall
    fill_tiles(chunk, TILE_WALL, 32, 12, 33, 18)   # right approach wall
    fill_tiles(chunk, TILE_WALL, 15, 24, 16, 27)   # stone bench
    fill_tiles(chunk, TILE_WALL, 25, 26, 26, 28)   # dragon skeleton

    # Section 2: outer gallery — stone columns, arrow slits
    fill_tiles(chunk, TILE_WALL, 38, 16, 39, 20)   # column
    fill_tiles(chunk, TILE_WALL, 48, 16, 49, 20)   # column
    fill_tiles(chunk, TILE_WALL, 58, 16, 59, 20)   # column
    # Gallery divider wall
    for x in range(35, 55):
        if x < 40 or x > 46:
            chunk[24][x] = TILE_WALL
    fill_tiles(chunk, TILE_WALL, 33, 30, 34, 34)   # alcove wall
    fill_tiles(chunk, TILE_WALL, 55, 28, 56, 32)   # pillar base

    # Section 3: dragon barracks — burnt structures, tents
    fill_tiles(chunk, TILE_WALL, 62, 8, 63, 14)    # burnt wall
    fill_tiles(chunk, TILE_WALL, 72, 10, 73, 16)   # burnt wall
    fill_tiles(chunk, TILE_WALL, 82, 6, 83, 12)    # rubble
    fill_tiles(chunk, TILE_WALL, 65, 15, 66, 18)   # tent frame
    fill_tiles(chunk, TILE_WALL, 76, 18, 77, 22)   # tent frame
    fill_tiles(chunk, TILE_WALL, 68, 20, 69, 23)   # dragon nest
    fill_tiles(chunk, TILE_WALL, 85, 14, 86, 18)   # scorched wall

    # Section 4: inner castle stairs — spiral staircase, lookout
    fill_tiles(chunk, TILE_WALL, 95, 28, 96, 34)   # stair wall
    fill_tiles(chunk, TILE_WALL, 105, 30, 106, 36)  # stair wall
    fill_tiles(chunk, TILE_WALL, 98, 40, 99, 44)   # balustrade
    fill_tiles(chunk, TILE_WALL, 108, 28, 109, 32)  # column base (moved from path)
    fill_tiles(chunk, TILE_WALL, 92, 44, 93, 48)   # arch fragment
    fill_tiles(chunk, TILE_WALL, 108, 48, 109, 52)  # look-out post

    # Section 5: boss arena (城墙大桥) — bridge features
    fill_tiles(chunk, TILE_WALL, 120, 48, 121, 54)  # bridge parapet
    fill_tiles(chunk, TILE_WALL, 140, 52, 141, 58)  # broken wall
    fill_tiles(chunk, TILE_WALL, 130, 60, 131, 66)  # rubble pile
    fill_tiles(chunk, TILE_WALL, 148, 44, 149, 50)  # pillar
    fill_tiles(chunk, TILE_WALL, 115, 55, 116, 60)  # stone barrier

    # Section 6: garden entrance — hidden path, fountain
    fill_tiles(chunk, TILE_WALL, 42, 40, 43, 44)   # vine-covered wall
    fill_tiles(chunk, TILE_WALL, 50, 44, 51, 48)   # ruined fountain

    # ===== Player spawn & bonfires =====
    entities.append(make_entity("PlayerSpawn", p(200), p(300), [make_field("heal", "Bool", False)]))
    entities.append(make_entity("Bonfire", p(200), p(300)))    # 城堡正门篝火
    entities.append(make_entity("Bonfire", p(3800), p(1500)))  # 大书库篝火

    # ===== Boss: Dragonslayer Armour =====
    entities.append(make_entity("BossSpawn", p(3300), p(1400)))
    # ===== Enemies from design doc =====
    for kind, dx, dy, count in [
        ("LothricKnight", 200, 300, 2),
        ("HollowSoldier", 500, 400, 3),
        ("LothricKnight", 900, 300, 2),
        ("WingedKnight", 1400, 200, 1),
        ("WingedKnight", 1900, 400, 1),
        ("HollowSoldier", 2300, 700, 2),
        ("PusOfMan", 1800, 300, 1),
        ("Assassin", 1200, 500, 2),
        ("CrystalLizard", 600, 600, 1),
        ("LothricKnight", 2500, 1000, 1),
        ("HollowSoldier", 3000, 1200, 3),
        ("WingedKnight", 3400, 1400, 1),
        ("CrystalLizard", 1600, 500, 1),
    ]:
        for i in range(count):
            ox = (i * 24) % 48 - 24
            oy = (i * 18) % 36 - 18
            entities.append(make_entity("Enemy", p(dx) + ox, p(dy) + oy, [
                make_field("kind", "LocalEnum.EnemyKind", kind),
            ]))

    # ===== Items =====
    for kind, dx, dy, extra in [
        ("SoulOrb", 300, 300, [("value", "Int", 800)]),
        ("SoulOrb", 700, 500, [("value", "Int", 1000)]),
        ("SoulOrb", 1100, 400, [("value", "Int", 1200)]),
        ("SoulOrb", 2600, 900, [("value", "Int", 1500)]),
        ("EstusShard", 500, 350, []),
        ("HomewardBone", 1500, 600, []),
        ("WeaponDrop", 900, 700, [("name", "String", "洛斯里克骑士剑")]),
        ("TitaniteShard", 2300, 800, [("name", "String", "楔形石碎片")]),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        for fname, ftype, fval in extra:
            fields.append(make_field(fname, ftype, fval))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    # ===== Chests =====
    for dx, dy, lk, lv, ln, mimic in [
        (500, 500, "WeaponDrop", 0, "洛斯里克骑士剑", False),
        (700, 600, "RingDrop", 0, "猎手戒指", False),
        (1000, 400, "ArmorDrop", 0, "洛斯里克骑士套装", False),
        (1600, 500, "WeaponDrop", 0, "大龙牙", True),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv), make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    # ===== Lights =====
    for dx, dy, r, cr, cg, cb, intensity in [
        (200, 300, 180, 0.8, 0.7, 0.5, 0.6),
        (1000, 300, 150, 0.8, 0.7, 0.5, 0.4),
        (1800, 400, 150, 0.8, 0.7, 0.5, 0.4),
        (3300, 1400, 250, 0.8, 0.7, 0.5, 0.5),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r), make_field("r", "Float", cr),
            make_field("g", "Float", cg), make_field("b", "Float", cb), make_field("intensity", "Float", intensity),
        ]))

    # ===== Fog gates =====
    # To LothricWall (return)
    entities.append(make_entity("FogGate", p(100), p(500), [
        make_field("dest_area", "String", "LothricWall"),
        make_field("dest_x", "Float", 240.0),
        make_field("dest_y", "Float", 240.0),
        make_field("width", "Float", 40.0),
        make_field("height", "Float", 100.0),
    ]))
    # Boss fog gate — Dragonslayer Armour (self-referential)
    entities.append(make_entity("FogGate", p(3200), p(1000), [
        make_field("dest_area", "String", "LothricCastle"),
        make_field("dest_x", "Float", float(p(3300))),
        make_field("dest_y", "Float", float(p(1400))),
        make_field("width", "Float", 80.0),
        make_field("height", "Float", 32.0),
    ]))
    # To GrandArchives (after boss)
    entities.append(make_entity("FogGate", p(3800), p(1500), [
        make_field("dest_area", "String", "GrandArchives"),
        make_field("dest_x", "Float", 300.0),
        make_field("dest_y", "Float", 400.0),
        make_field("width", "Float", 40.0),
        make_field("height", "Float", 100.0),
    ]))
    # To ConsumedKingsGarden (garden entrance)
    entities.append(make_entity("FogGate", p(1300), p(1100), [
        make_field("dest_area", "String", "ConsumedKingsGarden"),
        make_field("dest_x", "Float", 300.0),
        make_field("dest_y", "Float", 400.0),
        make_field("width", "Float", 40.0),
        make_field("height", "Float", 100.0),
    ]))

    # ===== NPCs =====
    for name, kind, dx, dy, color, dialogue in [
        ("艾玛", "Dialogue", 800, 500, "#c0a0d0",
         "洛斯里克的王子……已经不会醒来了。"),
        ("葛雷瑞特", "Merchant", 600, 400, "#806040",
         "我又出去了……这次找到了不少好东西。"),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name), make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue), make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))
    return chunk, entities

def make_grand_archives():
    chunk = new_chunk()
    entities = []

    # Design doc: 3600×4000, 7 sections
    # Scale to fit 2560×2560: S=0.6
    S = 0.6
    def t(v): return max(0, min(CHUNK_SIZE - 1, int(v * S) // 16))
    def p(v): return int(v * S)

    # ===== Terrain: 7 sections from GrandArchives.json =====
    # 1. 书库入口大厅: (0,0)-(800,800) → tiles (0,0)-(30,30)
    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(800), t(800))
    # 2. 第一层书廊: (800,200)-(1800,900) → tiles (30,7)-(67,33)
    fill_tiles(chunk, TILE_GROUND, t(800), t(200), t(1800), t(900))
    # 3. 蜡池大厅: (600,900)-(1400,1500) → tiles (22,33)-(52,56)
    fill_tiles(chunk, TILE_GROUND, t(600), t(900), t(1400), t(1500))
    # 4. 学者塔楼: (1400,700)-(2000,1500) → tiles (52,26)-(75,56)
    fill_tiles(chunk, TILE_GROUND, t(1400), t(700), t(2000), t(1500))
    # 5. 翼骑士走廊: (1000,1500)-(1800,2000) → tiles (37,56)-(67,75)
    fill_tiles(chunk, TILE_GROUND, t(1000), t(1500), t(1800), t(2000))
    # 6. 石像鬼屋顶: (1200,2000)-(2000,2600) → tiles (45,75)-(75,97)
    fill_tiles(chunk, TILE_GROUND, t(1200), t(2000), t(2000), t(2600))
    # 7. 王子宫殿: (1400,2800)-(2200,3600) → tiles (52,105)-(82,135)
    fill_tiles(chunk, TILE_GROUND, t(1400), t(2800), t(2200), t(3600))

    # ===== Corridor connections =====
    # 石像鬼屋顶 → 王子宫殿: stairs from (45,75) area down to (52,105) area
    fill_tiles(chunk, TILE_GROUND, 52, 97, 75, 110)

    # ===== Boss arena walls (王子宫殿 at tiles 52-82, 105-135) =====
    # North wall with entrance gap (tiles 60-65 open)
    for x in range(52, 83):
        if x < 60 or x > 65:
            if 0 <= x < CHUNK_SIZE:
                chunk[105][x] = TILE_WALL
    # West wall
    for y in range(105, 136):
        if 0 <= y < CHUNK_SIZE:
            chunk[y][51] = TILE_WALL
    # East wall
    for y in range(105, 136):
        if 0 <= y < CHUNK_SIZE:
            chunk[y][82] = TILE_WALL
    # South wall
    for x in range(52, 83):
        if 0 <= x < CHUNK_SIZE:
            chunk[135][x] = TILE_WALL

    # ===== Internal walls =====
    # Section 1: entrance hall — grand library entrance with bookshelf walls
    # Tall bookshelf walls lining entrance hall
    fill_tiles(chunk, TILE_WALL, 5, 5, 6, 18)      # bookshelf wall W
    fill_tiles(chunk, TILE_WALL, 10, 8, 11, 15)    # bookshelf N
    fill_tiles(chunk, TILE_WALL, 22, 8, 23, 15)    # bookshelf N
    fill_tiles(chunk, TILE_WALL, 28, 5, 29, 18)    # bookshelf wall E
    fill_tiles(chunk, TILE_WALL, 28, 20, 29, 26)   # bookshelf SE
    fill_tiles(chunk, TILE_WALL, 15, 20, 16, 26)   # bookshelf SW
    fill_tiles(chunk, TILE_WALL, 7, 18, 8, 21)     # reading desk
    fill_tiles(chunk, TILE_WALL, 25, 10, 26, 13)   # candle cluster
    # E-W divider creating reading room vs corridor
    for x in range(5, 28):
        if x < 12 or x > 18:  # gap
            chunk[19][x] = TILE_WALL
    # Entrance arch pillars
    fill_tiles(chunk, TILE_WALL, 12, 0, 13, 3)
    fill_tiles(chunk, TILE_WALL, 18, 0, 19, 3)

    # Section 2: book gallery — DENSE bookshelf rows creating narrow aisles
    # Long bookshelf rows (library stacks) running N-S
    fill_tiles(chunk, TILE_WALL, 32, 10, 33, 25)   # tall bookshelf row 1
    fill_tiles(chunk, TILE_WALL, 36, 8, 37, 20)    # tall bookshelf row 2
    fill_tiles(chunk, TILE_WALL, 40, 10, 41, 25)   # tall bookshelf row 3
    fill_tiles(chunk, TILE_WALL, 44, 8, 45, 20)    # tall bookshelf row 4
    fill_tiles(chunk, TILE_WALL, 48, 10, 49, 25)   # tall bookshelf row 5
    fill_tiles(chunk, TILE_WALL, 55, 10, 56, 25)   # tall bookshelf row 6
    fill_tiles(chunk, TILE_WALL, 60, 8, 61, 20)    # tall bookshelf row 7
    fill_tiles(chunk, TILE_WALL, 65, 10, 66, 25)   # tall bookshelf row 8
    # E-W bookshelf divider creating reading alcoves
    for x in range(30, 50):
        if x < 35 or x > 40:
            chunk[24][x] = TILE_WALL
    # Second E-W divider
    for x in range(50, 67):
        if x < 55 or x > 60:
            chunk[22][x] = TILE_WALL
    # Reading desks (small wall blocks between shelves)
    for dx, dy in [(35, 14), (43, 18), (53, 14), (58, 18)]:
        fill_tiles(chunk, TILE_WALL, dx, dy, dx + 1, dy + 1)

    # Section 3: wax pool hall — pillars, candle arches, wax basins
    fill_tiles(chunk, TILE_WALL, 30, 38, 31, 44)   # pillar NW
    fill_tiles(chunk, TILE_WALL, 40, 40, 41, 46)   # pillar center
    fill_tiles(chunk, TILE_WALL, 48, 38, 49, 44)   # pillar NE
    fill_tiles(chunk, TILE_WALL, 35, 48, 36, 52)   # step wall
    # Wax basin edges (wall rims around the pool area)
    for x in range(28, 50):
        if x < 34 or x > 38:
            chunk[37][x] = TILE_WALL
    # Candle clusters
    fill_tiles(chunk, TILE_WALL, 25, 42, 26, 45)
    fill_tiles(chunk, TILE_WALL, 50, 43, 51, 46)

    # Section 4: scholar tower — ring corridor with central column
    fill_tiles(chunk, TILE_WALL, 58, 30, 59, 38)   # tower pillar W
    fill_tiles(chunk, TILE_WALL, 68, 30, 69, 38)   # tower pillar E
    fill_tiles(chunk, TILE_WALL, 63, 34, 64, 42)   # center column
    for y in range(28, 42):
        if y < 32 or y > 36:
            chunk[y][73] = TILE_WALL   # east ring wall
    # Upper bookshelf ring
    for x in range(54, 73):
        if x < 60 or x > 65:
            chunk[26][x] = TILE_WALL
    # Spiral staircase wall
    for y in range(42, 55):
        if y < 46 or y > 50:
            chunk[y][63] = TILE_WALL

    # Section 5: 翼骑士走廊 — armor displays, stone arches
    fill_tiles(chunk, TILE_WALL, 45, 60, 46, 66)   # armor display W
    fill_tiles(chunk, TILE_WALL, 58, 62, 59, 68)   # armor display E
    fill_tiles(chunk, TILE_WALL, 50, 70, 51, 74)   # stone bench
    # Corridor walls creating knight hall
    for x in range(38, 66):
        if x < 42 or x > 48:
            chunk[58][x] = TILE_WALL
    # Stone arch supports
    fill_tiles(chunk, TILE_WALL, 40, 58, 42, 60)
    fill_tiles(chunk, TILE_WALL, 62, 58, 64, 60)

    # Section 6: 石像鬼屋顶 — roof platforms and broken walls
    fill_tiles(chunk, TILE_WALL, 50, 78, 51, 84)   # roof pillar NW
    fill_tiles(chunk, TILE_WALL, 60, 82, 61, 88)   # roof pillar center
    fill_tiles(chunk, TILE_WALL, 68, 80, 69, 86)   # gargoyle perch NE
    fill_tiles(chunk, TILE_WALL, 55, 90, 56, 95)   # wall fragment SW
    fill_tiles(chunk, TILE_WALL, 70, 92, 71, 97)   # broken wall SE
    # Parapet walls along roof edge
    for x in range(48, 72):
        if x % 3 < 2:  # crenellation pattern
            chunk[75][x] = TILE_WALL
    # Roof debris
    fill_tiles(chunk, TILE_WALL, 63, 78, 66, 80)
    fill_tiles(chunk, TILE_WALL, 48, 88, 50, 90)

    # Section 7: 王子宫殿 (boss arena) — grand palace with columns and throne
    # Grand columns (4 large pillars)
    fill_tiles(chunk, TILE_WALL, 58, 112, 60, 118)  # palace column NW
    fill_tiles(chunk, TILE_WALL, 73, 112, 75, 118)  # palace column NE
    fill_tiles(chunk, TILE_WALL, 58, 126, 60, 132)  # palace column SW
    fill_tiles(chunk, TILE_WALL, 73, 126, 75, 132)  # palace column SE
    # Twin throne structure (central feature)
    fill_tiles(chunk, TILE_WALL, 62, 125, 63, 130)  # throne left
    fill_tiles(chunk, TILE_WALL, 76, 125, 77, 130)  # throne right
    fill_tiles(chunk, TILE_WALL, 64, 124, 75, 126)  # throne base
    # Palace debris
    fill_tiles(chunk, TILE_WALL, 54, 108, 56, 110)
    fill_tiles(chunk, TILE_WALL, 78, 110, 80, 112)
    fill_tiles(chunk, TILE_WALL, 64, 132, 66, 134)

    # ===== Player spawn & bonfires =====
    entities.append(make_entity("PlayerSpawn", p(200), p(300), [make_field("heal", "Bool", False)]))
    entities.append(make_entity("Bonfire", p(200), p(300)))    # 入口篝火
    entities.append(make_entity("Bonfire", p(3950), p(800)))   # 双子王子篝火

    # ===== Boss: Twin Princes =====
    entities.append(make_entity("BossSpawn", p(1800), p(3200)))
    # ===== Enemies from design doc =====
    for kind, dx, dy, count in [
        ("DarkMage", 350, 300, 2),
        ("DarkMage", 600, 500, 2),
        ("WingedKnight", 1100, 400, 1),
        ("Gargoyle", 1400, 2200, 3),
        ("LothricKnight", 900, 600, 2),
        ("DarkMage", 1300, 1600, 2),
        ("CrystalLizard", 500, 400, 1),
        ("CrystalLizard", 1600, 2400, 1),
        ("WingedKnight", 1500, 1800, 1),
    ]:
        for i in range(count):
            ox = (i * 24) % 48 - 24
            oy = (i * 18) % 36 - 18
            entities.append(make_entity("Enemy", p(dx) + ox, p(dy) + oy, [
                make_field("kind", "LocalEnum.EnemyKind", kind),
            ]))

    # ===== Items =====
    for kind, dx, dy, extra in [
        ("SoulOrb", 300, 300, [("value", "Int", 800)]),
        ("SoulOrb", 700, 500, [("value", "Int", 1000)]),
        ("SoulOrb", 1100, 400, [("value", "Int", 1200)]),
        ("SoulOrb", 1600, 800, [("value", "Int", 1500)]),
        ("EstusShard", 500, 350, []),
        ("HomewardBone", 900, 600, []),
        ("SoulOrb", 1700, 2400, [("value", "Int", 2000)]),
        ("TitaniteShard", 1200, 900, [("name", "String", "楔形石碎片")]),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        for fname, ftype, fval in extra:
            fields.append(make_field(fname, ftype, fval))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    # ===== Chests =====
    for dx, dy, lk, lv, ln, mimic in [
        (450, 400, "RingDrop", 0, "学者戒指", False),
        (700, 500, "WeaponDrop", 0, "宫廷术师杖", False),
        (1000, 600, "ArmorDrop", 0, "贤者套装", False),
        (1300, 1800, "RingDrop", 0, "幼龙戒指", True),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv), make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    # ===== Lights =====
    for dx, dy, r, cr, cg, cb, intensity in [
        (200, 300, 180, 0.8, 0.7, 0.9, 0.5),
        (800, 400, 120, 0.8, 0.7, 0.9, 0.3),
        (1400, 800, 150, 0.8, 0.7, 0.9, 0.3),
        (1800, 3200, 250, 0.8, 0.7, 0.9, 0.5),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r), make_field("r", "Float", cr),
            make_field("g", "Float", cg), make_field("b", "Float", cb), make_field("intensity", "Float", intensity),
        ]))

    # ===== Fog gates =====
    # Return to LothricCastle
    entities.append(make_entity("FogGate", p(100), p(400), [
        make_field("dest_area", "String", "LothricCastle"),
        make_field("dest_x", "Float", 300.0),
        make_field("dest_y", "Float", 400.0),
        make_field("width", "Float", 40.0),
        make_field("height", "Float", 100.0),
    ]))
    # Boss fog gate — Twin Princes (self-referential)
    entities.append(make_entity("FogGate", p(1600), p(2800), [
        make_field("dest_area", "String", "GrandArchives"),
        make_field("dest_x", "Float", float(p(1800))),
        make_field("dest_y", "Float", float(p(3200))),
        make_field("width", "Float", 80.0),
        make_field("height", "Float", 32.0),
    ]))
    # To KilnOfTheFirstFlame
    entities.append(make_entity("FogGate", p(2000), p(3400), [
        make_field("dest_area", "String", "KilnOfTheFirstFlame"),
        make_field("dest_x", "Float", 200.0),
        make_field("dest_y", "Float", 400.0),
        make_field("width", "Float", 40.0),
        make_field("height", "Float", 100.0),
    ]))

    # ===== NPCs =====
    for name, kind, dx, dy, color, dialogue in [
        ("彼海姆的欧贝克", "Merchant", 400, 350, "#404060",
         "我已经将所有法术传授给你了……去完成你的使命吧。"),
        ("无光之地的希里斯", "Dialogue", 600, 450, "#a0b0c0",
         "在我的旅途中……你是唯一给予我温暖的人。"),
        ("卡塔利纳的杰克巴尔多", "Dialogue", 300, 300, "#d4a840",
         "看来我们的旅途即将结束了。一起喝一杯吧！"),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name), make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue), make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))
    return chunk, entities

def make_kiln_of_the_first_flame():
    S = 1.0
    chunk = new_chunk()
    def t(v): return max(0, min(159, int(v * S) // 16))
    def p(v): return int(v * S)

    fill_tiles(chunk, TILE_GROUND, t(0), t(600), t(1200), t(1400))
    fill_tiles(chunk, TILE_GROUND, t(1000), t(500), t(1600), t(1100))
    fill_tiles(chunk, TILE_GROUND, t(600), t(100), t(1800), t(1000))

    bx1,bx2,by1,by2 = t(600),t(1800),t(100),t(1000)
    fill_tiles(chunk, TILE_WALL, bx1-1, by1-1, bx1-1, by2+1)
    fill_tiles(chunk, TILE_WALL, bx2+1, by1-1, bx2+1, by2+1)
    fill_tiles(chunk, TILE_WALL, bx1-1, by1-1, int((bx1+bx2)/2)-3, by1-1)
    fill_tiles(chunk, TILE_WALL, int((bx1+bx2)/2)+3, by1-1, bx2+1, by1-1)
    # Bottom wall with entrance gap (5 tiles wide) so boss arena is reachable from spawn
    mid_bottom = int((bx1+bx2)/2)
    fill_tiles(chunk, TILE_WALL, bx1-1, by2+1, mid_bottom-3, by2+1)
    fill_tiles(chunk, TILE_WALL, mid_bottom+3, by2+1, bx2+1, by2+1)

    # ---- Kiln of the First Flame internal walls ----
    # Ash path: twisted iron pillars, collapsed ruins, petrified forms
    # t(0)=0, t(200)=12, t(400)=25, t(600)=37, t(800)=50, t(1000)=62, t(1200)=75, t(1600)=100

    # Ash path obstacles (section between spawn and arena)
    fill_tiles(chunk, TILE_WALL, t(200), t(750), t(210), t(780))   # twisted iron pillar
    fill_tiles(chunk, TILE_WALL, t(350), t(700), t(360), t(730))   # collapsed rubble
    fill_tiles(chunk, TILE_WALL, t(500), t(650), t(510), t(680))   # petrified form
    fill_tiles(chunk, TILE_WALL, t(250), t(850), t(260), t(880))   # iron pillar
    fill_tiles(chunk, TILE_WALL, t(450), t(900), t(460), t(930))   # rubble
    fill_tiles(chunk, TILE_WALL, t(150), t(650), t(160), t(670))   # small debris

    # Collapsed hall obstacles (near top of arena)
    fill_tiles(chunk, TILE_WALL, t(800), t(200), t(810), t(230))   # hanging rock
    fill_tiles(chunk, TILE_WALL, t(1000), t(250), t(1010), t(280)) # collapsed brickwork
    fill_tiles(chunk, TILE_WALL, t(1400), t(350), t(1410), t(380)) # weapon debris
    fill_tiles(chunk, TILE_WALL, t(700), t(400), t(710), t(420))   # debris
    fill_tiles(chunk, TILE_WALL, t(1600), t(500), t(1610), t(530)) # rubble

    # Arena internal obstacles (scattered debris inside the boss arena)
    fill_tiles(chunk, TILE_WALL, t(800), t(500), t(810), t(550))   # stone debris
    fill_tiles(chunk, TILE_WALL, t(1300), t(300), t(1310), t(350)) # weapon remnant
    fill_tiles(chunk, TILE_WALL, t(1100), t(800), t(1110), t(840)) # rubble
    fill_tiles(chunk, TILE_WALL, t(1500), t(700), t(1510), t(740)) # debris

    # Ash path narrow sections (walls to create corridor feel)
    for y in range(t(600), t(700)):
        chunk[y][t(50)] = TILE_WALL    # west corridor wall
    for y in range(t(800), t(1000)):
        if y < t(870) or y > t(930):   # gap in middle
            chunk[y][t(550)] = TILE_WALL  # east corridor wall

    # ---- Section boundary walls ----
    # Ash path (x:0-37, y:37-100) boundary:
    # East wall at x=38, gap at y=55-65 for transition to collapsed hall
    for y in range(37, 101):
        if y < 55 or y > 65:
            chunk[y][38] = TILE_WALL
    # South wall of ash path at y=101, gap at x=20-30 for spawn area exit
    for x in range(0, 39):
        if x < 20 or x > 30:
            chunk[101][x] = TILE_WALL

    # Collapsed hall (x:62-100, y:31-68) boundary:
    # West wall at x=61, gap at y=40-50 for connection from ash path
    for y in range(31, 69):
        if y < 40 or y > 50:
            chunk[y][61] = TILE_WALL
    # South wall at y=69, gap at x=70-80
    for x in range(61, 101):
        if x < 70 or x > 80:
            chunk[69][x] = TILE_WALL
    # East wall at x=101 (full)
    for y in range(31, 69):
        chunk[y][101] = TILE_WALL

    # ---- Ash path internal walls (winding path features) ----
    # E-W wall creating detour, gap at x=15-20
    for x in range(5, 36):
        if x < 15 or x > 20:
            chunk[60][x] = TILE_WALL
    # N-S wall lower section, gap at y=80-85
    for y in range(75, 95):
        if y < 80 or y > 85:
            chunk[y][25] = TILE_WALL
    # Another E-W barrier, gap at x=25-30
    for x in range(10, 36):
        if x < 25 or x > 30:
            chunk[85][x] = TILE_WALL

    # ---- Collapsed hall internal walls ----
    # Interior column ruins
    fill_tiles(chunk, TILE_WALL, 70, 40, 72, 44)    # collapsed pillar NW
    fill_tiles(chunk, TILE_WALL, 85, 45, 87, 50)    # collapsed pillar NE
    fill_tiles(chunk, TILE_WALL, 75, 55, 77, 60)    # collapsed pillar center
    fill_tiles(chunk, TILE_WALL, 90, 58, 92, 62)    # fallen brickwork SE
    # N-S dividing wall with gap
    for y in range(35, 60):
        if y < 42 or y > 48:
            chunk[y][80] = TILE_WALL

    # ---- Boss arena internal walls (scattered debris inside) ----
    # Western side stone debris
    fill_tiles(chunk, TILE_WALL, 45, 20, 47, 24)    # stone block
    fill_tiles(chunk, TILE_WALL, 55, 15, 57, 18)    # small rubble
    # Eastern side weapon remnants
    fill_tiles(chunk, TILE_WALL, 95, 25, 97, 30)    # weapon pile
    fill_tiles(chunk, TILE_WALL, 100, 35, 102, 38)  # rubble
    # Central area low obstacles
    fill_tiles(chunk, TILE_WALL, 65, 40, 66, 42)    # small debris
    fill_tiles(chunk, TILE_WALL, 90, 45, 91, 47)    # small debris

    entities = []
    entities.append(make_entity("PlayerSpawn", p(200), p(1000), [make_field("heal", "Bool", False)]))
    for bx, by in [(200, 1000), (200, 600)]:
        entities.append(make_entity("Bonfire", p(bx), p(by)))
    entities.append(make_entity("BossSpawn", p(1200), p(550)))

    for dx, dy, r, cr, cg, cb, intensity in [
        (200, 1000, 200, 0.9, 0.6, 0.3, 0.7),
        (1200, 500, 300, 1.0, 0.5, 0.2, 0.5),
        (600, 300, 150, 0.5, 0.3, 0.2, 0.3),
        (400, 700, 80, 0.8, 0.4, 0.1, 0.3),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))


    boss_gx = (t(600) + t(1800)) * 8
    boss_gy = t(100) * 16
    entities.append(make_entity("FogGate", boss_gx, boss_gy, [
        make_field("dest_area", "String", "KilnOfTheFirstFlame"),
        make_field("dest_x", "Float", float(p(1200))),
        make_field("dest_y", "Float", float(p(550))),
        make_field("width", "Float", 96.0),
        make_field("height", "Float", 32.0),
    ]))

    return chunk, entities

def make_consumed_kings_garden():
    S = 1.0
    chunk = new_chunk()
    def t(v): return max(0, min(159, int(v * S) // 16))
    def p(v): return int(v * S)

    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(600), t(800))
    fill_tiles(chunk, TILE_GROUND, t(500), t(500), t(1300), t(1100))
    fill_tiles(chunk, TILE_GROUND, t(1200), t(600), t(1800), t(1100))
    fill_tiles(chunk, TILE_POISON, t(800), t(1100), t(1500), t(1700))
    fill_tiles(chunk, TILE_GROUND, t(1700), t(1400), t(2500), t(2100))

    bx1,bx2,by1,by2 = t(1700),t(2500),t(1400),t(2100)
    fill_tiles(chunk, TILE_WALL, bx1-1, by1-1, bx1-1, by2+1)
    fill_tiles(chunk, TILE_WALL, bx2+1, by1-1, bx2+1, by2+1)
    fill_tiles(chunk, TILE_WALL, bx1-1, by1-1, int((bx1+bx2)/2)-3, by1-1)
    fill_tiles(chunk, TILE_WALL, int((bx1+bx2)/2)+3, by1-1, bx2+1, by1-1)
    # Bottom wall with entrance gap (7 tiles wide) so boss arena is reachable from spawn
    mid_bottom = int((bx1+bx2)/2)
    fill_tiles(chunk, TILE_WALL, bx1-1, by2+1, mid_bottom-4, by2+1)
    fill_tiles(chunk, TILE_WALL, mid_bottom+4, by2+1, bx2+1, by2+1)
    # Ground bridge connecting main area to boss arena (placed after walls to overwrite wall tiles)
    fill_tiles(chunk, TILE_GROUND, t(1500), t(1050), bx1+2, by1+2)

    # ---- Consumed King's Garden internal walls ----
    # Section 1: Garden entrance (t(0)-t(600)x, t(0)-t(800)y) = 0-37x, 0-50y
    # Section 2: Crystal courtyard (t(500)-t(1300)x, t(500)-t(1100)y) = 31-81x, 31-68y
    # Section 3: Serpent corridor (t(1200)-t(1800)x, t(600)-t(1100)y) = 75-112x, 37-68y
    # Section 4: Poison marsh (t(800)-t(1500)x, t(1100)-t(1700)y) = 50-93x, 68-106y
    # Section 5: Boss arena (t(1700)-t(2500)x, t(1400)-t(2100)y) = 106-156x, 87-131y

    # ---- Section boundary walls ----
    # Section 1→2: east wall at x=38, gap at y=20-30
    for y in range(0, 51):
        if y < 20 or y > 30:
            chunk[y][38] = TILE_WALL
    # Section 1 south wall at y=51, gap at x=25-35
    for x in range(0, 39):
        if x < 25 or x > 35:
            chunk[51][x] = TILE_WALL
    # Section 1 internal: garden entrance stone arches
    fill_tiles(chunk, TILE_WALL, t(100), t(100), t(130), t(130))   # stone arch NW
    fill_tiles(chunk, TILE_WALL, t(400), t(100), t(430), t(130))   # stone arch NE
    # Garden ruin walls creating narrow entrance path
    for x in range(t(0), t(200)):
        if x < t(50) or x > t(100):
            chunk[t(400)][x] = TILE_WALL  # E-W wall mid-garden
    for x in range(t(300), t(600)):
        if x < t(400) or x > t(450):
            chunk[t(600)][x] = TILE_WALL  # E-W wall lower garden
    # Broken columns
    fill_tiles(chunk, TILE_WALL, t(150), t(200), t(170), t(250))
    fill_tiles(chunk, TILE_WALL, t(350), t(300), t(370), t(350))
    fill_tiles(chunk, TILE_WALL, t(250), t(500), t(270), t(550))
    # Consumed garden walls (corrupted stone)
    for y in range(t(100), t(400)):
        if y < t(200) or y > t(250):
            chunk[y][t(500)] = TILE_WALL  # N-S divider

    # Section 2→3: east wall at x=82, gap at y=40-50
    for y in range(31, 69):
        if y < 40 or y > 50:
            chunk[y][82] = TILE_WALL
    # Section 2 south wall at y=69, gap at x=50-58
    for x in range(31, 82):
        if x < 50 or x > 58:
            chunk[69][x] = TILE_WALL
    # Section 2 internal: crystal courtyard — crystal pillars and ruined fountain
    # Crystal clusters (large wall blocks)
    fill_tiles(chunk, TILE_WALL, t(600), t(550), t(650), t(580))   # crystal cluster NW
    fill_tiles(chunk, TILE_WALL, t(900), t(550), t(950), t(580))   # crystal cluster NE
    fill_tiles(chunk, TILE_WALL, t(650), t(750), t(700), t(780))   # crystal cluster center
    fill_tiles(chunk, TILE_WALL, t(1050), t(700), t(1100), t(730)) # crystal cluster E
    # Dry fountain base (circular wall structure)
    fill_tiles(chunk, TILE_WALL, t(750), t(850), t(900), t(870))   # fountain rim N
    fill_tiles(chunk, TILE_WALL, t(750), t(950), t(900), t(970))   # fountain rim S
    fill_tiles(chunk, TILE_WALL, t(750), t(870), t(770), t(950))   # fountain rim W
    fill_tiles(chunk, TILE_WALL, t(880), t(870), t(900), t(950))   # fountain rim E
    # Courtyard dividing wall
    for x in range(t(500), t(1000)):
        if t(680) <= x <= t(720):  # gap
            continue
        chunk[t(1000)][x] = TILE_WALL

    # Section 3→5: south wall at y=69, gap at x=95-105
    for x in range(75, 113):
        if x < 95 or x > 105:
            chunk[69][x] = TILE_WALL
    # Section 3 east wall at x=113, gap at y=50-60
    for y in range(37, 69):
        if y < 50 or y > 60:
            chunk[y][113] = TILE_WALL
    # Section 3 internal: serpent corridor — narrow winding passage
    # Corridor narrowing walls (serpent stone arches)
    for y in range(t(650), t(900)):
        if t(750) <= y <= t(780):  # gap
            continue
        chunk[y][t(1150)] = TILE_WALL  # left wall
    for y in range(t(700), t(1050)):
        if t(850) <= y <= t(880):  # gap
            continue
        chunk[y][t(1250)] = TILE_WALL  # right wall
    # Stone arch pillars
    fill_tiles(chunk, TILE_WALL, t(1300), t(700), t(1320), t(740))
    fill_tiles(chunk, TILE_WALL, t(1500), t(750), t(1520), t(790))
    fill_tiles(chunk, TILE_WALL, t(1700), t(800), t(1720), t(840))
    # Serpent statue base
    fill_tiles(chunk, TILE_WALL, t(1450), t(900), t(1550), t(940))

    # Section 4 south wall at y=107, gap at x=75-85
    for x in range(50, 94):
        if x < 75 or x > 85:
            chunk[107][x] = TILE_WALL
    # Section 4 east wall at x=94, gap at y=90-100
    for y in range(68, 107):
        if y < 90 or y > 100:
            chunk[y][94] = TILE_WALL
    # Section 4 internal: poison marsh — platforms and broken bridges
    # Central stone platform (above poison)
    fill_tiles(chunk, TILE_WALL, t(950), t(1250), t(1050), t(1270))  # platform wall N
    fill_tiles(chunk, TILE_WALL, t(950), t(1400), t(1050), t(1420))  # platform wall S
    fill_tiles(chunk, TILE_WALL, t(950), t(1270), t(970), t(1400))   # platform wall W
    fill_tiles(chunk, TILE_WALL, t(1030), t(1270), t(1050), t(1400)) # platform wall E
    # Ground on platform top
    fill_tiles(chunk, TILE_GROUND, t(970), t(1270), t(1030), t(1400))
    # Broken pillars in marsh
    fill_tiles(chunk, TILE_WALL, t(800), t(1150), t(820), t(1180))
    fill_tiles(chunk, TILE_WALL, t(1100), t(1350), t(1120), t(1380))
    fill_tiles(chunk, TILE_WALL, t(1250), t(1500), t(1270), t(1530))
    # West marsh wall
    for y in range(t(1150), t(1600)):
        if t(1300) <= y <= t(1330):  # gap
            continue
        chunk[y][t(850)] = TILE_WALL

    # Boss arena internal: crystal throne and corrupted walls
    # Crystal throne structure
    fill_tiles(chunk, TILE_WALL, t(2050), t(1800), t(2150), t(1820))  # throne base
    fill_tiles(chunk, TILE_WALL, t(2050), t(1950), t(2150), t(1970))  # throne top
    fill_tiles(chunk, TILE_WALL, t(2050), t(1820), t(2070), t(1950))  # throne left
    fill_tiles(chunk, TILE_WALL, t(2130), t(1820), t(2150), t(1950))  # throne right
    # Crystal growths around arena
    fill_tiles(chunk, TILE_WALL, t(1850), t(1550), t(1880), t(1600))
    fill_tiles(chunk, TILE_WALL, t(2300), t(1650), t(2330), t(1700))
    fill_tiles(chunk, TILE_WALL, t(1950), t(2000), t(1980), t(2050))
    fill_tiles(chunk, TILE_WALL, t(2200), t(1900), t(2230), t(1950))
    # Arena corner pillars
    fill_tiles(chunk, TILE_WALL, t(1800), t(1500), t(1820), t(1530))
    fill_tiles(chunk, TILE_WALL, t(2400), t(1500), t(2420), t(1530))
    fill_tiles(chunk, TILE_WALL, t(1800), t(2000), t(1820), t(2030))
    fill_tiles(chunk, TILE_WALL, t(2400), t(2000), t(2420), t(2030))
    # Central debris
    fill_tiles(chunk, TILE_WALL, t(2000), t(1900), t(2020), t(1950))
    fill_tiles(chunk, TILE_WALL, t(2100), t(1650), t(2120), t(1700))

    entities = []
    entities.append(make_entity("PlayerSpawn", p(300), p(400), [make_field("heal", "Bool", False)]))
    for bx, by in [(300, 400), (2200, 1800)]:
        entities.append(make_entity("Bonfire", p(bx), p(by)))
    entities.append(make_entity("BossSpawn", p(2100), p(1750)))

    for kind, dx, dy in [
        ("HollowSoldier", 500, 550),
        ("HollowSoldier", 1000, 700),
        ("HollowSoldier", 1600, 900),
        ("HollowSoldier", 1700, 850),
        ("SerpentMan", 800, 700),
        ("SerpentMan", 1300, 750),
        ("HollowSoldier", 600, 650),
        ("HollowSoldier", 640, 650),
        ("HollowSoldier", 1100, 800),
        ("HollowSoldier", 1140, 800),
        ("HollowSoldier", 900, 900),
        ("HollowSoldier", 940, 900),
        ("HollowSoldier", 1400, 850),
        ("PusOfMan", 700, 800),
        ("PusOfMan", 1200, 900),
        ("InfestedCorpse", 800, 1100),
        ("InfestedCorpse", 840, 1100),
        ("InfestedCorpse", 880, 1100),
        ("InfestedCorpse", 920, 1140),
        ("InfestedCorpse", 1100, 1200),
        ("InfestedCorpse", 1140, 1200),
        ("InfestedCorpse", 1180, 1200),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))

    for kind, dx, dy, val in [
        ("Consumable", 400, 600, 0),
        ("EstusShard", 600, 750, 0),
        ("Consumable", 800, 850, 0),
        ("Consumable", 900, 900, 0),
        ("Consumable", 1000, 950, 0),
        ("Consumable", 1100, 1050, 0),
        ("Consumable", 850, 1200, 0),
        ("Consumable", 900, 1250, 0),
        ("Consumable", 950, 1280, 0),
        ("Consumable", 750, 1150, 0),
        ("Consumable", 1300, 800, 0),
        ("Consumable", 1400, 850, 0),
        ("Consumable", 2300, 1900, 0),
        ("Consumable", 2350, 1950, 0),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb": fields.append(make_field("value", "Int", val))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    for lk, lv, ln, dx, dy, mimic in [
        ("EstusShard", 0, "原瓶碎片", 600, 750, False),
        ("RingDrop", 0, "龙鳞戒指", 1300, 800, False),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv), make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    for name, color, dialogue, kind, dx, dy in [
        ("脱逃者霍克伍德", "#999", "", "Dialogue", 1650, 900),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name), make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue), make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 400, 180, 0.6, 0.7, 0.9, 0.5),
        (700, 650, 120, 0.4, 0.6, 0.9, 0.6),
        (1100, 1400, 150, 0.5, 0.5, 0.8, 0.5),
        (2100, 1750, 200, 0.3, 0.5, 0.9, 0.4),
        (2200, 1800, 180, 0.6, 0.7, 0.9, 0.5),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    for da, ddx, ddy, dx, dy, w, h in [
        ("LothricCastle", p(1200), p(1050), p(0), p(300), 40, 200),
        ("UntendedGraves", p(200), p(400), p(2500), p(1800), 200, 40),
    ]:
        entities.append(make_entity("FogGate", dx, dy, [
            make_field("dest_area", "String", da),
            make_field("dest_x", "Float", float(ddx)), make_field("dest_y", "Float", float(ddy)),
            make_field("width", "Float", float(w)), make_field("height", "Float", float(h)),
        ]))

    boss_gx = (t(1700) + t(2500)) * 8
    boss_gy = t(1400) * 16
    entities.append(make_entity("FogGate", boss_gx, boss_gy, [
        make_field("dest_area", "String", "ConsumedKingsGarden"),
        make_field("dest_x", "Float", float(p(2100))),
        make_field("dest_y", "Float", float(p(1750))),
        make_field("width", "Float", 96.0),
        make_field("height", "Float", 32.0),
    ]))

    return chunk, entities

def make_untended_graves():
    S = 1.0
    chunk = new_chunk()
    def t(v): return max(0, min(159, int(v * S) // 16))
    def p(v): return int(v * S)

    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(400), t(400))
    fill_tiles(chunk, TILE_GROUND, t(300), t(300), t(800), t(700))
    fill_tiles(chunk, TILE_GROUND, t(700), t(500), t(1100), t(850))
    fill_tiles(chunk, TILE_GROUND, t(500), t(700), t(1000), t(1050))
    fill_tiles(chunk, TILE_GROUND, t(1100), t(850), t(1600), t(1250))
    fill_tiles(chunk, TILE_GROUND, t(1500), t(1150), t(1900), t(1500))

    bx1,bx2,by1,by2 = t(1100),t(1600),t(880),t(1260)
    # Right wall with exit gap (7 tiles wide) so FogGate to FirelinkShrine is reachable
    mid_right = int((by1+by2)/2)
    fill_tiles(chunk, TILE_WALL, bx2+1, by1-1, bx2+1, mid_right-4)
    fill_tiles(chunk, TILE_WALL, bx2+1, mid_right+4, bx2+1, by2+1)
    fill_tiles(chunk, TILE_WALL, bx1-1, by2+1, bx2+1, by2+1)
    fill_tiles(chunk, TILE_WALL, bx1-1, by1-1, int((bx1+bx2)/2)-3, by1-1)
    fill_tiles(chunk, TILE_WALL, int((bx1+bx2)/2)+3, by1-1, bx2+1, by1-1)
    # Left wall with entrance gap (7 tiles wide) so boss arena is reachable from spawn
    mid_left = int((by1+by2)/2)
    fill_tiles(chunk, TILE_WALL, bx1-1, by1-1, bx1-1, mid_left-4)
    fill_tiles(chunk, TILE_WALL, bx1-1, mid_left+4, bx1-1, by2+1)
    # Ground bridge connecting main area to boss arena (placed after walls to overwrite wall tiles)
    fill_tiles(chunk, TILE_GROUND, t(950), t(700), bx1+2, by1+2)
    # Ground bridge through right wall gap to reach FogGate exit area
    fill_tiles(chunk, TILE_GROUND, bx2-2, mid_right-4, bx2+3, mid_right+4)

    # ---- Untended Graves section boundary walls ----
    # Sections:
    #   Dark Cemetery Entrance: x:0-25, y:0-25
    #   Dark Cemetery Path:     x:18-50, y:18-43
    #   Dark Courtyard:         x:43-68, y:31-53
    #   Black Knight Cemetery:  x:31-62, y:43-65
    #   Champion's Arena:       x:68-100, y:55-78  (arena walls already present)
    #   Dark Firelink Entrance: x:93-118, y:71-93

    # Section 1 (Entrance) east wall at x=26, gap at y=14-20 for path to Section 2
    for y in range(0, 26):
        if y < 14 or y > 20:
            chunk[y][26] = TILE_WALL

    # Section 2 (Cemetery Path) south wall at y=44, gap at x=32-38
    for x in range(18, 51):
        if x < 32 or x > 38:
            chunk[44][x] = TILE_WALL
    # Section 2 east wall at x=51, gap at y=28-35 for path to Section 3
    for y in range(18, 44):
        if y < 28 or y > 35:
            chunk[y][51] = TILE_WALL

    # Section 3 (Dark Courtyard) south wall at y=54, gap at x=48-55
    for x in range(43, 69):
        if x < 48 or x > 55:
            chunk[54][x] = TILE_WALL
    # Section 3 east wall at x=69, gap at y=40-48
    for y in range(31, 54):
        if y < 40 or y > 48:
            chunk[y][69] = TILE_WALL

    # Section 4 (Black Knight Cemetery) west wall at x=30, gap at y=50-56
    for y in range(43, 66):
        if y < 50 or y > 56:
            chunk[y][30] = TILE_WALL
    # Section 4 east wall at x=63, gap at y=52-58 for arena approach
    for y in range(43, 66):
        if y < 52 or y > 58:
            chunk[y][63] = TILE_WALL
    # Section 4 south wall at y=66, gap at x=45-52
    for x in range(30, 64):
        if x < 45 or x > 52:
            chunk[66][x] = TILE_WALL

    # Section 6 (Dark Firelink Entrance) boundary
    # West wall at x=92, gap at y=74-80
    for y in range(71, 94):
        if y < 74 or y > 80:
            chunk[y][92] = TILE_WALL
    # North wall at y=70, gap at x=100-108
    for x in range(93, 119):
        if x < 100 or x > 108:
            chunk[70][x] = TILE_WALL
    # South wall at y=94, full
    for x in range(93, 119):
        chunk[94][x] = TILE_WALL
    # East wall at x=119, full
    for y in range(71, 94):
        chunk[y][119] = TILE_WALL

    # ---- Internal walls: cemetery features ----
    # Dark Cemetery Entrance: broken coffin walls
    fill_tiles(chunk, TILE_WALL, 8, 8, 10, 12)       # broken stone coffin
    fill_tiles(chunk, TILE_WALL, 16, 4, 18, 7)       # collapsed coffin stack
    fill_tiles(chunk, TILE_WALL, 5, 18, 7, 20)       # narrow wall fragment

    # Dark Cemetery Path: winding path with gravestones and walls
    # E-W barrier, gap at x=28-32
    for x in range(20, 48):
        if x < 28 or x > 32:
            chunk[30][x] = TILE_WALL
    # N-S barrier, gap at y=22-25
    for y in range(20, 40):
        if y < 22 or y > 25:
            chunk[y][35] = TILE_WALL
    # Another E-W barrier, gap at x=38-42
    for x in range(22, 48):
        if x < 38 or x > 42:
            chunk[38][x] = TILE_WALL
    # Gravestones scattered along path
    for gx, gy in [(22, 22), (28, 26), (40, 32), (45, 36), (25, 40), (35, 42)]:
        fill_tiles(chunk, TILE_WALL, gx, gy, gx+1, gy+1)

    # Dark Courtyard: dead tree and open space features
    fill_tiles(chunk, TILE_WALL, 52, 36, 54, 42)     # dead tree base
    fill_tiles(chunk, TILE_WALL, 60, 44, 62, 48)     # broken stone bench
    fill_tiles(chunk, TILE_WALL, 48, 48, 49, 50)     # gravestone
    fill_tiles(chunk, TILE_WALL, 63, 38, 64, 40)     # gravestone

    # Black Knight Cemetery: elevated platforms and terrain
    fill_tiles(chunk, TILE_WALL, 38, 50, 38, 55)     # platform edge
    fill_tiles(chunk, TILE_WALL, 52, 53, 52, 58)     # platform edge
    fill_tiles(chunk, TILE_WALL, 42, 60, 48, 61)     # step wall
    for gx, gy in [(35, 48), (44, 55), (55, 58), (58, 50)]:
        fill_tiles(chunk, TILE_WALL, gx, gy, gx+1, gy+1)

    # Dark Firelink Entrance: stone walls and shrine ruins
    fill_tiles(chunk, TILE_WALL, 98, 76, 100, 80)    # ruined shrine wall
    fill_tiles(chunk, TILE_WALL, 108, 82, 112, 84)   # collapsed stone
    fill_tiles(chunk, TILE_WALL, 102, 88, 106, 90)   # broken altar

    entities = []
    entities.append(make_entity("PlayerSpawn", p(300), p(400), [make_field("heal", "Bool", False)]))
    for bx, by in [(300, 400), (1500, 1100)]:
        entities.append(make_entity("Bonfire", p(bx), p(by)))
    entities.append(make_entity("BossSpawn", p(1350), p(1050)))

    for kind, dx, dy in [
        ("BlackKnight", 450, 400),
        ("BlackKnight", 600, 500),
        ("BlackKnight", 800, 600),
        ("BlackKnight", 650, 800),
        ("BlackKnight", 900, 850),
        ("CrystalLizard", 500, 450),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))

    for kind, dx, dy, val in [
        ("Consumable", 1750, 1400, 0),
        ("Consumable", 1350, 1080, 0),
        ("Consumable", 1650, 1300, 0),
        ("SoulOrb", 700, 550, 1000),
        ("Consumable", 500, 450, 0),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb": fields.append(make_field("value", "Int", val))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    for name, color, dialogue, kind, dx, dy in [
        ("祭祀场侍女（暗之版本）", "#606060", "……欢迎回来，灰烬大人。", "Merchant", 1700, 1350),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name), make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue), make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 400, 120, 0.4, 0.35, 0.3, 0.3),
        (800, 600, 60, 0.3, 0.25, 0.2, 0.15),
        (1350, 1050, 80, 0.5, 0.4, 0.3, 0.25),
        (1500, 1100, 120, 0.5, 0.45, 0.35, 0.35),
        (1700, 1350, 80, 0.3, 0.25, 0.2, 0.2),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    for da, ddx, ddy, dx, dy, w, h in [
        ("ConsumedKingsGarden", p(2400), p(1800), p(0), p(200), 40, 200),
        ("FirelinkShrine", p(400), p(400), p(1800), p(1250), 40, 200),
    ]:
        entities.append(make_entity("FogGate", dx, dy, [
            make_field("dest_area", "String", da),
            make_field("dest_x", "Float", float(ddx)), make_field("dest_y", "Float", float(ddy)),
            make_field("width", "Float", float(w)), make_field("height", "Float", float(h)),
        ]))

    boss_gx = (t(1100) + t(1600)) * 8
    boss_gy = t(880) * 16
    entities.append(make_entity("FogGate", boss_gx, boss_gy, [
        make_field("dest_area", "String", "UntendedGraves"),
        make_field("dest_x", "Float", float(p(1350))),
        make_field("dest_y", "Float", float(p(1050))),
        make_field("width", "Float", 96.0),
        make_field("height", "Float", 32.0),
    ]))

    return chunk, entities

def make_archdragon_peak():
    S = 0.6
    chunk = new_chunk()
    def t(v): return max(0, min(159, int(v * S) // 16))
    def p(v): return int(v * S)

    fill_tiles(chunk, TILE_GROUND, t(0), t(0), t(800), t(700))
    fill_tiles(chunk, TILE_GROUND, t(600), t(400), t(1300), t(1000))
    fill_tiles(chunk, TILE_GROUND, t(1100), t(300), t(1900), t(900))
    fill_tiles(chunk, TILE_GROUND, t(900), t(800), t(1700), t(1500))
    fill_tiles(chunk, TILE_GROUND, t(1700), t(700), t(2300), t(1200))
    fill_tiles(chunk, TILE_GROUND, t(2200), t(800), t(2700), t(1300))
    fill_tiles(chunk, TILE_GROUND, t(3000), t(2000), t(4200), t(3000))

    bx1,bx2,by1,by2 = t(3000),t(4200),t(2000),t(3000)
    fill_tiles(chunk, TILE_WALL, bx2+1, by1-1, bx2+1, by2+1)
    fill_tiles(chunk, TILE_WALL, bx1-1, by2+1, bx2+1, by2+1)
    fill_tiles(chunk, TILE_WALL, bx1-1, by1-1, int((bx1+bx2)/2)-3, by1-1)
    fill_tiles(chunk, TILE_WALL, int((bx1+bx2)/2)+3, by1-1, bx2+1, by1-1)
    # Left wall with entrance gap (7 tiles wide) so boss arena is reachable from spawn
    mid_left = int((by1+by2)/2)
    fill_tiles(chunk, TILE_WALL, bx1-1, by1-1, bx1-1, mid_left-4)
    fill_tiles(chunk, TILE_WALL, bx1-1, mid_left+4, bx1-1, by2+1)
    # Ground bridge connecting main area to boss arena
    fill_tiles(chunk, TILE_GROUND, t(1700), t(1200), bx1, by1)

    # ---- Archdragon Peak section boundary walls ----
    # Sections (S=0.6, tile coords):
    #   Section 1 Mountain entrance: x:0-30,  y:0-26
    #   Section 2 Serpent barracks:   x:22-48,  y:15-37
    #   Section 3 Dragon temple:      x:41-71,  y:11-33
    #   Section 4 Dragon arena:       x:33-63,  y:30-56
    #   Section 5 Storm path:         x:63-86,  y:26-45
    #   Section 6 Bell tower:         x:82-101, y:30-48
    #   Section 7 Boss arena:         x:112-157,y:75-112 (walls already present)

    # Section 1→2 boundary: east wall at x=31, gap at y=12-18
    for y in range(0, 27):
        if y < 12 or y > 18:
            chunk[y][31] = TILE_WALL
    # Section 1 south wall at y=27, gap at x=15-22
    for x in range(0, 32):
        if x < 15 or x > 22:
            chunk[27][x] = TILE_WALL

    # Section 2→3 boundary: east wall at x=49, gap at y=20-28
    for y in range(15, 38):
        if y < 20 or y > 28:
            chunk[y][49] = TILE_WALL
    # Section 2 south wall at y=38, gap at x=30-38
    for x in range(22, 50):
        if x < 30 or x > 38:
            chunk[38][x] = TILE_WALL

    # Section 3→5 boundary: east wall at x=72, gap at y=18-25
    for y in range(11, 34):
        if y < 18 or y > 25:
            chunk[y][72] = TILE_WALL

    # Section 4 (Dragon arena) boundary:
    # West wall at x=32, gap at y=36-42 for connection from barracks/temple
    for y in range(30, 57):
        if y < 36 or y > 42:
            chunk[y][32] = TILE_WALL
    # East wall at x=64, gap at y=35-42
    for y in range(30, 57):
        if y < 35 or y > 42:
            chunk[y][64] = TILE_WALL
    # South wall at y=57, gap at x=42-52
    for x in range(32, 65):
        if x < 42 or x > 52:
            chunk[57][x] = TILE_WALL

    # Section 5→6 boundary: east wall at x=87, gap at y=33-40
    for y in range(26, 46):
        if y < 33 or y > 40:
            chunk[y][87] = TILE_WALL
    # Section 5 south wall at y=46, gap at x=70-78
    for x in range(63, 87):
        if x < 70 or x > 78:
            chunk[46][x] = TILE_WALL

    # Section 6 (Bell tower) boundary:
    # East wall at x=102, gap at y=35-42
    for y in range(30, 49):
        if y < 35 or y > 42:
            chunk[y][102] = TILE_WALL
    # South wall at y=49, gap at x=88-95
    for x in range(82, 103):
        if x < 88 or x > 95:
            chunk[49][x] = TILE_WALL

    # ---- Internal walls: terrain features ----

    # Section 1: Mountain ridge features
    fill_tiles(chunk, TILE_WALL, 8, 5, 10, 8)       # rock outcrop
    fill_tiles(chunk, TILE_WALL, 18, 12, 20, 15)     # stone marker
    fill_tiles(chunk, TILE_WALL, 5, 18, 7, 20)       # cliff edge fragment
    for gx, gy in [(14, 8), (24, 16), (12, 22)]:
        fill_tiles(chunk, TILE_WALL, gx, gy, gx+1, gy+1)

    # Section 2: Serpent barracks - central courtyard walls
    fill_tiles(chunk, TILE_WALL, 30, 22, 32, 26)    # barracks pillar
    fill_tiles(chunk, TILE_WALL, 38, 28, 40, 32)    # barracks pillar
    fill_tiles(chunk, TILE_WALL, 26, 32, 28, 34)    # low wall
    # N-S dividing wall with gap
    for y in range(18, 30):
        if y < 22 or y > 26:
            chunk[y][36] = TILE_WALL

    # Section 3: Dragon temple - pillars and altar
    fill_tiles(chunk, TILE_WALL, 48, 16, 50, 20)    # temple pillar
    fill_tiles(chunk, TILE_WALL, 58, 18, 60, 22)    # temple pillar
    fill_tiles(chunk, TILE_WALL, 52, 26, 56, 27)    # altar platform
    fill_tiles(chunk, TILE_WALL, 44, 24, 46, 28)    # bone column
    fill_tiles(chunk, TILE_WALL, 63, 22, 65, 26)    # dragon skeleton fragment

    # Section 4: Dragon arena - ruins
    fill_tiles(chunk, TILE_WALL, 38, 34, 40, 37)    # ruined wall
    fill_tiles(chunk, TILE_WALL, 50, 40, 52, 44)    # stone platform
    fill_tiles(chunk, TILE_WALL, 55, 48, 58, 50)    # collapsed arch
    for gx, gy in [(42, 45), (60, 38)]:
        fill_tiles(chunk, TILE_WALL, gx, gy, gx+1, gy+1)

    # Section 5: Storm path - winding mountain walls
    for y in range(28, 40):
        if y < 32 or y > 36:
            chunk[y][70] = TILE_WALL     # N-S barrier with gap
    for x in range(66, 84):
        if x < 72 or x > 78:
            chunk[35][x] = TILE_WALL     # E-W barrier with gap
    fill_tiles(chunk, TILE_WALL, 76, 28, 78, 32)    # cliff overhang
    fill_tiles(chunk, TILE_WALL, 68, 40, 70, 43)    # ruined pillar

    # Section 6: Bell tower - tower structure walls
    fill_tiles(chunk, TILE_WALL, 88, 34, 90, 38)    # tower wall
    fill_tiles(chunk, TILE_WALL, 96, 36, 98, 40)    # tower wall
    # N-S central pillar with gap
    for y in range(32, 45):
        if y < 36 or y > 40:
            chunk[y][92] = TILE_WALL
    fill_tiles(chunk, TILE_WALL, 85, 42, 88, 44)    # bell frame
    fill_tiles(chunk, TILE_WALL, 95, 43, 98, 45)    # stone platform

    # Boss arena internal: ancient stone pillars at edges
    fill_tiles(chunk, TILE_WALL, 118, 80, 120, 84)  # stone pillar NW
    fill_tiles(chunk, TILE_WALL, 145, 82, 147, 86)  # stone pillar NE
    fill_tiles(chunk, TILE_WALL, 120, 100, 122, 104) # stone pillar SW
    fill_tiles(chunk, TILE_WALL, 148, 98, 150, 102)  # stone pillar SE
    fill_tiles(chunk, TILE_WALL, 130, 88, 132, 92)  # center debris
    fill_tiles(chunk, TILE_WALL, 140, 95, 142, 99)  # center debris

    entities = []
    entities.append(make_entity("PlayerSpawn", p(300), p(400), [make_field("heal", "Bool", False)]))
    for bx, by in [(300, 400), (1400, 600), (2427, 987), (3600, 2800)]:
        entities.append(make_entity("Bonfire", p(bx), p(by)))
    entities.append(make_entity("BossSpawn", p(3600), p(2500)))

    for kind, dx, dy in [
        ("HollowSoldier", 400, 350),
        ("HollowSoldier", 440, 350),
        ("SerpentMan", 700, 500),
        ("SerpentMan", 900, 650),
        ("SerpentMan", 940, 650),
        ("HollowSoldier", 800, 800),
        ("HollowSoldier", 1200, 450),
        ("HollowSoldier", 1240, 450),
        ("SerpentMan", 1400, 550),
        ("SerpentMan", 1440, 550),
        ("HollowSoldier", 1500, 700),
        ("SerpentMan", 1800, 800),
        ("SerpentMan", 1840, 800),
        ("HollowSoldier", 2000, 900),
        ("SerpentMan", 2300, 950),
        ("SerpentMan", 2340, 950),
        ("HollowSoldier", 2400, 1100),
        ("HollowSoldier", 1500, 600),
        ("HollowSoldier", 1540, 600),
        ("HollowSoldier", 1400, 650),
        ("HollowSoldier", 2500, 1100),
        ("HollowSoldier", 1550, 700),
        ("CrystalLizard", 1350, 550),
        ("HollowSoldier", 1700, 800),
        ("HollowSoldier", 1900, 900),
        ("HollowSoldier", 1940, 900),
        ("HollowSoldier", 1980, 900),
        ("HollowSoldier", 2020, 940),
        ("HollowSoldier", 2200, 900),
        ("HollowSoldier", 2450, 1250),
    ]:
        entities.append(make_entity("Enemy", p(dx), p(dy), [make_field("kind", "LocalEnum.EnemyKind", kind)]))

    for kind, dx, dy, val in [
        ("SoulOrb", 350, 450, 2000),
        ("SoulOrb", 400, 400, 800),
        ("SoulOrb", 1000, 700, 2500),
        ("SoulOrb", 1400, 500, 1500),
        ("SoulOrb", 1200, 1100, 5000),
        ("SoulOrb", 2300, 1000, 2500),
        ("Consumable", 1250, 600, 0),
        ("Consumable", 3000, 1800, 0),
        ("RingDrop", 1150, 1050, 0),
        ("RingDrop", 1250, 1150, 0),
        ("RingDrop", 1500, 500, 0),
        ("RingDrop", 1300, 550, 0),
        ("Consumable", 2500, 1150, 0),
        ("WeaponDrop", 2500, 1100, 0),
        ("WeaponDrop", 2510, 1110, 0),
        ("WeaponDrop", 1400, 660, 0),
        ("WeaponDrop", 1560, 710, 0),
        ("ArmorDrop", 3600, 2700, 0),
        ("Consumable", 2300, 950, 0),
        ("HomewardBone", 1700, 750, 0),
        ("Consumable", 350, 380, 0),
        ("Consumable", 1150, 1050, 0),
        ("Consumable", 2350, 1050, 0),
        ("Consumable", 380, 430, 0),
        ("Consumable", 1200, 900, 0),
        ("Consumable", 1400, 500, 0),
        ("Consumable", 1300, 1000, 0),
        ("Consumable", 2550, 1150, 0),
        ("Consumable", 3800, 2900, 0),
        ("Consumable", 420, 370, 0),
        ("Consumable", 1150, 1080, 0),
        ("Consumable", 1200, 1100, 0),
        ("SoulOrb", 1500, 650, 1000),
        ("Consumable", 1100, 1100, 0),
        ("RingDrop", 1100, 900, 0),
        ("ArmorDrop", 500, 350, 0),
        ("WeaponDrop", 1300, 500, 0),
        ("SoulOrb", 1800, 850, 2000),
    ]:
        fields = [make_field("kind", "LocalEnum.ItemKind", kind)]
        if kind == "SoulOrb": fields.append(make_field("value", "Int", val))
        entities.append(make_entity("Item", p(dx), p(dy), fields))

    for lk, lv, ln, dx, dy, mimic in [
        ("Consumable", 0, "光辉楔形石", 1900, 850, False),
        ("Consumable", 0, "楔形石鳞片", 1350, 450, False),
        ("Consumable", 0, "龙鳞楔形石", 2450, 1100, False),
    ]:
        entities.append(make_entity("Chest", p(dx), p(dy), [
            make_field("loot_kind", "LocalEnum.ItemKind", lk),
            make_field("loot_value", "Int", lv), make_field("loot_name", "String", ln),
            make_field("is_mimic", "Bool", mimic),
        ]))

    for name, color, dialogue, kind, dx, dy in [
        ("霍克伍德", "#6B6B6B", "（召唤符出现在古飞龙竞技场入口）帮助清理庭院的蛇人群", "Dialogue", 1300, 1000),
    ]:
        entities.append(make_entity("Npc", p(dx), p(dy), [
            make_field("name", "String", name), make_field("color", "Color", color),
            make_field("dialogue", "String", dialogue), make_field("kind", "LocalEnum.NpcKind", kind),
            make_field("appear_condition", "String", NPC_CONDITIONS.get(name, "")),
        ]))

    for dx, dy, r, cr, cg, cb, intensity in [
        (300, 400, 180, 0.8, 0.7, 0.5, 0.6),
        (1400, 600, 180, 0.8, 0.7, 0.5, 0.6),
        (2400, 1000, 180, 0.8, 0.7, 0.5, 0.6),
        (3600, 2800, 180, 0.8, 0.7, 0.5, 0.6),
        (3600, 2500, 400, 0.7, 0.7, 0.9, 0.4),
        (2300, 1000, 120, 0.9, 0.9, 0.6, 0.6),
        (1200, 450, 100, 0.6, 0.7, 0.9, 0.3),
    ]:
        entities.append(make_entity("Light", p(dx), p(dy), [
            make_field("radius", "Float", r),
            make_field("r", "Float", cr), make_field("g", "Float", cg), make_field("b", "Float", cb),
            make_field("intensity", "Float", intensity),
        ]))

    for da, ddx, ddy, dx, dy, w, h in [
        ("IrithyllDungeon", p(2800), p(600), p(0), p(300), 24, 120),
    ]:
        entities.append(make_entity("FogGate", dx, dy, [
            make_field("dest_area", "String", da),
            make_field("dest_x", "Float", float(ddx)), make_field("dest_y", "Float", float(ddy)),
            make_field("width", "Float", float(w)), make_field("height", "Float", float(h)),
        ]))

    boss_gx = (t(3000) + t(4200)) * 8
    boss_gy = t(2000) * 16
    entities.append(make_entity("FogGate", boss_gx, boss_gy, [
        make_field("dest_area", "String", "ArchdragonPeak"),
        make_field("dest_x", "Float", float(p(3600))),
        make_field("dest_y", "Float", float(p(2500))),
        make_field("width", "Float", 96.0),
        make_field("height", "Float", 32.0),
    ]))

    return chunk, entities

def make_level(identifier, chunk, entities, uid):
    return {
        "__header__": {
            "fileType": "LDtk Project JSON",
            "app": "LDtk",
            "doc": "https://ldtk.io/json",
            "schema": "https://ldtk.io/files/JSON_SCHEMA.json",
            "appAuthor": "Sebastien 'deepnight' Benard",
            "appVersion": "1.5.3",
            "url": "https://ldtk.io",
        },
        "__bgColor": "#1a1a2e",
        "__neighbours": [],
        "__smartColor": "#4a3728",
        "__bgPos": None,
        "bgColor": "#1a1a2e",
        "bgPivotX": 0.5, "bgPivotY": 0.5,
        "bgPos": None,
        "bgRelPath": None,
        "externalRelPath": None,
        "fieldInstances": [],
        "identifier": identifier,
        "iid": str(uuid.uuid4()),
        "layerInstances": [
            {
                "__cHei": CHUNK_SIZE, "__cWid": CHUNK_SIZE,
                "__gridSize": 16,
                "__identifier": "Terrain",
                "__opacity": 1,
                "__pxTotalOffsetX": 0, "__pxTotalOffsetY": 0,
                "__tilesetDefUid": None, "__tilesetRelPath": None,
                "__type": "IntGrid",
                "autoLayerTiles": [],
                "entityInstances": [],
                "gridTiles": [],
                "iid": str(uuid.uuid4()),
                "intGridCsv": chunk_to_csv(chunk),
                "layerDefUid": 1,
                "levelId": uid,
                "optionalRules": [],
                "overrideTilesetUid": None,
                "pxOffsetX": 0, "pxOffsetY": 0,
                "seed": 0,
                "visible": True,
            },
            {
                "__cHei": CHUNK_SIZE, "__cWid": CHUNK_SIZE,
                "__gridSize": 16,
                "__identifier": "Entities",
                "__opacity": 1,
                "__pxTotalOffsetX": 0, "__pxTotalOffsetY": 0,
                "__tilesetDefUid": None, "__tilesetRelPath": None,
                "__type": "Entities",
                "autoLayerTiles": [],
                "entityInstances": entities,
                "gridTiles": [],
                "iid": str(uuid.uuid4()),
                "intGridCsv": [],
                "layerDefUid": 2,
                "levelId": uid,
                "optionalRules": [],
                "overrideTilesetUid": None,
                "pxOffsetX": 0, "pxOffsetY": 0,
                "seed": 0,
                "visible": True,
            },
        ],
        "pxHei": CHUNK_SIZE * 16,
        "pxWid": CHUNK_SIZE * 16,
        "uid": uid,
        "useAutoIdentifier": True,
        "worldDepth": 0,
        "worldX": 0,
        "worldY": 0,
    }

