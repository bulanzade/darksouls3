#!/usr/bin/env python3
"""Generate LDtk .ldtkl level files from the tile layouts defined in wasm_entry.rs."""
import json
import os
import uuid

CHUNK_SIZE = 160
TILE_EMPTY = 0
TILE_GROUND = 1
TILE_WALL = 2
TILE_WALLTOP = 3
TILE_POISON = 4
LEVEL_UIDS = {
    "CemeteryOfAsh": 1,
    "LothricWall": 3,
    "UndeadSettlement": 4,
    "CathedralDeep": 5,
    "Irithyll": 6,
    "RoadOfSacrifices": 7,
    "FarronKeep": 8,
    "CatacombsOfCarthus": 9,
