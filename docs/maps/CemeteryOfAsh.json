  "boss": {
    "type": "IudexGundyr",
    "name": "灰烬审判者古达",
    "name_en": "Iudex Gundyr",
    "x": 1300,
    "y": 1150,
    "hp": 800,
    "arena": {
      "x": 1050,
      "y": 950,
      "w": 500,
      "h": 400
    },
    "phases": [
      {
        "name": "戟武骑士",
        "hp_threshold": 1.0,
        "speed_multiplier": 1.0,
        "damage_multiplier": 1.0,
        "attack_cooldown": 2.5,
        "description": "古达是一名身披黑色铠甲的骑士，手持戟。攻击模式稳定，以戟技和体术为主。作为首个Boss，给玩家学习战斗系统的空间。",
        "mechanics": [
          "戟攻击",
          "肩撞冲锋",
          "横扫"
        ]
      },
      {
        "name": "人之脓变体",
        "hp_threshold": 0.5,
        "speed_multiplier": 1.3,
        "damage_multiplier": 1.2,
        "attack_cooldown": 2.0,
        "description": "古达背后的黑色蛇形怪物——人之脓——破体而出。古达的身体被扭曲，攻击变得更加狂暴和不规则。暗色触手从背部延伸，增加攻击范围。此阶段古达获得暗属性攻击。",
        "mechanics": [
          "人之脓延伸攻击",
          "暗属性伤害",
          "更高速移动",
          "更长的攻击连段"
        ]
      }
    ],
    "attacks": [
      {
        "name": "戟下劈",
        "type": "HalberdOverhead",
        "damage": 30,
        "range": "近-中",
        "parryable": true,
        "description": "高举戟向前猛力下劈。有明显的前摇动作——戟高举过头顶约0.4秒。判定范围集中在正前方，伤害较高。是弹反练习的好时机。"
      },
      {
        "name": "铁山靠",
        "type": "ShoulderCharge",
        "damage": 25,
        "range": "中",
        "parryable": true,
        "description": "快速向玩家方向冲刺肩撞。发动速度很快（0.16秒后开始判定），持续判定时间长（至0.88秒）。古达在距离较远（>118像素）时倾向于使用此招。"
      },
      {
        "name": "戟横扫",
        "type": "HalberdSweep",
        "damage": 25,
        "range": "近-中",
        "parryable": true,
        "description": "以自身为中心的戟大范围横扫。判定范围为半径108像素的圆弧。二阶段使用频率增加（每三次攻击中有两次）。适合翻滚穿过而非后退。"
      }
    ],
    "story": "古达是一位在传火祭祀场等待无火之灰的审判者。他本应在远古时代迎接英雄，但火焰早已熄灭，他化为灰烬守护此地。他被人之脓侵蚀，是玩家遇到的第一个拥有人之脓的Boss。击败他后获得螺旋剑（Coiled Sword），将其插入传火祭祀场的篝火中即可激活祭祀场并开启区域传送功能。"
  },
