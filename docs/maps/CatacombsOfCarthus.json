  "boss": {
    "type": "Wolnir",
    "name": "霸王沃尼尔",
    "name_en": "High Lord Wolnir",
    "x": 3000,
    "y": 2700,
    "hp": 1500,
    "arena": {
      "x": 2550,
      "y": 2350,
      "w": 900,
      "h": 700
    },
    "phases": [
      {
        "name": "金手镯阶段",
        "hp_threshold": 1.0,
        "speed_multiplier": 0.7,
        "damage_multiplier": 1.0,
        "attack_cooldown": 3.0,
        "description": "沃尼尔从黑暗深渊中探出巨大的骷髅上半身。他的双臂各戴一只金手镯，右手还握着一把巨大的骷髅剑，剑上也有手镯。玩家必须攻击并破坏这三只手镯才能造成伤害，身体部分完全无敌。沃尼尔会缓慢地移动双臂，偶尔进行横扫攻击。",
        "mechanics": [
          "攻击金手镯",
          "身体无敌",
          "手臂移动",
          "黑暗之雾缓慢推进"
        ]
      },
      {
        "name": "深渊之怒",
        "hp_threshold": 0.5,
        "speed_multiplier": 1.0,
        "damage_multiplier": 1.3,
        "attack_cooldown": 2.0,
        "description": "两只手腕手镯被破坏后进入此阶段。沃尼尔更加狂暴，频繁召唤骷髅士兵干扰玩家。黑暗之雾加速推进，战场空间不断缩小。他开始使用更猛烈的攻击，包括双手横扫和召唤骷髅军团。",
        "mechanics": [
          "召唤骷髅士兵",
          "黑暗之雾加速",
          "双手攻击",
          "战场缩小"
        ]
      }
    ],
    "attacks": [
      {
        "name": "手臂横扫",
        "type": "ArmSweep",
        "damage": 60,
        "range": "中",
        "parryable": false,
        "description": "沃尼尔挥动一只手臂横扫战场，覆盖范围广，需翻滚躲避"
      },
      {
        "name": "双手拍击",
        "type": "DoubleSlam",
        "damage": 80,
        "range": "中",
        "parryable": false,
        "description": "双手同时拍击地面，产生冲击波，波及范围大"
      },
      {
        "name": "召唤骷髅士兵",
        "type": "SummonSkeletons",
        "damage": 0,
        "range": "-",
        "parryable": false,
        "description": "从地面召唤3-5只骷髅士兵攻击玩家，骷髅会干扰玩家接近手镯"
      },
      {
        "name": "黑暗之雾",
        "type": "DarkFog",
        "damage": 999,
        "range": "全屏",
        "parryable": false,
        "description": "从沃尼尔身后涌出的黑暗雾墙缓缓向前推进。触碰到黑暗之雾的玩家立即死亡（即死机制），必须不断向沃尼尔方向推进"
      },
      {
        "name": "骨堆吐息",
        "type": "BoneBreath",
        "damage": 45,
        "range": "远",
        "parryable": false,
        "description": "沃尼尔张嘴吐出骨头碎片，锥形范围攻击"
      }
    ],
    "bracelets": [
      {
        "name": "左手镯",
        "hp": 500,
        "description": "沃尼尔左手腕上的金手镯"
      },
      {
        "name": "右手镯",
        "hp": 500,
        "description": "沃尼尔右手腕上的金手镯"
      },
      {
        "name": "剑镯",
        "hp": 500,
        "description": "沃尼尔右手所持巨剑上的金手镯，破坏后Boss战结束"
      }
    ],
    "story": "沃尼尔曾是卡萨斯的王者，征服了众多土地，收集了战败国王们的王冠。他惧怕黑暗与深渊，但在某次征战坠入深渊后，被黑暗彻底吞噬，化身为巨大的骸骨。唯有那三只神圣的金手镯维持着他仅存的意识，使他不断从深渊中挣扎着伸出双手。"
  },
  "npcs": [
    {
      "name": "亚斯特拉的安里",
      "name_en": "Anri of Astora",
      "kind": "Dialogue",
      "x": 1500,
      "y": 1100,
      "color": "#c0c0c0",
      "dialogue": [
        "……又见面了。",
        "霍拉斯不见了。我们走散了。",
        "他应该不在这个墓穴的深处……我担心他。",
        "如果你见到霍拉斯，请告诉我。",
        "我要继续向前。沃尼尔就在前方……我能感觉到。"
      ],
      "quest": "安里在卡萨斯的地下墓地中出现两次：第一次在骷髅球走廊附近的岔路口，第二次在绳索吊桥上方的石坡顶端。安里会询问玩家是否见到霍雷斯。玩家必须在击败沃尼尔之前前往熏烟湖击杀变为敌对的霍雷斯，否则安里的任务线会失败。"
    },
    {
      "name": "沉默的霍雷斯",
      "name_en": "Horace the Hushed",
      "kind": "Dialogue",
      "x": 1100,
      "y": 2100,
      "color": "#505050",
      "dialogue": [
        "……",
        "……"
      ],
      "quest": "霍雷斯不在卡萨斯的地下墓地中出现。他出现在熏烟湖的洞穴中，已变为空洞敌对状态。如果玩家告知安里霍雷斯的位置（或不告知），安里的任务线会走向不同结局。必须在击败沃尼尔之前在熏烟湖击杀霍雷斯。",
      "notes": "霍雷斯实际出现在熏烟湖，不在地下墓地中。此标记仅作为区域关联参考。"
    }
  ],
