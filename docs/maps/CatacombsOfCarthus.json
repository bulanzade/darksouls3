      "name_en": "Abandoned Tomb"
    }
  ],
  "map_layout": {
    "sections": [
      {
        "name": "入口阶梯",
        "description": "从法兰要塞乘坐升降梯下降，进入阴暗的地下墓穴入口。石阶两侧排列着骷髅和破损的石棺。火把映照出墙壁上的古卡萨斯纹饰。前方是第一条墓穴走廊。",
        "x": 0,
        "y": 0,
        "w": 600,
        "h": 700,
        "terrain_features": [
          "石阶",
          "石棺",
          "火把",
          "骷髅装饰墙"
        ]
      },
      {
        "name": "骷髅球走廊",
        "description": "一条宽阔的长廊，玩家会在此首次遇到骷髅球陷阱。巨大的骷髅球从走廊尽头滚落，沿途碾压一切。走廊两侧有凹室可以躲避，但也有骷髅敌人埋伏。",
        "x": 400,
        "y": 600,
        "w": 1000,
        "h": 400,
        "terrain_features": [
          "长走廊",
          "骷髅球滚道",
          "两侧凹室",
          "骷髅堆"
        ]
      },
      {
        "name": "下层墓室",
        "description": "骷髅球走廊尽头的岔路通向下层墓室。多个相连的石室中满是骷髅士兵和剑客。墙壁上嵌有卡萨斯时期的武器架和盾牌装饰。中央有一个小型祭祀台。",
        "x": 400,
        "y": 900,
        "w": 800,
        "h": 700,
        "terrain_features": [
          "相连石室",
          "祭祀台",
          "武器架",
          "暗角"
        ]
      },
      {
        "name": "绳索吊桥",
        "description": "一座摇晃的绳索吊桥横跨深不见底的深渊。骷髅会从桥对面涌来。玩家可以斩断桥的绳索使其坍塌，之后桥变为梯子可攀爬至下方区域。坍塌前可从上方 ledge 绕至桥对侧。",
        "x": 1200,
        "y": 400,
        "w": 1000,
        "h": 600,
        "terrain_features": [
          "绳索吊桥",
          "深渊",
          "可破坏的桥绳",
          "骷髅群"
        ]
      },
      {
        "name": "通向熏烟湖的密道",
        "description": "从深渊石桥的岔路向下延伸的狭窄隧道。越往深处走温度越高，空气中弥漫着硫磺的气味。隧道的尽头是一个巨大的洞口，可以看到下方熏烟湖的熔岩光芒。安里的同伴霍拉斯在湖畔变为敌对状态。",
        "x": 800,
        "y": 1500,
        "w": 700,
        "h": 900,
        "terrain_features": [
          "狭窄隧道",
          "温度升高",
          "熔岩光照",
          "隐秘洞口"
        ]
      },
      {
        "name": "沃尼尔战场",
        "description": "一片被黑暗笼罩的巨大空间。巨人王者沃尼尔从远处的黑暗雾墙中探出上半身，巨大的骷髅手臂上戴着闪亮的金手镯。地面平坦但四周被黑暗深渊包围，一旦被黑暗之雾吞噬即死。沃尼尔的巨剑横亘在前方。",
        "x": 2500,
        "y": 2300,
        "w": 1000,
        "h": 800,
        "terrain_features": [
          "平坦战场",
          "黑暗深渊",
          "雾墙",
          "骷髅巨剑"
        ]
      },
      {
        "name": "骸骨沉睡之间",
        "description": "一个有许多骷髅躺在地上的大厅。沿墙行走不会触发骷髅苏醒。房间内有遗体可搜刮。通过后右转上石坡可到达绳索吊桥的高台侧。",
        "x": 2200,
        "y": 1800,
        "w": 600,
        "h": 500,
        "terrain_features": [
          "地上的骷髅群",
          "遗体",
          "石坡通向吊桥高台"
        ]
      }
    ]
  },
