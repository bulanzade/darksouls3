{
  "id": "IrithyllDungeon",
  "name": "伊鲁席尔地下监牢",
  "name_en": "Irithyll Dungeon",
  "description": "冷冽谷地下的恐怖监狱，由教宗沙力万修建用于囚禁政敌和异端。阴冷潮湿的石质牢房沿螺旋状结构向下延伸，狱卒们手持提灯巡视，一旦发现囚犯便释放侵蚀灵魂的光芒，削减入侵者的最大生命值。最深处关押着暗术魔法师卡露菈和被囚禁的杰克巴尔多。地下牢的出口通向罪业之都。",
  "theme": "黑暗牢狱/刑具/阴冷蓝灰",
  "map_size": {
    "width": 3200,
    "height": 2800
  },
  "connections": {
    "from": [
      "IrithyllOfTheBorealValley"
    ],
    "to": [
      "ProfanedCapital"
    ]
  },
  "bonfires": [
    {
      "name": "伊鲁席尔地下监牢",
      "x": 300,
      "y": 300,
      "description": "从冷冽谷通过地下通道进入后的第一个篝火，位于牢狱上层",
      "name_en": "Irithyll Dungeon"
    },
    {
      "name": "罪业之都",
      "x": 2800,
      "y": 2400,
      "description": "地下牢最深处通往罪业之都的篝火，同时服务于两个区域",
      "name_en": "Profaned Capital"
    }
  ],
  "map_layout": {
    "sections": [
      {
        "name": "地下通道入口",
        "description": "从冷冽谷的地下水道进入的阴暗通道。潮湿的石壁上爬满霉菌，地面有积水。通道尽头是一扇铁门，通往地下牢上层。有两个狱卒在附近巡逻。",
        "x": 0,
        "y": 0,
        "w": 600,
        "h": 600,
        "terrain_features": [
          "石质通道",
          "积水地面",
          "铁栅门",
          "霉菌墙壁"
        ]
      },
      {
        "name": "上层牢房区",
        "description": "地下牢的上层区域，两侧排列着铁栅牢房。大部分牢房是空的，但部分牢房中有遗体和物品。狱卒提着提灯在走廊中巡逻，提灯光芒会削减玩家的最大生命值。走廊尽头有阶梯通往中层。",
        "x": 500,
        "y": 500,
        "w": 800,
        "h": 600,
        "terrain_features": [
          "铁栅牢房",
          "石质走廊",
          "阶梯",
          "狱卒提灯光源",
          "刑具残骸"
        ]
      },
      {
        "name": "刑讯室",
        "description": "中层区域的一个大型刑讯室。房间内有铁处女（铁处女刑具）、刑架和各种刑具。数个狱卒在此驻守。刑讯室旁边有一间需要牢房钥匙才能打开的特殊牢房，内有关卡露菈。",
        "x": 1200,
        "y": 900,
        "w": 600,
        "h": 500,
        "terrain_features": [
          "铁处女刑具",
          "刑架",
          "铁链",
          "特殊牢房（上锁）",
          "祭坛"
        ]
      },
      {
        "name": "地下水路",
        "description": "地下牢的中层通道，被地下水浸没。水中有巨大的老鼠潜伏。通道狭窄曲折，多处需要跳跃才能通过。这条水路连接牢房区和下层出口。",
        "x": 700,
        "y": 1000,
        "w": 600,
        "h": 800,
        "terrain_features": [
          "积水通道",
          "低矮天花板",
          "跳台",
          "老鼠巢穴",
          "瀑布"
        ]
      },
      {
        "name": "杰克巴尔多牢房",
        "description": "中层的一间特殊牢房，需要特定的钥匙才能打开。杰克巴尔多被困在这里。牢房外有一只石像鬼守卫。",
        "x": 1600,
        "y": 1100,
        "w": 400,
        "h": 400,
        "terrain_features": [
          "铁栅门（上锁）",
          "石壁牢房",
          "小窗",
          "遗体"
        ]
      },
      {
        "name": "下层走廊",
        "description": "地下牢最下层的长走廊，更加阴暗潮湿。两侧有更多牢房，其中部分可以通过侧面通道绕到后方开启。走廊尽头有石像鬼守卫的出口，通往罪业之都。",
        "x": 1800,
        "y": 1400,
        "w": 800,
        "h": 500,
        "terrain_features": [
          "长走廊",
          "侧面通道",
          "上锁牢房",
          "陷阱地面",
          "石像鬼巢穴"
        ]
      },
      {
        "name": "出口通道",
        "description": "通往罪业之都的上行通道。穿过最后的牢房区域后，通道逐渐向上攀升，空气变得灼热。通道尽头可以看到罪业之都的火焰光辉。",
        "x": 2200,
        "y": 1800,
        "w": 800,
        "h": 800,
        "terrain_features": [
          "上行阶梯",
          "灼热空气",
          "火焰光辉",
          "罪业之都远景"
        ]
      }
    ]
  },
