  "npcs": [
    {
      "name": "Siegward",
      "name_en": "Siegward of Catarina",
      "kind": "Dialogue",
      "x": 1800,
      "y": 1620,
      "color": "#D4A520",
      "dialogue": [
        "Hmm... Hmm... Ah, oh! Pardon me. I was absorbed in thought. Look at me, trapped like a rat. But you needn't worry. I've just been sitting here, weighing my options. The moment has almost come. ...I just need a bit more time.",
        "My liberation requires a key. But the key is outside... Hmm... A riddle for the ages...",
        "Ah! You are a saint! Once again, you are my valiant saviour. I, Siegward of Catarina, express my deepest gratitude. Take this, a token of my thanks. Go on, it's all yours.",
        "Ah, no, please, go on ahead. I've my own road to take. And a duty to fulfil, very soon..."
      ]
    },
    {
      "name": "Karla",
      "name_en": "Karla",
      "kind": "Merchant",
      "x": 1780,
      "y": 2560,
      "color": "#4A0080",
      "dialogue": [
        "Hm? Oh...you're not one of them, are you? Accept my apologies, for mistaking you for one of those leeches. So, what business have you here? This is a prison, and I am a prisoner. That should be enough for you.",
        "You're here to save me...? But I am guilty. A wretched child of the Abyss. Is that something you can forgive?",
        "Oh, really. You are no ordinary man. Very well. Besides, I've grown tired of imprisonment. I am Karla, and I accept your proposal.",
        "The only thing that might interest you is my sorcery. Although my dark arts are a detestable sort. That wouldn't interest you, would it?"
      ]
    },
    {
      "name": "Alva",
      "name_en": "Alva, Seeker of the Spurned",
      "kind": "Invader",
      "x": 1789,
