  "boss": {
    "type": "OldDemonKing",
    "name": "老恶魔王",
    "name_en": "Old Demon King",
    "x": 2700,
    "y": 2350,
    "hp": 2200,
    "arena": {
      "x": 2300,
      "y": 2100,
      "w": 800,
      "h": 600
    },
    "phases": [
      {
        "name": "恶魔余火",
        "hp_threshold": 1.0,
        "speed_multiplier": 0.7,
        "damage_multiplier": 1.0,
        "attack_cooldown": 3.0,
        "description": "老恶魔王行动缓慢但力量巨大。使用火焰吐息、身体横扫、巨锤砸击等攻击。他的身躯已经衰朽，体内残留着混沌之火。攻击范围广但动作前摇明显。",
        "mechanics": [
          "火焰吐息",
          "身体横扫",
          "巨锤砸击产生火焰冲击波",
          "身体冲撞"
        ]
      },
      {
        "name": "濒死爆燃",
        "hp_threshold": 0.3,
        "speed_multiplier": 0.5,
        "damage_multiplier": 1.5,
        "attack_cooldown": 4.0,
        "description": "生命值降至30%以下时，老恶魔王释放一次巨大的火焰爆炸，覆盖整个竞技场的大部分区域（玩家需要远离躲避）。爆炸后他的身体更加残破，但获得了更强大的火焰魔法。会释放延迟爆炸的火焰球、环形火焰冲击波等新招式。动作更慢但伤害极高。",
        "mechanics": [
          "濒死大爆炸（全场AOE）",
          "延迟爆炸火焰球",
          "环形火焰冲击波",
          "连续火焰吐息"
        ]
      }
    ],
    "attacks": [
      {
        "name": "火焰吐息",
        "type": "FireBreath",
        "damage": 60,
        "range": "中远",
        "parryable": false,
        "description": "向前方锥形区域喷射火焰，持续约2秒，覆盖范围较广"
      },
      {
        "name": "巨锤砸击",
        "type": "HammerSlam",
        "damage": 80,
        "range": "近",
        "parryable": false,
        "description": "举起巨锤重砸地面，产生火焰冲击波向两侧扩散"
      },
      {
        "name": "身体冲撞",
        "type": "BodyCharge",
        "damage": 55,
        "range": "远",
        "parryable": false,
        "description": "向玩家方向猛烈冲撞，速度较快，距离长"
      },
      {
        "name": "火焰横扫",
        "type": "FireSweep",
        "damage": 45,
        "range": "近中",
        "parryable": false,
        "description": "用武器横扫前方弧形区域，附带火焰伤害"
      },
      {
        "name": "濒死大爆炸",
        "type": "DeathExplosion",
        "damage": 120,
        "range": "全场",
        "parryable": false,
        "description": "进入第二阶段时释放，产生巨大火焰爆炸覆盖大部分场地，需远离Boss或在掩体后躲避。仅触发一次"
      },
      {
        "name": "延迟火焰球",
        "type": "DelayedFireOrb",
        "damage": 70,
        "range": "远",
        "parryable": false,
        "description": "向场地发射数个火焰球，落地后延迟1.5秒爆炸。第二阶段新增"
      },
      {
        "name": "环形火焰波",
        "type": "FireRingBurst",
        "damage": 65,
        "range": "中远",
        "parryable": false,
        "description": "以自身为中心释放环形火焰冲击波向外扩散，需要跳跃或翻滚躲避。第二阶段新增"
      },
      {
        "name": "连续火焰吐息",
        "type": "SustainedFireBreath",
        "damage": 50,
        "range": "中远",
        "parryable": false,
        "description": "持续喷射火焰并缓慢转动方向追踪玩家，持续约4秒。第二阶段新增"
      }
    ],
    "story": "老恶魔王是恶魔一族最后的王者。在混沌之火逐渐熄灭的时代，恶魔一族已走向灭绝。老恶魔王守护在恶魔遗迹的最深处，身躯已衰朽不堪，但体内仍残留着最初混沌之火的余烬。他是《黑暗之魂1》中混沌的温床——伊札里斯的遗迹中最后的守护者。击败他后，他会缓缓倒下，身上的火焰渐渐熄灭，象征着恶魔一族彻底终结。"
  },
