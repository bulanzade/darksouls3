  "boss": {
    "type": "YhormTheGiant",
    "name": "巨人尤姆",
    "name_en": "Yhorm the Giant",
    "x": 2500,
    "y": 2700,
    "hp": 3000,
    "arena": {
      "x": 1900,
      "y": 2400,
      "w": 1100,
      "h": 600
    },
    "phases": [
      {
        "name": "巨人守卫",
        "hp_threshold": 1.0,
        "speed_multiplier": 0.6,
        "damage_multiplier": 1.0,
        "attack_cooldown": 3.5,
        "description": "尤姆坐在王座上，待玩家进入后站起战斗。体型极为巨大，普通攻击只能造成微小伤害。场地中有一把暴风弯刀（Storm Ruler）可以拾取，使用其战技「暴风」可以对尤姆造成最大生命值15%的固定伤害。如果不使用暴风弯刀，战斗将极其漫长和危险。",
        "mechanics": [
          "暴风弯刀机制",
          "巨人踩踏",
          "巨剑横扫",
          "火焰践踏"
        ]
      },
      {
        "name": "罪业之火",
        "hp_threshold": 0.4,
        "speed_multiplier": 0.8,
        "damage_multiplier": 1.4,
        "attack_cooldown": 2.5,
        "description": "生命值降至40%以下时，尤姆变得更加狂暴，攻击频率加快。罪业之火从地面涌出，场地中多处出现火焰喷泉。尤姆的攻击附带火焰伤害，且会使用新的火焰践踏攻击。此时杰克巴尔多（如果任务线完成）会加入战斗，使用他自己的暴风弯刀。",
        "mechanics": [
          "攻击加速",
          "火焰附加伤害",
          "地面火焰喷泉",
          "杰克巴尔多参战"
        ]
      }
    ],
