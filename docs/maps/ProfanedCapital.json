          "隐藏巷道",
          "烧毁室内",
          "物品遗体"
        ]
      },
      {
        "name": "王座大道",
        "description": "通往巨人尤姆王座大厅的宽阔大道。两侧排列着巨大的石柱，地面有罪业之火留下的灼烧痕迹。大道尽头是巨大的拱门，通向Boss战场地。如果杰克巴尔多被释放，他会在这里出现。",
        "x": 1800,
        "y": 1900,
        "w": 800,
        "h": 500,
        "terrain_features": [
          "宽阔石柱大道",
          "灼烧痕迹",
          "巨型拱门",
          "杰克巴尔多出现点"
        ]
      },
      {
        "name": "尤姆王座大厅",
        "description": "巨人尤姆的Boss战场地。一个极其巨大的王座大厅，比例远超常人。尤姆坐在远端的王座上，身旁插着一把暴风弯刀。场地中央有巨大的石柱碎片可作为掩体。大厅的规模体现了尤姆作为巨人的体型。",
        "x": 1800,
        "y": 2300,
        "w": 1200,
        "h": 700,
        "terrain_features": [
          "巨型王座大厅",
          "暴风弯刀（可拾取）",
          "石柱碎片掩体",
          "罪业火焰",
          "巨型比例空间"
        ]
      }
    ]
