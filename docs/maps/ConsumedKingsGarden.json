    "trigger": "进入王座庭院自动触发",
    "phases": [
      {
        "name": "Staff Phase",
        "hp_threshold": 1.0,
        "speed_multiplier": 0.9,
        "damage_multiplier": 1.0,
        "attack_cooldown": 2.2,
        "description": "欧斯罗艾斯使用法杖进行攻击。他会挥动法杖两次、跳跃砸地、以及施放白雾（Pestilent Mist）在区域中制造伤害云。他对怀中看不见的婴儿轻声说话。靠近他的腹部比较安全。",
        "mechanics": [
          "法杖连击",
          "跳跃砸地",
          "白雾魔法（Pestilent Mist）",
          "对婴儿说话（语音）"
        ]
      },
      {
        "name": "Beast Phase",
        "hp_threshold": 0.7,
        "speed_multiplier": 1.4,
        "damage_multiplier": 1.3,
        "attack_cooldown": 1.4,
        "description": "当HP降至约70%时，欧斯罗艾斯凝视怀中的'欧塞洛特'，然后将其猛然摔向地面。他放弃法杖，变成野兽般的形态，四处冲撞。他可以衔接各种动作甚至转身和咆哮到冲锋攻击中。对头部造成8.78%最大HP的伤害可以触发致命一击。",
        "mechanics": [
          "野兽冲锋（可衔接任何动作）",
          "飞行水晶吐息+冲锋",
          "频繁冲锋连击",
          "头部致命一击弱点"
        ]
      }
    ],
    "attacks": [
      {
        "name": "法杖连击",
        "type": "StaffAttacks",
        "damage": 45,
        "range": "近",
        "parryable": false,
        "description": "挥动法杖进行两次攻击",
        "phase": 1
      },
      {
        "name": "跳跃砸地",
        "type": "JumpingSlam",
        "damage": 60,
        "range": "中",
        "parryable": false,
        "description": "跳起后猛力砸下",
        "phase": 1
      },
      {
        "name": "白雾",
        "type": "PestilentMist",
        "damage": 0,
        "range": "远",
        "parryable": false,
        "description": "施放白雾魔法，制造一个持续伤害的云区域。需要远离该区域",
        "phase": 1
      },
      {
        "name": "飞行水晶吐息",
        "type": "FlyingCrystals",
        "damage": 50,
        "range": "远",
        "parryable": false,
        "description": "第二阶段专属：飞到空中，向下方喷吐水晶，最后以冲锋收尾",
        "phase": 2
      },
      {
        "name": "野兽冲锋",
        "type": "BeastCharge",
        "damage": 70,
        "range": "远",
        "parryable": false,
        "description": "第二阶段专属：横穿整个竞技场的冲锋攻击。可以衔接各种动作甚至转身/咆哮到冲锋中",
        "phase": 2
      }
    ],
    "dialogue": [
      "啊……你来了……没关系……",
      "我的孩子……安静……安静……",
      "欧塞洛特……我的小欧塞洛特……",
      "（第二阶段开始）不……不！我的孩子！",
      "你在哪里……欧塞洛特！！",
      "（死亡）啊……没有……什么都没有……从一开始就……"
    ],
    "story": "欧斯罗艾斯是洛斯里克的先代国王，被称为'妖王'。他沉迷于龙化之道，在大书库中发现了对白龙希斯的扭曲崇拜。这种追求最终扭曲了他的身体和心智。他是洛斯里克王子和洛里安王子的父亲。他怀中抱着的婴儿欧塞洛特（Ocelotte）可能从未存在过——游戏数据中包含婴儿哭泣和被暴力杀害的音效文件，暗示在第二阶段转换时，欧斯罗艾斯在疯狂中亲手杀死了欧塞洛特。他的悲剧是整个《黑暗之魂》系列中关于'追求超越人性之物'这一主题的缩影。"
  },
