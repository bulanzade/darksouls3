    "trigger": "登上书库最高层，洛里安从王座上站起",
    "phases": [
      {
        "name": "兄长洛里安",
        "hp_threshold": 1.0,
        "speed_multiplier": 1.0,
        "damage_multiplier": 1.0,
        "attack_cooldown": 2.0,
        "description": "只与洛里安（兄）战斗。洛里安是身披重甲的高大骑士，手持燃烧的大剑。他能瞬间传送消失并从玩家背后出现。虽然他的双腿已残，但战斗力极为恐怖。",
        "mechanics": [
          "燃烧大剑",
          "瞬间传送",
          "传送后背后偷袭",
          "强力斩击"
        ]
      },
      {
        "name": "兄弟合体",
        "hp_threshold": 0.0,
        "speed_multiplier": 1.1,
        "damage_multiplier": 1.2,
        "attack_cooldown": 1.6,
        "description": "洛里安倒下后，洛斯里克（弟）从背后出现骑在洛里安身上。洛斯里克开始施放魔法：灵魂枪、治疗洛里安（复活）、光芒爆发。必须杀死洛斯里克才能结束战斗。若洛里安被击倒但洛斯里克存活，洛斯里克会施法复活洛里安。",
        "mechanics": [
          "洛斯里克骑乘",
          "魔法攻击",
          "复活兄长",
          "光芒AOE",
          "灵魂枪"
        ]
      }
    ],
    "attacks": [
      {
        "name": "烈焰大剑斩",
        "type": "FlameGreatswordSlash",
        "damage": 60,
        "range": "中",
        "parryable": true,
        "description": "燃烧大剑的水平横斩，附带火焰伤害"
      },
      {
        "name": "烈焰大剑下劈",
        "type": "FlameGreatswordSmash",
        "damage": 75,
        "range": "近",
        "parryable": true,
        "description": "高举大剑后猛力劈下，地面留下火焰"
      },
      {
        "name": "瞬间传送斩",
        "type": "TeleportSlash",
        "damage": 65,
        "range": "近",
        "parryable": true,
        "description": "传送消失后从玩家背后出现斩击"
      },
      {
