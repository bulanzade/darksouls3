  "map_layout": {
    "sections": [
      {
        "name": "书库入口大厅",
        "description": "宏伟的入口大厅，两侧是直达天花板的书架。中央有巨大的水晶吊灯和长桌，桌上散落着书籍与白蜡。学者法师在入口处巡逻。",
        "x": 0,
        "y": 0,
        "w": 800,
        "h": 800,
        "terrain_features": [
          "巨型书架",
          "水晶吊灯",
          "蜡烛堆",
          "石柱"
        ]
      },
      {
        "name": "第一层书廊",
        "description": "蜿蜒的书架走廊，有多个房间和隐藏通道。学者法师从书架后施放魔法攻击。走廊中有可推动的书架机关，通向秘密区域。",
        "x": 800,
        "y": 200,
        "w": 1000,
        "h": 700,
        "terrain_features": [
          "密集书架",
          "魔法陷阱",
          "隐藏门",
          "楼梯间"
        ]
      },
      {
        "name": "蜡池大厅",
        "description": "一个充满熔蜡的大厅，从天花板悬挂着无数蜡烛。地面的蜡池是玩家涂抹白蜡以免疫诅咒的关键地点。大厅通向上层的螺旋阶梯。",
        "x": 600,
        "y": 900,
        "w": 800,
        "h": 600,
        "terrain_features": [
          "蜡池（减速地形）",
          "悬挂蜡烛",
          "滑动地面",
          "高台"
        ]
      },
      {
        "name": "学者塔楼",
        "description": "书库中段的塔楼区域，有多层环形走廊。每层都有学者法师驻守，从高处向下施法。塔楼中心是开放式天井。",
        "x": 1400,
        "y": 700,
        "w": 600,
        "h": 800,
        "terrain_features": [
          "环形走廊",
          "天井",
          "高处平台",
          "窄桥连接"
        ]
      },
      {
        "name": "翼骑士走廊",
        "description": "通往书库上层的宽阔走廊，由翼骑士把守。走廊两侧的窗户可以看到洛斯里克城的壮丽全景。",
        "x": 1000,
        "y": 1500,
        "w": 800,
        "h": 500,
        "terrain_features": [
          "宽阔走廊",
          "大型窗户",
          "铠甲展示",
          "旗帜装饰"
        ]
      },
      {
        "name": "石像鬼屋顶",
        "description": "书库的屋顶区域，石像鬼在此伏击玩家。屋顶有多个高低不平的平台，可以眺望整个洛斯里克。通往孪生王子的最终阶梯在此。",
        "x": 1200,
        "y": 2000,
        "w": 800,
        "h": 600,
        "terrain_features": [
          "屋顶平台",
          "石像鬼雕像",
          "高低差地形",
          "天窗"
        ]
      },
      {
        "name": "王子宫殿",
        "description": "孪生王子的Boss战场地。洛斯里克最顶层的开阔宫殿，四周是巨大的彩色玻璃窗。中央有一张王座，洛里安坐在上面。战斗开始时洛里安缓缓站起。",
        "x": 1400,
        "y": 2800,
        "w": 800,
        "h": 800,
        "terrain_features": [
          "开阔宫殿",
          "彩色玻璃窗",
          "王座",
          "高台平台",
          "阳光照射"
        ]
      }
    ]
  },
