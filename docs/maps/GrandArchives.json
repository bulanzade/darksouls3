      {
        "name": "光之浪潮",
        "type": "LightSurge",
        "damage": 50,
        "range": "远",
        "parryable": false,
        "description": "第二阶段专属：洛斯里克释放光芒波"
      },
      {
        "name": "灵魂枪",
        "type": "SoulSpear",
        "damage": 55,
