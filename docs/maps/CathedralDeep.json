  "boss": {
    "type": "DeaconsOfTheDeep",
    "name": "幽邃主教群",
    "name_en": "Deacons of the Deep",
    "x": 2150,
    "y": 1850,
    "hp": 1500,
    "arena": {
      "x": 1850,
      "y": 1650,
      "w": 600,
      "h": 400
    },
    "phases": [
      {
        "name": "主教群",
        "hp_threshold": 1.0,
        "speed_multiplier": 1.3,
        "damage_multiplier": 1.0,
        "attack_cooldown": 1.5,
        "description": "一场群战。数十名主教组成人海。其中只有红眼主教是真正的目标——必须击杀红眼主教才能削减Boss的HP。普通主教死亡后会不断被替换。",
        "mechanics": [
          "群战",
          "红眼目标",
          "持续补充",
          "火焰弹幕"
        ]
      },
      {
        "name": "大司祭降临",
        "hp_threshold": 0.5,
        "speed_multiplier": 1.6,
        "damage_multiplier": 1.3,
        "attack_cooldown": 1.0,
        "description": "大司祭（Archdeacon）出现在祭坛处，开始引导幽邃诅咒球。诅咒球会持续追踪玩家。必须尽快击杀大司祭打断诅咒。此阶段火焰弹幕更加密集。",
        "mechanics": [
          "大司祭目标",
          "追踪诅咒球",
          "火焰弹幕增强",
          "幽邃光环"
        ]
      }
    ],
    "attacks": [
      {
        "name": "火焰爆发",
        "type": "FlameBurst",
        "damage": 40,
        "range": "远",
        "parryable": false,
        "description": "主教们发射追踪火焰弹。判定范围远达178像素。多枚同时发射时形成弹幕。需要横向移动躲避，不可格挡。"
      },
      {
        "name": "冲锋攻击",
        "type": "ChargeAttack",
        "damage": 35,
        "range": "中",
        "parryable": true,
        "description": "主教举起法杖向玩家冲锋。正前方88像素长、36像素宽的判定区域。是少数可以弹反的攻击。冲锋速度快但前摇明显。"
      },
      {
        "name": "圣光地面",
        "type": "HolyGround",
        "damage": 50,
        "range": "近-中",
        "parryable": false,
        "description": "大司祭在脚下释放范围性神圣冲击波。判定范围半径126像素。二阶段专属攻击。地面会出现明显的光圈预警。伤害高但前摇长（约0.5秒）。"
      }
    ],
    "story": "幽邃主教群是大教堂的守护者。他们信奉幽邃之力，在麦克唐纳大司祭的领导下进行黑暗仪式。幽邃是深渊的延伸——一种更加腐蚀、更加深邃的黑暗力量。大教堂原本是为了封印幽邃而建造，但最终主教们自己也被幽邃侵蚀。击败他们后获得小人偶（Small Doll），这是进入冷冽谷的必需道具。"
  },
  "npcs": [
    {
      "name": "卡塔利纳的杰克巴尔多",
      "name_en": "Siegward of Catarina",
      "kind": "Dialogue",
      "x": 1420,
      "y": 1320,
      "color": "#d4a840",
      "dialogue": [
        "……是你吗？",
        "我被困在这个井里了。真是丢脸啊……",
        "能帮帮我吗？附近应该有机关可以打开井盖。",
        "我会报答你的！卡塔利纳的骑士绝不会忘记恩情！"
      ],
      "quest": "被困在教堂净身小教会外的井中。需要找到机关释放。释放后他会在后续的冷冽谷中协助玩家对抗巨人尤姆。他也会出现在净身小教会篝火旁告诉你关于宝藏的事，然后帕奇斯会将你踢下巨人房间。"
    },
    {
      "name": "不屈不挠的帕奇斯",
      "name_en": "Unbreakable Patches",
      "kind": "Dialogue",
      "x": 1450,
      "y": 1100,
      "color": "#808080",
      "dialogue": [
        "嘿，你好啊！",
        "你也是来寻宝的吗？这里可是有不少好东西。",
        "看那边——那下面的宝物，闪闪发光！",
        "你不下去看看吗？……来，我帮你一把！"
      ],
      "quest": "帕奇斯以欺骗著称。他会引导玩家到中庭边缘然后踢下深坑。如果存活并再次找到他，他会道歉并出售物品。在原版中他是系列常驻的欺骗NPC。若杀死巨人后，帕奇斯会出现在巨人原来所在的位置。"
    },
    {
      "name": "罗莎莉亚",
      "name_en": "Rosaria, Mother of Rebirth",
      "kind": "Dialogue",
      "x": 3100,
      "y": 2300,
      "color": "#d0a0b0",
      "dialogue": [
        "……你来……为指……服务吗？",
        "（罗莎莉亚的声音低沉而嘶哑）",
        "给我苍白的舌头……作为誓约的证明……",
        "我可以……让你重生……改变你的样貌和力量……"
      ],
      "quest": "罗莎莉亚的指誓约（Rosaria's Fingers）的领导者。加入誓约需要献上苍白舌头。她可以重新分配玩家的属性点（每次重生需要苍淡的舌头）和改变外貌。在原版中，给予她苍淡的舌头5次后可能触发与里奥尼尔的特殊事件。"
    },
    {
      "name": "亚斯特拉的安里",
      "name_en": "Anri of Astora",
      "kind": "Summon",
      "x": 2050,
      "y": 1750,
      "color": "#c0c0c0",
      "dialogue": [
        "（召唤符号出现）",
        "……我也来帮忙吧。为了找到深渊监视者。"
      ],
      "quest": "安里可在幽邃主教群Boss战前被召唤。召唤符号在祭坛旁。如果霍雷斯在熏烟湖被击杀，安里的召唤符号不会出现。"
    },
