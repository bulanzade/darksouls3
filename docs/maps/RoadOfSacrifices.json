  "npcs": [
    {
      "name": "Anri of Astora",
      "name_en": "Anri of Astora",
      "kind": "Dialogue",
      "x": 1400,
      "y": 1140,
      "color": "#C0C0C0",
      "dialogue": [
        "Oh, hello. How do you do? I am Anri of Astora. Unkindled, like you. This is Horace, a friend and travelling companion. Are you too in search of the Lords of Cinder?",
        "We are well along the road of sacrifices. Below us is the Crucifixion Woods. Beyond the flooded woods lies Farron Keep, home of the Undead Legion. Further yet is the Cathedral of the Deep. We seek the cathedral, home of the grim Aldrich.",
        "Oh, yes, Horace... He's not very talkative. But don't think ill of him. He's an upstanding, kind-hearted knight; a fine partner for this gruelling journey."
      ]
    },
    {
      "name": "Horace the Hushed",
      "name_en": "Horace the Hushed",
      "kind": "Dialogue",
      "x": 1500,
      "y": 1140,
      "color": "#606060",
      "dialogue": [
