        "h": 700
      },
      "trigger": "进入飞龙竞技场自动触发",
      "is_gimmick": true,
      "phases": [
        {
          "name": "飞龙巡空",
          "hp_threshold": 1.0,
          "speed_multiplier": 0.8,
          "damage_multiplier": 1.0,
          "attack_cooldown": 3.0,
          "description": "远古飞龙在竞技场上空盘旋，定期俯冲喷火。玩家需要沿着山壁的阶梯向上攀登，到达高处的跳台。飞龙的火焰覆盖面积极大。",
          "mechanics": [
            "空中盘旋",
            "俯冲喷火",
            "地面火焰残留",
            "必须攀登高处"
          ]
        }
      ],
      "attacks": [
        {
          "name": "火焰吐息",
          "type": "DragonFireBreath",
          "damage": 80,
          "range": "远",
          "parryable": false,
          "description": "从空中向下喷射火焰，覆盖大片区域"
        },
        {
          "name": "俯冲攻击",
          "type": "DiveAttack",
          "damage": 60,
          "range": "中",
          "parryable": false,
          "description": "向玩家位置俯冲，翅膀造成范围伤害"
        },
        {
          "name": "地面火焰",
          "type": "GroundFire",
          "damage": 45,
          "range": "中",
          "parryable": false,
          "description": "飞过的路径留下火焰痕迹"
        }
      ],
      "kill_method": "机关杀：从高处的跳台进行跳下攻击（坠落攻击），一击必杀。飞龙的HP虽高但坠落攻击无视HP直接击杀。",
      "story": "远古飞龙是古龙顶端的守护者之一，是真正古龙的后裔。与洛斯里克城堡的飞龙不同，它仍然保留着完整的力量。击败它的方法——从高处跳下进行致命一击——是对古龙猎杀传统的致敬。"
    },
