            "攻击龙头才有效",
            "闪电俯冲",
            "龙息攻击",
            "视角被风暴遮挡"
          ]
        },
        {
          "name": "剑神降临",
          "hp_threshold": 0.0,
          "speed_multiplier": 1.3,
          "damage_multiplier": 1.5,
          "attack_cooldown": 1.2,
          "description": "风暴之王被击倒后，无名王者亲自下场。他手持注入雷电的剑枪，速度和力量都达到极致。他会将武器插入地面释放雷电风暴，进行超远距离的冲刺攻击，以及致命的连击。被认为是《黑暗之魂3》最难的Boss之一。",
          "mechanics": [
            "雷电剑枪",
            "地面雷电",
            "超远冲刺",
            "致命连击",
            "风暴冲击波"
          ]
        }
