  "boss": [
    {
      "type": "AncientWyvern",
      "name": "远古飞龙",
      "name_en": "Ancient Wyvern",
      "x": 1300,
      "y": 1200,
      "hp": 9999,
      "arena": {
        "x": 900,
        "y": 800,
