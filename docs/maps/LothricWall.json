  "boss": [
    {
      "type": "Vordt",
      "name": "冷冽谷玻尔多",
      "name_en": "Vordt of the Boreal Valley",
      "x": 2750,
      "y": 2150,
      "hp": 1100,
      "arena": {
        "x": 2450,
        "y": 1950,
        "w": 600,
        "h": 400
      },
      "phases": [
        {
          "name": "冰霜巡逻",
          "hp_threshold": 1.0,
          "speed_multiplier": 1.1,
          "damage_multiplier": 1.0,
          "attack_cooldown": 2.0,
          "description": "波尔多是一只形似野兽的骑士，手持冰锤。此阶段以冰锤冲锋和冰息攻击为主。移动模式相对可预测，会在场地中巡逻。",
          "mechanics": [
            "冰锤冲锋",
            "冰息喷射",
            "缓慢巡逻"
          ]
        },
        {
          "name": "冰霜狂暴",
          "hp_threshold": 0.4,
          "speed_multiplier": 1.5,
          "damage_multiplier": 1.3,
          "attack_cooldown": 1.5,
          "description": "波尔多获得冰霜加持，身体散发出蓝色冰雾。移动速度大幅提升，攻击更加凶猛。新增跳砸攻击——跃至高空后猛然落地，造成大范围冲击波。此阶段攻击频率显著增加。",
          "mechanics": [
            "冰霜加持",
            "跳砸攻击",
            "高频率冲锋",
            "冰雾扩散"
          ]
        }
      ],
      "attacks": [
        {
          "name": "冰锤冲锋",
          "type": "IceMaceCharge",
          "damage": 40,
          "range": "中-远",
          "parryable": true,
          "description": "波尔多举起冰锤，向玩家方向快速冲锋横扫。判定范围正前方92像素长、44像素宽。冲锋判定持续较久（0.20-0.90），有充足时间翻滚躲避。"
        },
        {
          "name": "冰息喷射",
          "type": "IceBreadth",
          "damage": 35,
          "range": "近-中",
          "parryable": false,
          "description": "从口中喷射锥形冰雾。判定为扇形范围，最远达132像素，宽度随距离增加。会造成减速效果。近战时如果正面站着很容易被喷中，建议绕侧面。"
        },
        {
          "name": "跳砸",
          "type": "LeapingSlam",
          "damage": 55,
          "range": "远",
          "parryable": false,
          "description": "二阶段新增。波尔多跳至高空后猛然落地，造成大范围冲击波。判定范围半径116像素。前摇明显（跳跃动画约0.5秒），落下后有短暂硬直可输出。是主要的输出窗口。"
        }
      ],
      "story": "波尔多是冷冽谷出身的骑士，被教宗沙力万派遣至洛斯里克的高墙。他原本是教宗的冷冽骑士团成员，后来被转化为野兽般的形态。与冷冽谷的教宗骑士和舞娘一样，他身上散发着永恒的冰霜。击败他后，玩家可以继续前往不死聚落。在后续剧情中，如果玩家将小环旗的誓约盆放置在高墙教堂的祭坛上，将触发与舞娘的Boss战。"
    },
    {
      "type": "DancerOfTheBorealValley",
      "name": "冷冽谷的舞娘",
      "name_en": "Dancer of the Boreal Valley",
      "x": 500,
      "y": 400,
      "hp": 3500,
      "arena": {
        "x": 300,
        "y": 250,
        "w": 400,
        "h": 300
      },
      "phases": [
        {
          "name": "优雅之舞",
          "hp_threshold": 1.0,
          "speed_multiplier": 1.0,
          "damage_multiplier": 1.0,
          "attack_cooldown": 2.5,
          "description": "舞娘使用双弯曲剑进行优雅但致命的攻击。初期动作缓慢但判定精准，攻击以弧形斩击和旋转为主。",
          "mechanics": [
            "双弯曲剑",
            "优雅旋转",
            "缓慢开场"
          ]
        },
        {
          "name": "深渊之怒",
          "hp_threshold": 0.5,
          "speed_multiplier": 1.5,
          "damage_multiplier": 1.3,
          "attack_cooldown": 1.2,
          "description": "生命值降至50%以下时，舞娘进入狂暴状态。攻击速度和连击数大幅增加，会连续使用3-5次快速斩击。",
          "mechanics": [
            "狂暴加速",
            "连续斩击",
            "深渊光环"
          ]
        }
      ],
      "attacks": [
        {
          "name": "优雅横斩",
          "type": "GracefulSlash",
          "damage": 35,
          "range": "近",
          "parryable": true
        },
        {
          "name": "旋转连斩",
          "type": "SpinningCombo",
          "damage": 30,
          "range": "近中",
          "parryable": true
        },
        {
          "name": "突刺",
          "type": "LungeThrust",
          "damage": 40,
          "range": "中",
          "parryable": true
        },
        {
          "name": "深渊旋风",
          "type": "AbyssVortex",
          "damage": 45,
          "range": "近中",
          "parryable": false
        }
      ],
      "dialogue": [
        "（舞娘从黑暗中缓缓走出，双刃在月光下闪烁）"
      ],
      "story": "冷冽谷的舞娘是教宗沙力万的女骑士。在艾玛（Emma）将誓约盆交给玩家后，她会出现在洛斯里克高墙的教堂中。她的身份一直神秘，据传她与沙力万有深渊的关联。她是玩家通往洛斯里克城堡的必经之路。"
    }
  ],
  "npcs": [
    {
      "name": "艾玛",
      "name_en": "Emma",
      "kind": "Dialogue",
      "x": 2150,
      "y": 1150,
      "color": "#c0a0d0",
      "dialogue": [
        "你好，无火的灰烬。",
        "我是艾玛，洛斯里克的高阶女祭司。",
        "洛斯里克王子……他已无心继任薪王之位。",
        "请找到他，将这小环旗交给他吧。",
        "也许……这能唤醒他心中的火焰。"
      ],
      "quest": "给予玩家小环旗（Small Lothric Banner）。在玩家击败教宗沙力万后，将誓约盆放置在祭坛上会触发与舞娘的Boss战。艾玛死亡后留下誓约盆。"
    },
    {
      "name": "葛雷瑞特",
      "name_en": "Greirat",
      "kind": "Dialogue",
      "x": 1550,
      "y": 800,
      "color": "#a0a0a0",
      "dialogue": [
        "……你是谁？是来放我出去的吗？",
        "如果你能帮我找到牢房钥匙，我愿意为你效劳。",
        "我是个小偷，但我知道感恩。",
        "拜托了，我只想再见罗蕾塔一面……"
      ],
      "quest": "需要牢房钥匙才能释放。释放后加入传火祭祀场成为商人，出售各种道具。赠送蓝泪石戒指（Blue Tearstone Ring）。后续可以派遣他去偷窃（不死聚落、冷冽谷、洛斯里克城），但第三次偷窃可能死亡。"
    },
    {
      "name": "青教誓约",
      "name_en": "Way of Blue",
      "kind": "Covenant",
      "x": 2050,
      "y": 1100,
      "color": "#6080c0",
      "dialogue": [],
      "quest": "在教堂区域的遗体上拾取青教誓约（Way of Blue），加入后可在被入侵时召唤蓝色卫士。"
    }
  ],
