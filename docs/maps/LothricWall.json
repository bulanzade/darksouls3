  "map_layout": {
    "sections": [
      {
        "name": "城墙入口",
        "description": "从传火祭祀场传送至高墙的入口区域。宽阔的石质城墙向远处延伸，两侧可见洛斯里克城的壮观景色。几名空心士兵在城墙上巡逻。",
        "x": 0,
        "y": 0,
        "w": 600,
        "h": 600,
        "terrain_features": [
          "城墙",
          "石阶",
          "旗帜",
          "远景城墙"
        ]
      },
      {
        "name": "骑士庭院",
        "description": "被高墙环绕的内部庭院。洛斯里克骑士在此驻守，是玩家首次遭遇重甲骑士的区域。庭院中央有枯死的树木，角落有宝箱。",
        "x": 500,
        "y": 500,
        "w": 600,
        "h": 500,
        "terrain_features": [
          "庭院",
          "枯树",
          "石柱",
          "宝箱角落"
        ]
      },
      {
        "name": "飞龙屋顶",
        "description": "一条通往屋顶的狭长通道，尽头是一条被飞龙焚烧的桥梁。飞龙（带有人之脓）趴在屋顶上持续喷火。地上散落着被烧焦的遗体和珍贵物品。需要利用时机穿过火焰拾取战利品。",
        "x": 900,
        "y": 300,
        "w": 700,
        "h": 500,
        "terrain_features": [
          "屋顶",
          "龙焰",
          "烧焦地面",
          "飞龙"
        ]
      },
      {
        "name": "民房区域",
        "description": "城墙内侧的密集民房。狭窄的巷道和多层建筑构成迷宫般的布局。空心农民和刺客在暗处潜伏。某间牢房中关押着囚徒葛雷瑞特。",
        "x": 1400,
        "y": 600,
        "w": 600,
        "h": 600,
        "terrain_features": [
          "民房",
          "窄巷",
          "牢房",
          "多层结构",
          "暗角"
        ]
      },
      {
        "name": "教堂区",
        "description": "高墙深处的小教堂。艾玛——高阶女祭司在此等待。教堂内有宝箱和物品。从这里可以通往通往波尔多的阶梯。",
        "x": 2000,
        "y": 1000,
        "w": 500,
        "h": 400,
        "terrain_features": [
          "教堂",
          "祭坛",
          "彩窗",
          "阶梯"
        ]
      },
      {
        "name": "冰霜阶梯",
        "description": "通往波尔多Boss战场的长阶梯。阶梯两侧有雕塑和冰霜痕迹。越往下走，空气越发冰冷，冰霜覆盖了石阶。",
        "x": 2300,
        "y": 1400,
        "w": 400,
        "h": 600,
        "terrain_features": [
          "长阶梯",
          "冰霜",
          "雕塑",
          "降雪"
        ]
      },
      {
        "name": "波尔多竞技场",
        "description": "Boss战场地。阶梯底部的开阔冰原。地面上覆盖着薄冰和积雪。击败波尔多后，远处可见不死聚落。",
        "x": 2400,
        "y": 1900,
        "w": 700,
        "h": 500,
        "terrain_features": [
          "冰原",
          "开阔场地",
          "积雪",
          "远处聚落"
        ]
      }
    ]
  },
