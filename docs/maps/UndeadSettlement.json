  "boss": {
    "type": "CurseRottedGreatwood",
    "name": "咒蚀大树",
    "name_en": "Curse-Rotted Greatwood",
    "x": 2000,
    "y": 1800,
    "hp": 5405,
    "arena": {
      "x": 1650,
      "y": 1550,
      "w": 700,
      "h": 500
    },
    "phases": [
      {
        "name": "蛋囊破坏",
        "hp_threshold": 1.0,
        "speed_multiplier": 0.8,
        "damage_multiplier": 1.0,
        "attack_cooldown": 3.0,
        "description": "咒蚀大树是一棵巨大腐败的古树，身上长满了蛋囊（弱点）。玩家必须攻击蛋囊才能造成有效伤害。大树会用横扫和砸地攻击驱赶玩家。此阶段场地是开阔的地面层。",
        "mechanics": [
          "蛋囊弱点",
          "横扫攻击",
          "砸地攻击",
          "缓慢移动"
        ]
      },
      {
        "name": "坠落深渊",
        "hp_threshold": 0.6,
        "speed_multiplier": 1.0,
        "damage_multiplier": 1.1,
        "attack_cooldown": 2.5,
        "description": "当破坏足够蛋囊后，地板崩塌，玩家和大树一同坠入下方的空洞。大树在深渊中获得新的攻击方式——手臂横扫。需要继续破坏剩余蛋囊。",
        "mechanics": [
          "地板崩塌",
          "手臂横扫",
          "新蛋囊",
          "狭窄空间"
        ]
      },
      {
        "name": "诅咒核心",
        "hp_threshold": 0.3,
        "speed_multiplier": 1.2,
        "damage_multiplier": 1.3,
        "attack_cooldown": 2.0,
        "description": "大树露出核心部位的最终蛋囊。攻击更加疯狂频繁，横扫和砸地交替使用。核心位于大树腹部下方，需要冒险钻到树下攻击。",
        "mechanics": [
          "核心暴露",
          "高速连击",
          "腹部弱点"
        ]
      }
    ],
    "attacks": [
      {
        "name": "砸地",
        "type": "GroundSlam",
        "damage": 45,
        "range": "近-中",
        "parryable": false,
        "description": "大树抬起肢体猛然砸地，造成范围冲击波并可能释放腐蚀液体。判定范围半径110像素。前摇明显约0.4秒。"
      },
      {
        "name": "横扫",
        "type": "SweepAttack",
        "damage": 40,
        "range": "近-中",
        "parryable": false,
        "description": "大树用手臂/根须进行大范围横扫。判定范围半径104像素，覆盖前方大部分区域。翻滚穿过后有短暂输出窗口。"
      },
      {
        "name": "倒压",
        "type": "BodySlam",
        "damage": 50,
        "range": "远",
        "parryable": false,
        "description": "大树整体向玩家方向倾倒压下。判定范围正前方105像素长、58像素宽。前摇较长，容易躲避但伤害很高。"
      },
      {
        "name": "抓投",
        "type": "GrabAttack",
        "damage": 60,
        "range": "近",
        "parryable": false,
        "description": "双臂环抱抓取玩家后猛摔。第二阶段白色手臂的抓投攻击特别危险。站在胸前蛋囊正前方可完全避免。"
      },
      {
        "name": "旋转",
        "type": "SpinAttack",
        "damage": 35,
        "range": "近-中",
        "parryable": false,
        "description": "双手撑地后快速360度旋转。手臂和腿部命中判定。需远离或翻滚利用无敌帧。"
      },
      {
        "name": "侧滚",
        "type": "RollAttack",
        "damage": 45,
        "range": "近",
        "parryable": false,
        "description": "大树侧身翻滚试图碾压玩家。向侧面躲避为佳，滚后可趁机输出。"
      },
      {
        "name": "连砸",
        "type": "ArmPound",
        "damage": 40,
        "range": "近-中",
        "parryable": false,
        "description": "第二阶段：腹部白色手臂向玩家方向连砸2-3次。每次有小范围AoE效果。最好翻滚躲避，同时绕到背后攻击蛋囊。"
      }
    ],
    "story": "咒蚀大树是不死聚落深处的古老存在。它最初被聚落居民崇拜为神圣之物，后来被诅咒侵蚀，成为吞噬一切的腐败存在。大树身上的蛋囊实际上是诅咒的结晶。击败大树后掉落灵魂炼成台（Transposing Kiln），这是将Boss灵魂转化为武器和道具的关键道具。",
    "drops": [
      {
        "name": "咒蚀大树的灵魂",
        "name_en": "Soul of the Rotted Greatwood"
      },
      {
        "name": "灵魂炼成炉",
        "name_en": "Transposing Kiln"
      }
    ]
  },
  "npcs": [
    {
      "name": "杰克塔尔的洋葱骑士",
      "name_en": "Siegward of Catarina",
      "kind": "Dialogue",
      "x": 1050,
      "y": 450,
      "color": "#d4a840",
      "dialogue": [
        "嗯？哦，你好啊！",
        "我是杰克塔尔的杰克迈耶。你可以叫我洋葱骑士。",
        "你也是来旅游的吗？这里的风景确实不错……如果不考虑那些怪物的话。",
        "前面有个火焰恶魔，看起来不太好对付。",
        "要不要一起去？两个总比一个好！"
      ],
      "quest": "首次在教堂大门遇见。在电梯下降途中可听到他的声音，跳到窗台上对话。协助玩家击败火恶魔后赠送杰克啤酒并教授干杯和睡觉动作。后续在幽邃教堂的井中再次出现（需要帮助他出井），在冷冽谷与巨人战斗时协助。最终在罪业之都独自击败巨人王，若完成全任务线则获得杰克的铠甲套装。"
    },
    {
      "name": "隆道尔的尤艾尔",
      "name_en": "Yoel of Londor",
      "kind": "Dialogue",
      "x": 2300,
      "y": 700,
      "color": "#505060",
      "dialogue": [
        "你也是……无火的灰烬吗？",
        "我是尤艾尔，来自隆道尔的朝圣者。",
        "这副身体已经快不行了……但是在我完全死去之前，",
        "我可以给你一份力量。免费的，不需要回报。",
        "来吧，让我触碰你的黑暗……"
      ],
      "quest": "提供最多5次免费升级（每次在死亡后获得），但每次升级都会在玩家身上留下黑暗印记（Dark Sigil）。收集全部5个黑暗印记后，尤莉雅会出现在祭祀场。如果拒绝所有升级，尤艾尔会在到达冷冽谷后死亡。"
    },
    {
      "name": "大沼的柯弭库斯",
      "name_en": "Cornyx of the Great Swamp",
      "kind": "Dialogue",
      "x": 1900,
      "y": 550,
      "color": "#a08050",
      "dialogue": [
        "嘿！嘿！有人吗？！",
        "我被关在这个铁笼里了！求求你放我出去！",
        "我是咒术师柯弭库斯。如果你放了我，我可以教你咒术！",
        "拜托了，这里的味道实在太糟糕了……"
      ],
      "quest": "被关在铁笼中，互动后释放并加入传火祭祀场成为咒术教师。给予他咒术卷轴可解锁新咒术。完成所有卷轴交付后在祭祀场死亡，留下遗物。"
    },
    {
      "name": "卡里姆的伊莉娜",
      "name_en": "Irina of Carim",
      "kind": "Dialogue",
      "x": 2650,
      "y": 850,
      "color": "#d0a0c0",
      "dialogue": [
        "……是谁？",
        "我是伊莉娜，来自卡里姆的盲眼少女。",
        "我被关在这里很久了……外面的艾葛恩一直在保护我。",
        "如果你能带我离开这里……我可以为你解读奇迹经文。",
        "但是……请不要给我黑暗的经文……"
      ],
      "quest": "被关押在聚落深处。释放后加入祭祀场成为奇迹教师。给予她圣洁的奇迹点书可解锁光明系奇迹。如果给予黑暗的奇迹点书，她会堕落并变为黑暗祭司。"
    },
    {
      "name": "卡里姆的伊贡",
      "name_en": "Eygon of Carim",
      "kind": "Dialogue",
      "x": 2580,
      "y": 820,
      "color": "#606060",
      "dialogue": [
        "停在那里。",
        "后面的女人归我保护。",
        "如果你没有恶意，那就走开。",
        "……如果你真想帮她，那把钥匙拿来。"
      ],
      "quest": "守卫伊莉娜的骑士。最初对玩家保持警惕。伊莉娜被释放后会跟随艾葛恩。若伊莉娜堕落，艾葛恩会在祭祀场变为敌对并攻击玩家。若伊莉娜安全，艾葛恩会在后续剧情中安详死去。"
    }
