          "窄街",
          "屋顶通道",
          "悬挂尸体"
        ]
      },
      {
        "name": "巨人塔",
        "description": "聚落中央矗立着一座高塔，塔顶栖息着一位友善的巨人。巨人会向下方投掷长矛帮助玩家消灭敌人。需要攀爬塔身才能到达塔顶与巨人交谈。",
        "x": 1000,
        "y": 300,
        "w": 500,
        "h": 600,
        "terrain_features": [
          "高塔",
          "巨人",
          "长矛雨",
          "攀爬路径"
        ]
      },
      {
        "name": "篝火广场",
        "description": "一处开阔的广场，中央有巨大的篝火。传教士在此举行仪式，周围堆满了尸体。杰克塔尔的洋葱骑士在阳台上休息。广场下方有通往地洞的入口。",
        "x": 1400,
        "y": 700,
        "w": 500,
        "h": 400,
        "terrain_features": [
          "大篝火",
          "广场",
          "尸体堆",
          "地洞入口"
        ]
      },
      {
        "name": "铁笼道",
        "description": "沿着悬崖边修建的栈道，途中可以看到被关在铁笼里的寇尔尼斯（咒术师NPC）。下方是万丈深渊。道旁有传教士和刺客出没。",
        "x": 1800,
        "y": 500,
        "w": 500,
        "h": 400,
        "terrain_features": [
          "悬崖栈道",
          "铁笼",
          "深渊",
          "窄路"
        ]
      },
      {
        "name": "火恶魔广场",
        "description": "一处与火焰恶魔战斗的开阔区域。洋葱骑士会在此协助玩家。恶魔被击败后洋葱骑士会表示感谢。这是唯一有NPC协助的战斗。",
        "x": 2000,
        "y": 900,
        "w": 400,
        "h": 400,
        "terrain_features": [
          "开阔广场",
          "恶魔残迹",
          "碎石",
          "火焰痕迹"
        ]
      },
      {
        "name": "朝圣者营地",
        "description": "约埃尔和其他朝圣者聚集的区域。灰色的石砌建筑旁，朝圣者趴在地上。约埃尔在此提供免费的升级（力量），代价是玩家的黑暗印记。",
        "x": 2200,
        "y": 600,
        "w": 400,
        "h": 300,
        "terrain_features": [
          "朝圣者群",
          "石砌建筑",
          "灰暗角落",
          "约埃尔的据点"
        ]
      },
      {
        "name": "地洞深渊",
        "description": "咒蚀大树的Boss战场。从篝火广场的地洞跳下进入。一个巨大的地下空洞，到处是树根和腐殖质。中央盘踞着巨大的咒蚀大树，树身上长满了蛋囊。",
        "x": 1600,
        "y": 1500,
        "w": 800,
        "h": 600,
        "terrain_features": [
          "地下空洞",
          "巨树根",
          "蛋囊",
          "腐殖质地面",
          "崩塌地板"
        ]
      },
      {
        "name": "伊莉娜囚室",
        "description": "聚落深处的一间囚室，奇迹师伊莉娜被关押在此。她的守护者艾葛恩守在门外。需要购买钥匙才能释放伊莉娜。",
        "x": 2600,
        "y": 800,
        "w": 300,
        "h": 300,
        "terrain_features": [
          "囚室",
          "铁门",
          "石墙",
          "暗角"
        ]
      }
    ]
  },
