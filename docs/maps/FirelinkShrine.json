  "npcs": [
    {
      "name": "防火女",
      "name_en": "Fire Keeper",
      "kind": "LevelUp",
      "x": 1240,
      "y": 960,
      "color": "#FFFFFF",
      "dialogue": [
        "Welcome to the bonfire, Unkindled One.",
        "I am a Fire Keeper.",
        "I tend to the flame, and tend to thee.",
        "The Lords have left their thrones, and must be deliver'd to them. To this end, I am at thy side."
      ]
    },
    {
      "name": "库尔兰的鲁道斯",
      "name_en": "Ludleth of Courland",
      "kind": "Dialogue",
      "x": 1320,
      "y": 1024,
      "color": "#DAA520",
      "dialogue": [
        "Peace. I am Ludleth of Courland.",
        "Let me ask you this. Is it not the nature of a Lord, to sacrifice himself for his people?",
        "Ah, it singeth, to the bone."
      ]
    },
    {
      "name": "亚斯特拉的安德烈",
      "name_en": "Andre of Astora",
      "kind": "Blacksmith",
      "x": 580,
      "y": 1080,
      "color": "#C0C0C0",
      "dialogue": [
        "What do you need? A weapon? I'll smith it.",
        "Name's Andre, and I smith weapons.",
        "I can smith most anything. Blades, shields, armour. The whole lot."
      ]
    },
    {
      "name": "祭祀场侍女",
      "name_en": "Shrine Handmaiden",
      "kind": "Merchant",
      "x": 1960,
      "y": 1080,
      "color": "#8B7355",
      "dialogue": [
        "What is it? Buy something",
        "I'll trade your souls for these goods",
        "Visit again"
      ]
    },
    {
      "name": "霍克伍德",
      "name_en": "Hawkwood",
      "kind": "Dialogue",
      "x": 1400,
      "y": 1100,
      "color": "#7F8C8D",
      "dialogue": [
        "Oh, another Unkindled.",
        "What do you want? I have nothing for you.",
        "The Undead Legion of Farron. They were a fierce bunch."
      ]
    },
    {
      "name": "尤莉亚",
      "name_en": "Yuria of Londor",
      "kind": "Dialogue",
      "x": 1824,
      "y": 1216,
      "color": "#2A1A3A",
      "dialogue": [
        "I am Yuria of Londor, a servant of the Lord of Hollows.",
        "Thou art the Lord of Hollows.",
        "The fire bendeth to thy will.",
        "Let us embrace the age of hollows, together."
      ]
    },
    {
      "name": "指头的列奥纳德",
      "name_en": "Ringfinger Leonhard",
      "kind": "Dialogue",
      "x": 1472,
      "y": 1504,
      "color": "#8B0000",
      "dialogue": [
        "You have a good look.",
        "I am Leonhard. I have a proposition for you.",
        "Take this Cracked Red Eye Orb.",
        "Invade and pillage the souls of others."
      ]
    },
    {
      "name": "尤艾尔",
      "name_en": "Yoel of Londor",
      "kind": "Dialogue",
      "x": 896,
      "y": 1408,
      "color": "#3A3A4A",
      "dialogue": [
        "I am Yoel of Londor. A pilgrim, as they call me.",
        "I can draw out your true strength.",
        "Come. Touch the darkness within me.",
        "Take nourishment from these sovereignless souls."
      ]
    },
    {
      "name": "格雷瑞特",
      "name_en": "Greirat",
      "kind": "Merchant",
      "x": 832,
      "y": 1472,
      "color": "#5A5A5A",
      "dialogue": [
        "I am Greirat of the Undead Settlement.",
        "You saved me from that cell. I owe you everything.",
        "I can steal items for you, if you like.",
        "Just leave it to old Greirat."
      ]
    },
    {
      "name": "科尔尼克斯",
      "name_en": "Cornyx",
      "kind": "Merchant",
      "x": 1184,
      "y": 1280,
      "color": "#8B6914",
      "dialogue": [
        "I am Cornyx, a pyromancer of the Great Swamp.",
        "You freed me from my cage, and for that I am grateful.",
        "Bring me pyromancy tomes, and I shall teach you their arts.",
        "The flame is a wondrous thing."
      ]
    },
    {
      "name": "维恩海姆的欧贝克",
      "name_en": "Orbeck of Vinheim",
      "kind": "Merchant",
      "x": 1376,
      "y": 1184,
      "color": "#7090B0",
      "dialogue": [
        "I am Orbeck of Vinheim. A sorcerer, and an assassin.",
        "I shall teach you sorceries, as promised.",
        "Bring me scrolls, and I shall decipher them.",
        "But if you prove talentless, our arrangement ends."
      ]
    },
    {
      "name": "日蚀的希里斯",
      "name_en": "Sirris of the Sunless Realms",
      "kind": "Dialogue",
      "x": 1568,
      "y": 1408,
      "color": "#A0B0C0",
      "dialogue": [
        "I am Sirris of the Sunless Realms.",
        "I have sworn an oath to serve you.",
        "I shall come to your aid whenever you need.",
        "Thank you, for accepting my knightly vows."
      ]
    }
  ],
