          "大盾格挡",
          "冲撞攻击",
          "物理伤害为主"
        ]
      },
      {
        "name": "雷鸣降临",
        "hp_threshold": 0.5,
        "speed_multiplier": 1.2,
        "damage_multiplier": 1.3,
        "attack_cooldown": 1.6,
        "description": "背景中的巡礼蝶开始向战场投掷闪电。龙猎盔甲的攻击变得更加狂暴，同时需躲避从天而降的落雷。",
        "mechanics": [
          "闪电落雷（环境）",
          "狂暴连击",
          "范围增大",
          "巡礼蝶增援"
        ]
      }
    ],
    "attacks": [
      {
        "name": "巨斧下砸",
        "type": "GreataxeSlam",
        "damage": 65,
        "range": "近",
        "parryable": true,
        "description": "高举巨斧猛力劈下，地面震颤"
      },
      {
        "name": "盾击冲撞",
