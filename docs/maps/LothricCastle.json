        ]
      },
      {
        "name": "城墙大桥",
        "description": "龙猎盔甲Boss战场地。一座横跨深渊的宽阔石桥，两侧是低矮的城墙。天空中巡礼蝶在背景中飞舞，最终会向玩家释放闪电。桥面开阔，适合大范围战斗。",
        "x": 2800,
        "y": 1000,
        "w": 1000,
        "h": 800,
        "terrain_features": [
          "宽阔石桥",
          "深渊两侧",
          "城墙矮墙",
          "巡礼蝶背景"
        ]
      },
      {
        "name": "王城花园入口",
        "description": "城堡侧面的隐秘通道，通往妖王庭园。入口被灌木和藤蔓遮掩，需要仔细探索才能发现。",
