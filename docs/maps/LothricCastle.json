    "sections": [
      {
        "name": "城堡正门",
        "description": "从高墙大教堂沿阶梯上行，经过一尊巨大的骑士雕像后进入城堡正门。两侧有洛斯里克骑士把守。入口处可见两具龙尸。",
        "x": 0,
        "y": 0,
        "w": 800,
        "h": 1000,
        "terrain_features": [
          "石阶",
          "巨型拱门",
          "骑士雕像",
          "龙骸骨架"
        ]
      },
      {
        "name": "外城回廊",
        "description": "宽阔的石质回廊，两侧是高墙与箭孔。回廊中有洛斯里克骑士巡逻。通往龙营和内城的两条岔路在此分出。",
        "x": 800,
        "y": 200,
        "w": 800,
        "h": 800,
        "terrain_features": [
          "石柱回廊",
          "火炬照明",
          "高处箭孔",
          "破损旗帜"
        ]
      },
      {
        "name": "龙营",
        "description": "原本是城堡的军营，现在被洛斯里克飞龙占据。飞龙会喷火烧灼道路上的尸体，玩家需要利用掩体躲避。军营内部有宝箱和道具。",
        "x": 1400,
        "y": 100,
        "w": 1000,
        "h": 700,
        "terrain_features": [
          "燃烧残骸",
          "龙巢穴",
          "军营帐篷残骸",
          "焦黑地面"
        ]
      },
      {
        "name": "内城阶梯",
        "description": "通往城墙的螺旋阶梯与坡道。两侧有翼骑士把守。阶梯上有隐藏的宝箱。此处可看到远处的巡礼蝶。",
        "x": 2200,
        "y": 600,
        "w": 600,
        "h": 800,
        "terrain_features": [
