  "npcs": [
    {
      "name": "Anri of Astora",
      "name_en": "Anri of Astora",
      "kind": "Dialogue",
      "x": 1840,
      "y": 1570,
      "color": "#C0C0C0",
      "dialogue": [
        "Oh, hello, we meet again. I thought it might be you. Good to see you. I never managed to find Horace... But I am a Lordseeker, and I cannot abandon my duty. I will slay Aldrich, alone if I must.",
        "May the flames guide your way."
      ]
    },
    {
      "name": "Siegward",
      "name_en": "Siegward of Catarina",
      "kind": "Dialogue",
      "x": 3100,
      "y": 2580,
      "color": "#C0A060",
      "dialogue": [
        "Oh, wait, you're...! We meet again. You're a sight for sore eyes. I owe you a great deal of thanks. I seem to have missed my chance, but my gratitude holds true.",
        "Oh, I know! Why not join me for dinner? I make a fine estus soup, I promise. And finally, upon this rendezvous, let us make a toast. To your valour, my sword, and our sworn duties! Long may the sun shine!",
        "Well, I'm going to have myself a little nap. The only thing to do, really, after a nice toast."
      ]
    }
  ],
